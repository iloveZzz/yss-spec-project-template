{
  "type": "object",
  "properties": {
    "module_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "module_id": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "server",
              "service",
              "core",
              "repository",
              "adapter",
              "client",
              "feign-client"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "module_id",
          "responsibility",
          "layer",
          "depends_on"
        ],
        "additionalProperties": false
      }
    },
    "use_case_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "use_case_id": {
            "type": "string",
            "minLength": 1
          },
          "module_ref": {
            "type": "string",
            "minLength": 1
          },
          "flow": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "rule_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "failure_handling": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "use_case_id",
          "module_ref",
          "flow",
          "rule_refs",
          "failure_handling"
        ],
        "additionalProperties": false
      }
    },
    "rule_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "use_case_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          }
        },
        "required": [
          "rule_id",
          "statement",
          "use_case_refs"
        ],
        "additionalProperties": false
      }
    },
    "state_transition_catalog": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "transition_id": {
            "type": "string",
            "minLength": 1
          },
          "use_case_ref": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "guard": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "transition_id",
          "use_case_ref",
          "from",
          "to",
          "guard"
        ],
        "additionalProperties": false
      }
    },
    "state_not_applicable_reason": {
      "type": "string"
    },
    "consistency_policy": {
      "type": "object",
      "properties": {
        "transaction_boundary": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "concurrency": {
          "type": "string",
          "minLength": 1
        },
        "idempotency": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "transaction_boundary",
        "rollback",
        "concurrency",
        "idempotency"
      ],
      "additionalProperties": false
    },
    "persistence_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "mapping_id": {
            "type": "string",
            "minLength": 1
          },
          "use_case_ref": {
            "type": "string",
            "minLength": 1
          },
          "repository_ref": {
            "type": "string",
            "minLength": 1
          },
          "storage_model": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "mapping_id",
          "use_case_ref",
          "repository_ref",
          "storage_model",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "integration_catalog": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "properties": {
          "integration_id": {
            "type": "string",
            "minLength": 1
          },
          "adapter_ref": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "failure_handling": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "integration_id",
          "adapter_ref",
          "capability",
          "failure_handling"
        ],
        "additionalProperties": false
      }
    },
    "integration_not_applicable_reason": {
      "type": "string"
    },
    "test_seams": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "seam_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "assertion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "seam_id",
          "kind",
          "subject_ref",
          "assertion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "module_catalog",
    "use_case_catalog",
    "rule_catalog",
    "state_transition_catalog",
    "state_not_applicable_reason",
    "consistency_policy",
    "persistence_mapping",
    "integration_catalog",
    "integration_not_applicable_reason",
    "test_seams"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/mvc-design-v1.json",
  "title": "YSS MVC 技术设计内容"
}
