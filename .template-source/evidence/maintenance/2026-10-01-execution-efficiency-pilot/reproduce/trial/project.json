{
  "name": "pilot",
  "root": ".",
  "targets": {
    "schema": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node task.mjs schema"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/task.mjs",
        "{workspaceRoot}/inputs/**/*",
        "{workspaceRoot}/hash-ignored.mjs",
        {
          "env": "PILOT_MODE"
        },
        {
          "runtime": "node hash-ignored.mjs"
        }
      ],
      "outputs": [
        "{workspaceRoot}/out/schema"
      ]
    },
    "query": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node task.mjs query"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/task.mjs",
        "{workspaceRoot}/inputs/**/*",
        "{workspaceRoot}/hash-ignored.mjs",
        {
          "env": "PILOT_MODE"
        },
        {
          "runtime": "node hash-ignored.mjs"
        }
      ],
      "outputs": [
        "{workspaceRoot}/out/query"
      ],
      "dependsOn": [
        "schema"
      ]
    },
    "checks": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node task.mjs checks"
      },
      "cache": true,
      "inputs": [
        "{workspaceRoot}/task.mjs",
        "{workspaceRoot}/inputs/**/*",
        "{workspaceRoot}/hash-ignored.mjs",
        {
          "env": "PILOT_MODE"
        },
        {
          "runtime": "node hash-ignored.mjs"
        }
      ],
      "outputs": [
        "{workspaceRoot}/out/checks"
      ],
      "dependsOn": [
        "query"
      ]
    }
  }
}