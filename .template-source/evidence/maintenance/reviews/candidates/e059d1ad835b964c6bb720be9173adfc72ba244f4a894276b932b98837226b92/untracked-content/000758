#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
node -e 'const [major]=process.versions.node.split(".").map(Number); if (major < 22 || major >= 27) { console.error("模板工具需要 Node >=22 <27"); process.exit(1); }'

required_files=(yss-project.yaml AGENTS.md CONTEXT.md skills-lock.json docs/agents/yss-skill-registry.yaml docs/agents/digital-human-roles.yaml docs/process/lifecycle-registry.yaml docs/process/lifecycle-registry-baseline.json docs/process/maintenance-intensity.yaml docs/process/harness-profile.yaml docs/process/instance-distribution-manifest.yaml docs/process/schemas/digital-human-task-package.schema.json docs/process/schemas/subagent-task-package.schema.json docs/process/schemas/strategic-design-handoff.schema.json docs/process/templates/lifecycle-checkpoint-template.yaml docs/templates/subagent-task-package-template.md docs/templates/strategic-design-handoff-template.yaml .agents/skills/yss-strategic-design/SKILL.md .agents/skills/yss-strategic-design/agents/openai.yaml .agents/skills/yss-strategic-design/references/orchestration-contract.yaml scripts/repository-mode scripts/sync-skills scripts/update-skill-lock scripts/generate-lifecycle-artifacts scripts/verify-lifecycle-registry scripts/verify-harness-profile scripts/verify-harness-profile-scenarios scripts/verify-entry-alignment scripts/verify-instance-distribution scripts/verify-instance-distribution-scenarios scripts/lib/harness-profile.mjs scripts/lib/entry-alignment.mjs scripts/lib/instance-distribution.mjs scripts/lib/task-package.mjs scripts/verify-digital-human-task-package scripts/verify-digital-human-task-package-scenarios scripts/verify-subagent-task-package scripts/verify-subagent-task-package-scenarios scripts/verify-lifecycle-transition-scenarios scripts/verify-maintenance-checkpoint scripts/verify-maintenance-intensity-scenarios scripts/verify-skill-registry scripts/verify-skill-governance scripts/verify-digital-human-roles scripts/verify-digital-human-roles-scenarios scripts/verify-approval-record scripts/export-yss-skills)
for required in "${required_files[@]}"; do test -f "$required" || { echo "缺少模板必需文件: $required" >&2; exit 1; }; done

repository_mode="$(scripts/repository-mode)"
if [[ "$repository_mode" == "template-source" ]]; then
  test -x .template-source/scripts/evidence-index
  .template-source/scripts/evidence-index --check
  pnpm --dir .template-source/tooling/node test
  pnpm --dir .template-source/tooling/node check:vendor
fi

scripts/sync-skills --check
scripts/update-skill-lock --check
scripts/verify-skill-registry
scripts/verify-skill-governance
scripts/verify-digital-human-roles
scripts/verify-digital-human-roles-scenarios
scripts/verify-harness-profile
scripts/verify-harness-profile-scenarios
scripts/verify-entry-alignment
scripts/verify-instance-distribution
scripts/verify-instance-distribution-scenarios
scripts/verify-approval-record docs/templates/approval-record-template.yaml
scripts/verify-lifecycle-registry
scripts/verify-lifecycle-checkpoint docs/process/templates/lifecycle-checkpoint-template.yaml
scripts/verify-subagent-task-package-scenarios
scripts/verify-digital-human-task-package-scenarios
if [[ "$repository_mode" == "template-source" ]]; then
  scripts/verify-digital-human-task-package .template-source/evidence/maintenance/digital-human-task-package-review-task.yaml
  scripts/verify-digital-human-task-package .template-source/evidence/maintenance/lifecycle-ticket-transition-review-task-package.yaml
fi
scripts/verify-lifecycle-scenarios
scripts/verify-lifecycle-transition-scenarios
scripts/verify-maintenance-intensity-scenarios

for entry in scripts/sync-skills scripts/update-skill-lock scripts/generate-lifecycle-artifacts scripts/verify-lifecycle-registry scripts/verify-harness-profile scripts/verify-harness-profile-scenarios scripts/verify-entry-alignment scripts/verify-instance-distribution scripts/verify-instance-distribution-scenarios scripts/lib/harness-profile.mjs scripts/lib/entry-alignment.mjs scripts/lib/instance-distribution.mjs scripts/lib/task-package.mjs scripts/verify-digital-human-task-package scripts/verify-digital-human-task-package-scenarios scripts/verify-subagent-task-package scripts/verify-subagent-task-package-scenarios scripts/verify-maintenance-checkpoint scripts/verify-maintenance-intensity-scenarios scripts/verify-skill-registry scripts/verify-skill-governance scripts/verify-digital-human-roles scripts/verify-digital-human-roles-scenarios scripts/verify-approval-record scripts/lib/lifecycle-transition.mjs scripts/verify-lifecycle-scenarios scripts/verify-lifecycle-transition-scenarios scripts/export-yss-skills; do node --check "$entry"; done

legacy_runtime="ru""by"
script_roots=(scripts)
if [[ -d .template-source/scripts ]]; then
  script_roots+=(.template-source/scripts)
fi
if rg -n "^#!.*${legacy_runtime}|\\b${legacy_runtime}\\b" "${script_roots[@]}" --glob '!*.md'; then echo "模板脚本不得保留活跃 Ruby 调用或 shebang" >&2; exit 1; fi
if rg --files "${script_roots[@]}" | rg '\.rb$'; then echo "模板脚本不得保留 .rb 路径" >&2; exit 1; fi
if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  git diff --check
fi
echo "模板发布校验通过"
