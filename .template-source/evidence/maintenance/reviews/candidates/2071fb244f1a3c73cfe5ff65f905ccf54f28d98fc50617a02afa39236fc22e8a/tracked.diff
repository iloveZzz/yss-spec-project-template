+    - role.architecture-agent
+    - role.frontend-agent
+    - role.backend-agent
+    - role.test-agent
+  control_plane_roles:
+    - role.harness-orchestrator
+  non_target_role_policy: >-
+    本 profile 只注册四类研发角色；产品、需求、商务和项目管理不在当前 Harness 中派发。
