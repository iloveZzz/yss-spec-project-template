+    assert.match(doctor, /Archify is ready\./);
+
+    const fixtures = {
+      architecture: 'web-app.architecture.json',
+      workflow: 'agent-tool-call.workflow.json',
+      sequence: 'cache-miss-request.sequence.json',
+      dataflow: 'product-analytics.dataflow.json',
