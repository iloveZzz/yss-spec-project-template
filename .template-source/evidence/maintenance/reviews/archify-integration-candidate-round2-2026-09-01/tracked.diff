+      json,
+      stage: 'prepare',
+      type,
+      input: inputPath,
+      output: outputPath,
+      error: message,
+      diagnostics: [diagnostic({
+        code: 'delivery/prepare-directory',
+        message,
+        subject: { outputDirectory },
+        evidence: { ...(error?.code ? { systemCode: error.code } : {}), reason: error.message },
