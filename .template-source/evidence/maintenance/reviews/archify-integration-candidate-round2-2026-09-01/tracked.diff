+      stage: 'prepare',
+      type,
+      input: inputPath,
+      output: attemptedOutput,
+      error: error.message,
+      diagnostics: error.archifyDiagnostics || [diagnostic({
+        code: 'output/path-resolution',
+        message: error.message,
+        subject: { output: attemptedOutput },
