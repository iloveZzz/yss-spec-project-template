+    const receipt = {
+      schemaVersion: 1,
+      ok: true,
+      command: 'deliver',
+      type,
+      input: inputPath,
+      output: outputPath,
+      specification: {
+        sha256: createHash('sha256').update(specification).digest('hex'),
+        bytes: specification.byteLength,
