+        json,
+        stage: 'receipt',
+        type,
+        input: inputPath,
+        output: outputPath,
+        error: message,
+        diagnostics: [diagnostic({
+          code: 'delivery/candidate-unreadable',
+          message,
+          subject: { output: outputPath },
+          evidence: { ...(error?.code ? { systemCode: error.code } : {}), reason: error.message },
+        })],
+      });
