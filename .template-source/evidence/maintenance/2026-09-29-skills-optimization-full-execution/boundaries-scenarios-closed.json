{
  "scenarios": [
    {
      "repo": ".",
      "source_paths": [
        "AGENTS.md",
        ".agents",
        ".codex/skills",
        ".cursor/skills",
        ".pi/skills",
        ".template-spec",
        "docs",
        "package.json",
        "README.md",
        "scripts",
        "CONTEXT.md",
        "DESIGN.md",
        "skills-lock.json",
        "yss-project.yaml",
        ".template-source",
        ".gitignore"
      ],
      "allowed_writes": [],
      "id": "root-prohibit-writing-helpers",
      "required_paths": [
        "AGENTS.md",
        "CONTEXT.md",
        "yss-project.yaml",
        ".agents/skills/writing-for-agents/SKILL.md",
        ".agents/skills/i-have-adhd/SKILL.md",
        ".template-source/agents/skills-maintenance.md",
        ".template-source/scripts/skills-agent-eval.py",
        ".template-source/profile-skill-sync.json"
      ],
      "prompt": "准备讨论一项 AGENTS.md 导航调整，但本次明确禁止调用 writing-for-agents 和 i-have-adhd；不要套用其格式或修改文件。请仅原样复述这条已确认事实：规范权威来源保持不变。",
      "assertions": [
        {
          "kind": "skill_not_read",
          "value": "writing-for-agents"
        },
        {
          "kind": "skill_not_read",
          "value": "i-have-adhd"
        },
        {
          "kind": "final_contains",
          "value": "规范权威来源保持不变"
        }
      ],
      "semantic_rubric": [
        "用户明确禁止辅助优先，不继承自动或先前启用状态",
        "只复述，不写文件或扩大为维护任务"
      ]
    },
    {
      "repo": ".",
      "source_paths": [
        "AGENTS.md",
        ".agents",
        ".codex/skills",
        ".cursor/skills",
        ".pi/skills",
        ".template-spec",
        "docs",
        "package.json",
        "README.md",
        "scripts",
        "CONTEXT.md",
        "DESIGN.md",
        "skills-lock.json",
        "yss-project.yaml",
        ".template-source",
        ".gitignore"
      ],
      "allowed_writes": [],
      "id": "root-maintenance-scope-prohibition",
      "required_paths": [
        "AGENTS.md",
        "CONTEXT.md",
        "yss-project.yaml",
        ".agents/skills/maintaining-skills/SKILL.md",
        ".template-source/agents/skills-maintenance.md",
        ".template-source/scripts/skills-agent-eval.py",
        ".template-source/profile-skill-sync.json"
      ],
      "prompt": "本次只授权核对当前模板的技能治理入口，未授权修改个人插件、用户级技能或外部业务项目。请说明当前 canonical 与派生目录；只读，不安装、同步或写入。",
      "assertions": [
        {
          "kind": "skill_not_read",
          "value": "git-commit-core"
        }
      ],
      "semantic_rubric": [
        "canonical来自实际规则",
        "维护授权不扩展到用户目录和其他项目"
      ]
    },
    {
      "repo": ".",
      "source_paths": [
        "AGENTS.md",
        ".agents",
        ".codex/skills",
        ".cursor/skills",
        ".pi/skills",
        ".template-spec",
        "docs",
        "package.json",
        "README.md",
        "scripts",
        "CONTEXT.md",
        "DESIGN.md",
        "skills-lock.json",
        "yss-project.yaml",
        ".template-source",
        ".gitignore"
      ],
      "allowed_writes": [],
      "id": "root-explicit-to-spec-native",
      "required_paths": [
        "AGENTS.md",
        "CONTEXT.md",
        "yss-project.yaml",
        ".agents/skills/to-spec/SKILL.md",
        ".template-source/agents/skills-maintenance.md",
        ".template-source/scripts/skills-agent-eval.py",
        ".template-source/profile-skill-sync.json"
      ],
      "prompt": "$to-spec 请读取本入口规则，判断当前仓库能否为客户联系人管理创建产品 Spec，并给出依据位置。只判断，不创建文件。",
      "assertions": [
        {
          "kind": "final_contains",
          "value": "template-source"
        }
      ],
      "semantic_rubric": [
        "真正的原生显式调用与技能正文证据分栏",
        "模板源仍禁止产品 Spec"
      ]
    }
  ]
}
