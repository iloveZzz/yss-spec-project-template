{
  "schemaVersion": 6,
  "profile": "spec",
  "manifest": {
    "allowRootEntries": [
      ".agents",
      ".codex",
      ".cursor",
      ".pi",
      ".claude",
      ".vscode",
      ".template-spec"
    ],
    "allowRootFiles": [
      ".cursorrules",
      ".gitignore",
      "AGENTS.md",
      "CLAUDE.md",
      "CONTEXT.md",
      "DESIGN.md",
      "README.md",
      "skills-lock.json",
      "yss-project.yaml",
      "yss-public-skills.json"
    ],
    "allowFiles": [
      ".workbuddy/skills"
    ],
    "excludeRootEntries": [
      ".git",
      ".codegraph",
      ".codebuddy",
      ".workbuddy",
      ".idea",
      ".uploads",
      "node_modules",
      ".ua",
      ".qwen",
      ".template-source",
      "packages",
      ".github"
    ],
    "excludeRootFiles": [
      "package-lock.json",
      "template.manifest.json",
      "template.snapshot.json",
      ".gitmodules"
    ],
    "excludePaths": [
      ".codex/config.toml",
      ".codex/settings.local.json",
      ".pi/settings.json",
      "docs/.scratch",
      "docs/discovery",
      "docs/reviews",
      "docs/adr",
      ".template-source/agents/skills-maintenance.md",
      ".template-source/agents/strategic-design-skills-integration.md",
      ".template-source/agents/yss-ui-skills-integration.md",
      ".work",
      ".agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml",
      ".template-spec/agents/digital-human-roles.md"
    ],
    "excludePathSuffixes": [
      "-scenarios"
    ],
    "renderPaths": [
      ".gitignore",
      "AGENTS.md",
      "README.md",
      "skills-lock.json",
      ".template-spec/user-guide/用户手册.md",
      ".template-spec/user-guide/用户手册索引.md",
      ".template-spec/user-guide/阶段接入与产物复用使用手册.md",
      ".template-spec/user-guide/技术设计用户指南.md",
      ".template-spec/design/README.md",
      ".template-spec/engineering/backend-platforms.json",
      ".template-spec/agents/backend-architecture-profiles.md",
      ".agents/skills/yss-design-system/SKILL.md",
      ".agents/skills/yss-design-system/references/high-fidelity-default-theme.md",
      ".claude/skills/yss-design-system/SKILL.md",
      ".claude/skills/yss-design-system/references/high-fidelity-default-theme.md",
      "yss-project.yaml",
      ".workbuddy/skills/yss-design-system/SKILL.md",
      ".workbuddy/skills/yss-design-system/references/high-fidelity-default-theme.md"
    ],
    "exampleDocPaths": [],
    "initExcludeRootEntries": [],
    "initExcludeRootFiles": [
      "yss-public-skills.json"
    ],
    "initExcludePaths": [],
    "ownershipPolicy": {
      "version": 1,
      "default": "managed",
      "rules": [
        {
          "pattern": ".git/**",
          "ownership": "protected"
        },
        {
          "pattern": ".template-source/design/design-system-sync.yaml",
          "ownership": "managed"
        },
        {
          "pattern": ".template-source/design/preview-dark.html",
          "ownership": "managed"
        },
        {
          "pattern": ".template-source/design/preview.css",
          "ownership": "managed"
        },
        {
          "pattern": ".template-source/design/preview.html",
          "ownership": "managed"
        },
        {
          "pattern": ".template-source/design/preview.js",
          "ownership": "managed"
        },
        {
          "pattern": ".template-source/**",
          "ownership": "protected"
        },
        {
          "pattern": ".gitmodules",
          "ownership": "user-owned"
        },
        {
          "pattern": ".gitignore",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "apps/**",
          "ownership": "user-owned"
        },
        {
          "pattern": "packages/**",
          "ownership": "user-owned"
        },
        {
          "pattern": "wiki/**",
          "ownership": "user-owned"
        },
        {
          "pattern": "docs/reviews/**",
          "ownership": "user-owned"
        },
        {
          "pattern": "docs/.scratch/**",
          "ownership": "user-owned"
        },
        {
          "pattern": ".template-spec/agents/issue-tracker.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "yss-project.yaml",
          "ownership": "generated"
        },
        {
          "pattern": "skills-lock.json",
          "ownership": "generated"
        },
        {
          "pattern": "yss-public-skills.json",
          "ownership": "generated"
        },
        {
          "pattern": ".agents/skills/.yss-skills-manifest.json",
          "ownership": "generated"
        },
        {
          "pattern": "AGENTS.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "CONTEXT.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "DESIGN.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "README.md",
          "ownership": "user-owned"
        },
        {
          "pattern": ".work/**",
          "ownership": "user-owned"
        }
      ]
    },
    "customizationPolicy": {
      "version": 1,
      "defaultStrategy": "replace-with-force",
      "rules": [
        {
          "pattern": ".gitignore",
          "strategy": "manual"
        },
        {
          "pattern": ".template-spec/agents/issue-tracker.md",
          "strategy": "manual"
        },
        {
          "pattern": "CONTEXT.md",
          "strategy": "manual"
        },
        {
          "pattern": "DESIGN.md",
          "strategy": "manual"
        }
      ]
    },
    "generatorPolicy": {
      "version": 1,
      "rules": [
        {
          "pattern": "yss-project.yaml",
          "generatorId": "repository-identity",
          "generatorVersion": 1
        },
        {
          "pattern": "skills-lock.json",
          "generatorId": "skills-lock",
          "generatorVersion": 1
        },
        {
          "pattern": "yss-public-skills.json",
          "generatorId": "public-skills",
          "generatorVersion": 1
        },
        {
          "pattern": ".agents/skills/.yss-skills-manifest.json",
          "generatorId": "skills-manifest",
          "generatorVersion": 1
        }
      ]
    }
  },
  "retiredSkills": {
    "yss-openapi-draft-review": {
      "replacements": [
        "yss-openapi-governance"
      ],
      "reason": "OpenAPI 只读审查已合并到 yss-openapi-governance。"
    },
    "yss-implementation-contract-compiler": {
      "replacements": [
        "to-tickets",
        "implement"
      ],
      "reason": "任务拆解与实现按当前请求开展，不再编译实现合同。"
    },
    "cross-repo-implementation-routing": {
      "replacements": [
        "implement"
      ],
      "reason": "仓库范围与跨仓分工由 implement 按本次授权处理。"
    },
    "implementation-repo-onboarding": {
      "replacements": [
        "implement"
      ],
      "reason": "工程识别、只读调查与子模块保护已并入 implement。"
    }
  },
