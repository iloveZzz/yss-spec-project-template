{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "backend-contract",
        "backend-deployment"
      ]
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "executed_at": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "const": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "ref",
                "digest"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "command",
          "executed_at",
          "exit_code",
          "evidence"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "operation_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "success",
              "failure"
            ]
          }
        },
        "required": [
          "source_id",
          "outcome"
        ]
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "kind",
    "subject_digest",
    "results",
    "operation_ids",
    "coverage"
  ]
}
