{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "governance_root": {
      "type": "string",
      "minLength": 1
    },
    "planned_initialization": {
      "type": "boolean"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_id",
        "project_id",
        "slice_id",
        "operation_ids"
      ],
      "properties": {
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "slice_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ui_mode": {
          "enum": [
            "existing-baseline",
            "prototype",
            "not-applicable"
          ]
        },
        "ui_not_applicable_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "architecture_identity": {
      "type": "object"
    },
    "architecture_bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineering_baseline": {
          "$ref": "#/$defs/binding"
        },
        "repository_registration": {
          "$ref": "#/$defs/binding"
        },
        "manifest": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openapi": {
          "$ref": "#/$defs/binding"
        },
        "technical_design": {
          "$ref": "#/$defs/binding"
        },
        "slice_contract": {
          "$ref": "#/$defs/binding"
        },
        "ui_baseline": {
          "$ref": "#/$defs/binding"
        },
        "build": {
          "$ref": "#/$defs/binding"
        },
        "deployment": {
          "$ref": "#/$defs/binding"
        },
        "strategic_handoff": {
          "$ref": "#/$defs/binding"
        },
        "backend_delivery": {
          "$ref": "#/$defs/binding"
        },
        "local_authorization": {
          "$ref": "#/$defs/binding"
        },
        "build_artifact": {
          "$ref": "#/$defs/binding"
        }
      }
    },
    "delivery_kind": {
      "enum": [
        "complete",
        "strategic-handoff",
        "backend-delivery"
      ]
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
