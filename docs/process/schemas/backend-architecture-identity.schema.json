{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.local/schemas/backend-architecture-identity.schema.json",
  "title": "后端架构身份",
  "description": "旧生成式身份严格兼容；既有工程显式 existing-registration v2，必须以原始文件三方核验。",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture_family",
        "architecture_profile",
        "generator_skill",
        "requested_capabilities",
        "resolved_modules",
        "contract_digest",
        "verification_database",
        "production_database"
      ],
      "properties": {
        "architecture_family": {
          "enum": [
            "domain-driven",
            "layered-mvc"
          ]
        },
        "architecture_profile": {
          "enum": [
            "target-domain-model",
            "layered-mvc-service",
            "mvc-data-analysis-v1"
          ]
        },
        "generator_skill": {
          "type": "string",
          "minLength": 1
        },
        "requested_capabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "resolved_modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "contract_digest": {
          "type": "string",
          "pattern": "^(sha256:)?[a-f0-9]{64}$"
        },
        "verification_database": {
          "const": "h2"
        },
        "production_database": {
          "const": "not-bound"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_kind",
        "architecture_family",
        "architecture_profile",
        "repository_id",
        "project_id",
        "source_digest",
        "build_units_digest"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "source_kind": {
          "const": "existing-registration"
        },
        "architecture_family": {
          "enum": [
            "domain-driven",
            "layered-mvc"
          ]
        },
        "architecture_profile": {
          "enum": [
            "existing-domain-driven-maven",
            "existing-layered-mvc-maven"
          ]
        },
        "repository_id": {
          "type": "string",
          "minLength": 1
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "build_units_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  ]
}
