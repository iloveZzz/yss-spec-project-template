{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slice Implementation Contract v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 3
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "blocked",
        "ready-for-lifecycle-review",
        "approved",
        "stale"
      ]
    },
    "basis": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "approval_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "ref",
              "digest"
            ]
          },
          {
            "type": "string",
            "minLength": 1
          }
        ]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "impacted_areas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "implementation_path_policy": {
          "enum": [
            "external-repository-native",
            "harness-apps-multi-project",
            "git-submodule-harness-apps"
          ]
        },
        "project_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "allowed_write_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "forbidden_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "context_plan": {
          "type": "object"
        },
        "doubt_driven_review": {
          "type": "object"
        },
        "human_review_points": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "full_reroute_triggers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "optional_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unavailable_skills": {
          "type": "array"
        },
        "risk_level": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      },
      "required": [
        "impacted_areas",
        "implementation_path_policy",
        "project_roots",
        "allowed_write_paths"
      ]
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "required",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "baseline_kind": {
              "enum": [
                "prototype",
                "existing-ui-baseline"
              ]
            },
            "ui_change": {
              "enum": [
                "none",
                "required"
              ]
            }
          },
          "required": [
            "status"
          ]
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "required",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ]
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "required",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ]
        },
        "cross_repo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "required",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "status"
          ]
        },
        "checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reason"
            ],
            "properties": {
              "status": {
                "enum": [
                  "required",
                  "not-applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "required": [
        "frontend",
        "backend",
        "api",
        "cross_repo"
      ]
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "required_skills": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "recipe_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "registry_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compiler_contract_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "architecture_identity": {
          "type": "object"
        },
        "component_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "capability_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "verified"
              },
              "verified_architectures": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "domain-driven",
                    "layered-mvc"
                  ]
                }
              },
              "artifacts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "group_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "artifact_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "declared_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "resolved_version": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pom_sha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "jar_sha256": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    },
                    "source_tree": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{40}$"
                    }
                  },
                  "required": [
                    "group_id",
                    "artifact_id",
                    "declared_version",
                    "resolved_version",
                    "pom_sha256",
                    "jar_sha256",
                    "source_tree"
                  ]
                }
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "architecture_family": {
                      "enum": [
                        "domain-driven",
                        "layered-mvc"
                      ]
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "architecture_family",
                    "ref",
                    "digest"
                  ]
                }
              },
              "component_digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "architecture_family": {
                "enum": [
                  "domain-driven",
                  "layered-mvc"
                ]
              },
              "platform_configuration": {
                "type": "object",
                "minProperties": 1,
                "required": [
                  "component_platform_line"
                ],
                "properties": {
                  "component_platform_line": {
                    "enum": [
                      "boot2-java8",
                      "boot3-java17"
                    ]
                  }
                }
              }
            },
            "required": [
              "capability_id",
              "status",
              "verified_architectures",
              "artifacts",
              "evidence",
              "component_digest",
              "architecture_family",
              "platform_configuration"
            ]
          }
        },
        "component_bindings_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "required_capabilities",
        "required_skills",
        "recipe_ids",
        "conditions",
        "registry_digest",
        "compiler_contract_digest"
      ]
    },
    "acceptance": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source",
          "locator"
        ]
      }
    },
    "verification": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "cwd": {
            "type": "string",
            "minLength": 1
          },
          "expected_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "test_seams": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "acceptance_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "required_for_all": {
            "type": "boolean"
          },
          "dependency_roots": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "command",
          "cwd",
          "expected_evidence",
          "test_seams",
          "acceptance_refs"
        ]
      }
    },
    "work_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "role_id": {
            "type": "string",
            "minLength": 1
          },
          "project_root": {
            "type": "string",
            "minLength": 1
          },
          "primary_skill": {
            "type": "string",
            "minLength": 1
          },
          "supporting_skills": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tdd_mode": {
            "enum": [
              "behavior-tdd",
              "controlled-generation"
            ]
          },
          "allowed_write_paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "forbidden_patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "verification_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "acceptance_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "downstream_consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "convergence_ref": {
            "type": "string",
            "minLength": 1
          },
          "controlled_generation": {
            "type": "object"
          }
        },
        "required": [
          "id",
          "behavior",
          "role_id",
          "primary_skill",
          "tdd_mode",
          "verification_refs",
          "acceptance_refs"
        ]
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "visual_baseline_case_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "component_test_seams": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "e2e_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "generated_api_client_ref": {
              "type": "string",
              "minLength": 1
            },
            "implementation_verification_ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "visual_baseline_case_ids"
          ]
        },
        "backend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "affected_layers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "component_impacts": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "design_refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "seam_deferred": {
              "type": "array"
            },
            "constraints": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "application_boundary": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "transaction_boundary": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "persistence_strategy": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "aggregate_refs": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "invariant_refs": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "state_behavior_refs": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "gateway_boundary_ref": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "domain_test_seams": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                },
                "application_test_seams": {
                  "oneOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  ]
                }
              }
            }
          },
          "required": [
            "affected_layers",
            "design_refs"
          ]
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "generated_clients": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "contract_tests": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "regeneration_commands": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "contract_tests"
          ]
        },
        "cross_repo": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "delivery_order": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "integration_verification": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "rollback_order": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "repository_bindings": {
              "type": "object",
              "minProperties": 2,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "implementation_repository",
                  "engineering_baseline"
                ],
                "properties": {
                  "implementation_repository": {
                    "type": "string",
                    "minLength": 1
                  },
                  "engineering_baseline": {
                    "type": "string",
                    "minLength": 1
                  },
                  "manifest": {
                    "type": "string",
                    "minLength": 1
                  },
                  "technical_design": {
                    "type": "string",
                    "minLength": 1
                  },
                  "frontend_delivery": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recipe_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "capability_refs": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          "required": [
            "delivery_order",
            "integration_verification",
            "rollback_order"
          ]
        }
      },
      "required": []
    },
    "ticket_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "state_owner"
      ],
      "properties": {
        "mode": {
          "const": "frozen-requirements"
        },
        "state_owner": {
          "const": "tracker-or-task-package"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "contract_id",
    "contract_version",
    "slice_id",
    "status",
    "basis",
    "scope",
    "applicability",
    "resolution",
    "acceptance",
    "verification",
    "work_units"
  ]
}
