{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/strategic-handoff-delivery-v1.schema.json",
  "title": "YSS Strategic Handoff Delivery Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "handoff", "source_assets", "package_ref", "manifest_ref", "bundle_digest", "verification_ref", "consumer_routes", "previous_delivery"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "strategic-handoff-delivery-v1"},
    "status": {"const": "packaged"},
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "ref", "sha256", "schema_version"],
      "properties": {
        "id": {"type": "string", "pattern": "^strategic-design-handoff\\.[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "schema_version": {"const": 5}
      }
    },
    "source_assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_key", "id", "version", "ref", "digest"],
        "properties": {
          "source_key": {"type": "string", "minLength": 1},
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
        }
      }
    },
    "package_ref": {"const": "package"},
    "manifest_ref": {"const": "package/manifest.json"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "verification_ref": {"const": "verification.json"},
    "consumer_routes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["route_id", "capability", "activation"],
        "properties": {
          "route_id": {"type": "string", "pattern": "^route\\.[a-z0-9][a-z0-9-]*$"},
          "capability": {"enum": ["backend-technical-design", "frontend-engineering-design", "delivery-coordination"]},
          "activation": {"enum": ["required", "optional", "not-applicable"]}
        }
      }
    },
    "zip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256"],
      "properties": {
        "ref": {"const": "package.zip"},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "previous_delivery": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["handoff_id", "version", "bundle_digest"],
          "properties": {
            "handoff_id": {"type": "string", "minLength": 1},
            "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
            "bundle_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        }
      ]
    }
  }
}
