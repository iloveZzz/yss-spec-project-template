{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "exit_code",
    "stage",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "result": {
      "enum": [
        "ready",
        "blocked",
        "invalid-input"
      ]
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2
      ]
    },
    "stage": {
      "enum": [
        "prepare",
        "build",
        "export",
        "accept",
        null
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "status",
          "owner",
          "source",
          "evidence",
          "blocking_stages",
          "recovery",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ready",
              "missing",
              "conflict",
              "stale",
              "unsupported",
              "pending",
              "not-applicable"
            ]
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocking_stages": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "prepare",
                "build",
                "export",
                "accept"
              ]
            }
          },
          "recovery": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "invalid-input"
          }
        }
      },
      "then": {
        "properties": {
          "exit_code": {
            "const": 2
          }
        }
      }
    }
  ]
}
