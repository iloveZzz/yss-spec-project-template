{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/lifecycle-checkpoint.schema.json",
  "title": "YSS 生命周期 Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository_mode",
    "mode",
    "status",
    "stage",
    "artifacts",
    "gates",
    "context_reconciliation",
    "next_work_unit",
    "ticket_sync",
    "verification",
    "human_review",
    "git_checkpoint",
    "blockers",
    "rollback"
  ],
  "properties": {
    "plan_continuation_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_user_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "repository_mode": {
      "enum": [
        "template-source",
        "project-instance"
      ]
    },
    "mode": {
      "enum": [
        "route",
        "orchestrate",
        "resume",
        "audit"
      ]
    },
    "status": {
      "enum": [
        "routing",
        "running",
        "paused-human-gate",
        "blocked",
        "completed"
      ]
    },
    "stage": {
      "type": "string",
      "pattern": "^stage\\.[a-z0-9][a-z0-9-]*$"
    },
    "artifacts": {
      "type": "object",
      "patternProperties": {
        "^artifact\\.[a-z0-9][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ref",
            "evidence_refs"
          ],
          "properties": {
            "status": {
              "enum": [
                "missing",
                "draft",
                "ready-for-human",
                "approved",
                "stale",
                "not-applicable"
              ]
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "stale_by": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "gates": {
      "type": "object",
      "patternProperties": {
        "^gate\\.[a-z0-9][a-z0-9-]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "reason",
            "evidence_refs"
          ],
          "properties": {
            "status": {
              "enum": [
                "not-evaluated",
                "blocked",
                "ready-for-human",
                "approved",
                "stale",
                "not-applicable"
              ]
            },
            "reason": {
              "type": "string"
            },
            "evidence_refs": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approval_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "subject_ref": {
              "type": "string",
              "minLength": 1
            },
            "approval_scope": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "evidence": {
              "type": "object"
            },
            "basis": {
              "type": "array"
            },
            "checks": {
              "type": "object"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "context_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "ref",
        "evidence_refs"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "reconciled",
            "not-applicable",
            "blocked"
          ]
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "type": "string"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_work_unit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^work-unit\\.[a-z0-9][a-z0-9-]*$"
    },
    "phase_boundary": {
      "type": "object"
    },
    "stage_trace": {
      "type": "object"
    },
    "ticket_sync": {
      "type": "object",
      "description": "Ticket 仅保存追踪同步状态；refs 关联消费者 Import Receipt、Consumer Feedback、Feedback Adjudication 与 Delivery Acceptance 等权威资产，不复制其机器状态。"
    },
    "verification": {
      "type": "object"
    },
    "human_review": {
      "type": "object"
    },
    "git_checkpoint": {
      "type": "object"
    },
    "blockers": {
      "type": "array"
    },
    "rollback": {
      "type": "array"
    },
    "checks": {
      "type": "object",
      "patternProperties": {
        "^check\\.[a-z0-9][a-z0-9-]*$": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "stage_tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "feature_id",
        "checkpoint_ref",
        "entry_stage",
        "entry",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "entry_stage": {
          "type": "string",
          "minLength": 1
        },
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "ref"
          ],
          "properties": {
            "kind": {
              "enum": [
                "parent-ticket",
                "checkpoint"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "title",
              "stage",
              "work_unit",
              "owner",
              "scope",
              "acceptance",
              "dependencies",
              "source_refs",
              "progress",
              "split_reasons",
              "completion"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "kind": {
                "const": "stage-work-item"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "stage": {
                "type": "string",
                "minLength": 1
              },
              "work_unit": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              },
              "acceptance": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "digest"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  }
                }
              },
              "progress": {
                "enum": [
                  "pending",
                  "running",
                  "blocked",
                  "completed",
                  "cancelled"
                ]
              },
              "split_reasons": {
                "type": "array",
                "items": {
                  "enum": [
                    "different-owner",
                    "independent-acceptance",
                    "blocks-other-work",
                    "cross-stage-deferral"
                  ]
                },
                "uniqueItems": true
              },
              "completion": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "criterion",
                    "evidence_refs"
                  ],
                  "properties": {
                    "criterion": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_refs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "ref",
                          "digest"
                        ],
                        "properties": {
                          "ref": {
                            "type": "string",
                            "minLength": 1
                          },
                          "digest": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          }
                        }
                      },
                      "minItems": 1
                    }
                  }
                }
              },
              "definition_ref": {
                "type": "string",
                "minLength": 1
              },
              "definition_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "recheck_required": {
                "type": "boolean"
              },
              "cancellation_reason": {
                "type": "string",
                "minLength": 1
              },
              "deferred": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "owner",
                  "resolve_by",
                  "receiver",
                  "verification_plan",
                  "decision_ref",
                  "risk",
                  "follow_up_ref"
                ],
                "properties": {
                  "owner": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resolve_by": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "receiver": {
                    "type": "string",
                    "minLength": 1
                  },
                  "verification_plan": {
                    "type": "string",
                    "minLength": 1
                  },
                  "decision_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "risk": {
                    "type": "string",
                    "minLength": 1
                  },
                  "follow_up_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://yss.dev/schemas/stage-tracking.schema.json",
      "title": "阶段工作追踪 v1"
    }
  }
}
