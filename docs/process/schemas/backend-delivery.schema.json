{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^backend-delivery\\.[a-z0-9][a-z0-9.-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "status": {
      "const": "verified"
    },
    "strategic_bundle_ref": {
      "type": "string",
      "minLength": 1
    },
    "strategic_bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "strategic_route_id": {
      "type": "string",
      "pattern": "^route\\.[a-z0-9][a-z0-9-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slice_id": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "operation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "slice_id",
        "source_ids",
        "operation_ids"
      ]
    },
    "openapi": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "ref",
        "digest",
        "approval_ref"
      ]
    },
    "slice_contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "approval_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "ref",
        "digest",
        "approval_ref"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_commit",
        "artifact_digest"
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "deployment_id": {
          "type": "string",
          "minLength": 1
        },
        "revision_path": {
          "type": "string",
          "minLength": 1
        },
        "revision_pointers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deployment_id": {
              "type": "string",
              "minLength": 1
            },
            "source_commit": {
              "type": "string",
              "minLength": 1
            },
            "openapi_digest": {
              "type": "string",
              "minLength": 1
            },
            "artifact_digest": {
              "type": "string",
              "minLength": 1
            },
            "test_data_digest": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "deployment_id",
            "source_commit",
            "openapi_digest",
            "artifact_digest",
            "test_data_digest"
          ]
        },
        "test_data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "authorization_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]+$"
        }
      },
      "required": [
        "id",
        "base_url",
        "deployment_id",
        "revision_path",
        "revision_pointers",
        "test_data"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "ref",
            "digest"
          ]
        },
        "deployment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "ref",
            "digest"
          ]
        }
      },
      "required": [
        "contract",
        "deployment"
      ]
    },
    "supporting_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "delivery_id",
    "version",
    "status",
    "strategic_bundle_ref",
    "strategic_bundle_digest",
    "scope",
    "openapi",
    "slice_contract",
    "build",
    "environment",
    "verification",
    "supporting_files"
  ]
}
