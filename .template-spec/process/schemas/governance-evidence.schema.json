{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/governance-evidence.schema.json",
  "title": "Shared evidence structure for role-independent governance; native semantics verify actual sources and equality",
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "task_ref",
        "execution_ref",
        "identity"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "execution_ref": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "principal_ref",
                "session_ref"
              ],
              "properties": {
                "status": {
                  "const": "available"
                },
                "principal_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "session_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "const": "unavailable"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "provenance"
      ],
      "properties": {
        "mode": {
          "enum": [
            "self-check",
            "independent-review",
            "external-required-review"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "independence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "implementation",
            "reviewer",
            "implementation_context_ref",
            "reviewer_context_ref",
            "evidence",
            "candidate",
            "scope",
            "readonly"
          ],
          "properties": {
            "implementation": {
              "$ref": "#/$defs/verified_provenance"
            },
            "reviewer": {
              "$ref": "#/$defs/verified_provenance"
            },
            "implementation_context_ref": {
              "type": "string",
              "minLength": 1
            },
            "reviewer_context_ref": {
              "type": "string",
              "minLength": 1
            },
            "evidence": {
              "$ref": "#/$defs/asset"
            },
            "candidate": {
              "$ref": "#/$defs/asset"
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "readonly": {
              "const": true
            }
          }
        },
        "external": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "rule",
            "result",
            "source",
            "subject",
            "scope",
            "status"
          ],
          "properties": {
            "rule": {
              "$ref": "#/$defs/asset"
            },
            "result": {
              "$ref": "#/$defs/asset"
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "subject": {
              "$ref": "#/$defs/asset"
            },
            "scope": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "status": {
              "const": "satisfied"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "self-check"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "independence"
                  ]
                },
                {
                  "required": [
                    "external"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "independent-review"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "independence"
            ],
            "not": {
              "required": [
                "external"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "external-required-review"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "external"
            ]
          }
        }
      ]
    },
    "verification_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status",
        "candidate_digest"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "not-run",
            "not-applicable"
          ]
        },
        "exit_code": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "executed_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            }
          },
          "then": {
            "required": [
              "exit_code",
              "executed_at",
              "evidence_ref",
              "evidence_digest"
            ],
            "properties": {
              "exit_code": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "else": {
            "required": [
              "reason"
            ],
            "properties": {
              "exit_code": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "exit_code": {
                "const": 0
              }
            }
          }
        }
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "version"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "version": {
          "const": 2
        }
      }
    },
    "external_rules": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "const": "none-known"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "requirements"
          ],
          "properties": {
            "state": {
              "const": "known-verifiable"
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule",
                  "scope",
                  "result",
                  "source",
                  "status"
                ],
                "properties": {
                  "rule": {
                    "$ref": "#/$defs/asset"
                  },
                  "scope": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "result": {
                    "$ref": "#/$defs/asset"
                  },
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "satisfied",
                      "unsatisfied"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "requirements"
          ],
          "properties": {
            "state": {
              "const": "known-unverifiable"
            },
            "requirements": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "rule_ref",
                  "scope",
                  "reason"
                ],
                "properties": {
                  "rule_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "scope": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "verified_provenance": {
      "allOf": [
        {
          "$ref": "#/$defs/provenance"
        },
        {
          "properties": {
            "identity": {
              "properties": {
                "status": {
                  "const": "available"
                }
              }
            }
          }
        }
      ]
    }
  }
}
