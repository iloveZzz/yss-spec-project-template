{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yss git policy (repository workflow rules, not approval)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "default_branch": {"$ref": "#/$defs/branch"},
    "protected_branches": {
      "type": "array", "uniqueItems": true,
      "items": {"$ref": "#/$defs/branch"}
    },
    "branch_pattern": {"type": "string", "minLength": 1, "description": "Go RE2 regular expression a new branch name must match"},
    "ticket_trailer": {"$ref": "#/$defs/trailer"},
    "ticket_pattern": {"type": "string", "minLength": 1, "description": "Go RE2 regular expression a Ticket id must match"},
    "review_trailer": {"$ref": "#/$defs/trailer"},
    "require_signed": {"type": "boolean"}
  },
  "$defs": {
    "branch": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,199}$"},
    "trailer": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"}
  }
}
