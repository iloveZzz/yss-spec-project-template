{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.example/schemas/api-contract-decision.schema.json",
  "title": "YSS API Contract Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "decision_id", "decision_version", "status", "current_version", "impact", "assessment_ref", "assessment_digest", "evidence_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "api-contract-decision" },
    "decision_id": { "type": "string", "minLength": 1 },
    "decision_version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "status": { "const": "approved" },
    "current_version": { "const": true },
    "impact": { "enum": ["required", "not-applicable"] },
    "assessment_ref": { "type": "string", "minLength": 1 },
    "assessment_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "reason": { "type": "string", "minLength": 1 },
    "openapi": { "$ref": "#/$defs/versionedArtifact" },
    "validation_record": { "$ref": "#/$defs/artifact" },
    "draft_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "result", "blocking_findings", "draft_ref", "draft_digest", "evidence_refs"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "result": { "const": "approved" },
        "blocking_findings": { "type": "array", "maxItems": 0 },
        "draft_ref": { "type": "string", "minLength": 1 },
        "draft_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "freeze": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "frozen_at", "draft_ref", "draft_digest"],
      "properties": {
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "frozen_at": { "type": "string", "format": "date-time" },
        "draft_ref": { "type": "string", "minLength": 1 },
        "draft_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "impact": { "const": "required" } } }, "then": { "required": ["openapi", "validation_record", "draft_review", "freeze"] } },
    { "if": { "properties": { "impact": { "const": "not-applicable" } } }, "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["openapi"] }, { "required": ["validation_record"] }, { "required": ["draft_review"] }, { "required": ["freeze"] }] } } }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    },
    "versionedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ref", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "ref": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
        "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      }
    }
  }
}
