{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"派生阅读清单",
 "type":"object","additionalProperties":false,
 "required":["schema_version","checkpoint_ref","renderer","dependencies","outputs","navigation","diagnostics"],
 "properties":{
  "schema_version":{"const":1},"checkpoint_ref":{"type":"string"},
  "renderer":{"type":"object","additionalProperties":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},
  "dependencies":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["scope","ref","digest"],"properties":{"scope":{"enum":["project","tool"]},"ref":{"type":"string"},"digest":{"anyOf":[{"type":"null"},{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}]}}}},
  "outputs":{"type":"object","additionalProperties":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}},
  "navigation":{"type":"object","additionalProperties":false,"required":["ref","block_digest"],"properties":{"ref":{"type":"string"},"block_digest":{"type":"string","pattern":"^sha256:[a-f0-9]{64}$"}}},
  "diagnostics":{"type":"array","items":{"type":"object","required":["ref","reason"],"properties":{"ref":{"type":"string"},"reason":{"type":"string"}}}}
 }
}
