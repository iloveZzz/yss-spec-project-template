{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/harness-profile.schema.json",
  "title": "New Profile3; historical1/2 remain original-reader inputs",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "required_capabilities",
    "lifecycle",
    "execution"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "profile_id": {
      "enum": [
        "harness.spec-template",
        "harness.backend-delivery"
      ]
    },
    "status": {
      "const": "active"
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "role-independent-governance-v1"
      }
    },
    "lifecycle": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "audience": {
      "type": "object",
      "not": {
        "anyOf": [
          {
            "required": [
              "target_user_roles"
            ]
          },
          {
            "required": [
              "control_plane_roles"
            ]
          }
        ]
      }
    }
  }
}
