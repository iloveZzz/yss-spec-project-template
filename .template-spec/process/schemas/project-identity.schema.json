{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/project-identity.schema.json",
  "title": "Root identity2 for new governed instances; template source stays1",
  "type": "object",
  "required": [
    "schema_version",
    "repository_mode"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "repository_mode": {
      "enum": [
        "template-source",
        "project-instance"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "repository_mode": {
            "const": "project-instance"
          }
        }
      }
    }
  ]
}
