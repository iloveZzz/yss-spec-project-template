{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "const": "accepted"
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "backend_delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "import_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "import_receipt_ref",
        "bundle_digest"
      ]
    },
    "strategic_handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "import_receipt_ref": {
          "type": "string",
          "minLength": 1
        },
        "bundle_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "context_reconciliation_ref": {
          "type": "string",
          "minLength": 1
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_id",
              "source_digest",
              "disposition",
              "dependency_status",
              "dependent_slice_refs",
              "evidence_refs"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "minLength": 1
              },
              "source_digest": {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              "disposition": {
                "enum": [
                  "mapped",
                  "pending",
                  "conflict",
                  "deferred",
                  "not-applicable"
                ]
              },
              "dependency_status": {
                "enum": [
                  "known",
                  "unknown"
                ]
              },
              "dependent_slice_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "frontend_case_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "import_receipt_ref",
        "bundle_digest",
        "context_reconciliation_ref",
        "rows"
      ]
    },
    "frontend_cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "outcome": {
            "enum": [
              "success",
              "failure"
            ]
          },
          "operation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "visual_case_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "case_id",
          "source_ids",
          "outcome",
          "operation_ids",
          "visual_case_ids",
          "evidence_ref",
          "evidence_digest"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "status",
    "slice_id",
    "backend_delivery",
    "strategic_handoff",
    "frontend_cases"
  ]
}
