{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/approval-record.schema.json",
  "title": "Approval1/2 history and approval3 current evidence contract",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "schema_version",
        "gate_id",
        "decision",
        "actor_kind",
        "role_id",
        "runtime_id",
        "principal_ref"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            1,
            2
          ]
        },
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "vetoed",
            "pending"
          ]
        },
        "actor_kind": {
          "enum": [
            "digital-human",
            "biological-human",
            "orchestrator"
          ]
        },
        "role_id": {
          "type": "string",
          "minLength": 1
        },
        "runtime_id": {
          "type": "string",
          "minLength": 1
        },
        "principal_ref": {
          "type": "string",
          "minLength": 1
        },
        "subject_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "subject_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(sha256:)?[a-f0-9]{64}$"
        },
        "approval_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "biological_veto": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array"
        },
        "countersigner_role_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "drafter_principal_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "review_task_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "review_task_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "capability_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^capability\\.[a-z0-9][a-z0-9-]*$"
          }
        },
        "plan_review_binding": {
          "$ref": "plan-review-control.schema.json#/$defs/binding"
        },
        "independence": {
          "$ref": "#/$defs/independence"
        }
      },
      "$comment": "Full structure schema retains history/draft readability. Current kernel requires nonempty independently bound subject/scope/basis/identity and current task; no history result authorizes execution.",
      "allOf": [
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 2
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "required": [
              "subject_ref",
              "subject_digest",
              "approval_scope",
              "basis",
              "drafter_principal_ref",
              "review_task_ref",
              "review_task_digest",
              "capability_ids"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {
                "const": 1
              }
            },
            "required": [
              "schema_version"
            ]
          },
          "then": {
            "properties": {
              "decision": {
                "enum": [
                  "approved",
                  "rejected",
                  "vetoed"
                ]
              }
            }
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "gate_id",
        "decision",
        "actor_kind",
        "subject_ref",
        "subject_digest",
        "approval_scope",
        "basis",
        "evidence_refs",
        "check_ids",
        "policy",
        "review"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "approved",
            "rejected",
            "vetoed",
            "pending"
          ]
        },
        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "approval_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "governance-evidence.schema.json#/$defs/asset"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_task_ref": {
          "type": "string",
          "minLength": 1
        },
        "review_task_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_review_binding": {
          "$ref": "plan-review-control.schema.json#/$defs/binding"
        },
        "schema_version": {
          "const": 3
        },
        "actor_kind": {
          "enum": [
            "agent",
            "human"
          ]
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy": {
          "$ref": "governance-evidence.schema.json#/$defs/policy"
        },
        "review": {
          "$ref": "governance-evidence.schema.json#/$defs/review"
        },
        "user_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "continuation_ref": {
          "type": "string",
          "minLength": 1
        },
        "review_bundle_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "not": {
              "properties": {
                "gate_id": {
                  "const": "gate.plan-approved"
                }
              }
            }
          },
          "then": {
            "required": [
              "review_task_ref",
              "review_task_digest"
            ]
          }
        }
      ]
    }
  ],
  "$defs": {
    "independence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "description": "审查与起草/实现是否在不同 Agent 会话中进行；仅如实记录，不改变放行规则。缺省表示未声明。",
      "properties": {
        "mode": {
          "enum": [
            "separate-session",
            "same-session"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
