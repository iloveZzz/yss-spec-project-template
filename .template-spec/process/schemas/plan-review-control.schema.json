{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/plan-review-control.schema.json",
  "title": "YSS bounded Plan professional review control v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "feature_id",
    "cycle_id",
    "scope_ids",
    "scope_digest",
    "policy_ref",
    "policy_digest",
    "status",
    "attempts",
    "findings",
    "diagnoses",
    "history_count",
    "history_evidence",
    "predecessors",
    "provenance"
  ],
  "properties": {
    "protocol_version": {
      "const": "bounded-plan-review-v1"
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "cycle_id": {
      "type": "string",
      "minLength": 1
    },
    "scope_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "policy_ref": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "active",
        "diagnosis-required",
        "diagnosis-ready",
        "blocked",
        "converged",
        "history-unknown"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/attempt"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "diagnoses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosis"
      }
    },
    "history_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "history_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "predecessors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/predecessor"
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_ref",
        "source_digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "new-feature",
            "adopted",
            "successor"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "history_conclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "approval_ref",
          "approval_digest",
          "subject_ref",
          "subject_digest",
          "approval_scope",
          "basis"
        ],
        "properties": {
          "check_id": {
            "enum": [
              "check.domain-strategy-approved",
              "check.stage-decision-package-approved"
            ]
          },
          "approval_ref": {
            "type": "string",
            "minLength": 1
          },
          "approval_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "subject_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "approval_scope": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "basis": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/evidence"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "checkpoint_ref",
        "cycle_id",
        "attempt_id",
        "phase",
        "scope_digest",
        "request_key",
        "check_ids",
        "target_finding_ids"
      ],
      "properties": {
        "protocol_version": {
          "const": "bounded-plan-review-v1"
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "cycle_id": {
          "type": "string",
          "minLength": 1
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "initial",
            "rereview",
            "exception"
          ]
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "request_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "check_ids": {
          "type": "array",
          "items": {
            "enum": [
              "check.domain-strategy-approved",
              "check.stage-decision-package-approved"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "exception"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "target_finding_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "rule_ref",
        "scenario",
        "evidence",
        "close_condition",
        "status",
        "first_attempt_id",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "violation",
            "missing-evidence",
            "suggestion"
          ]
        },
        "origin": {
          "enum": [
            "initial",
            "repair",
            "new-evidence",
            "initial-miss"
          ]
        },
        "rule_ref": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "close_condition": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "backlog"
          ]
        },
        "first_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_id",
              "status",
              "evidence",
              "reason"
            ],
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "closed",
                  "backlog"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "properties": {
            "rule_ref": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "scenario": {
              "minLength": 1
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "suggestion"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "backlog"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "violation",
                  "missing-evidence"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "closed"
                ]
              }
            }
          }
        }
      ]
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "phase",
        "status",
        "request_key",
        "checkpoint_ref",
        "task_ref",
        "task_digest",
        "candidate_ref",
        "candidate_digest",
        "basis",
        "check_ids",
        "target_finding_ids",
        "resolution_evidence",
        "outcome",
        "created_at",
        "dispatched_at",
        "completed_at",
        "result_ref",
        "result_digest",
        "check_results"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "phase": {
          "enum": [
            "initial",
            "rereview",
            "exception"
          ]
        },
        "status": {
          "enum": [
            "reserved",
            "dispatched",
            "completed"
          ]
        },
        "request_key": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "task_ref": {
          "type": "string",
          "minLength": 1
        },
        "task_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "check_ids": {
          "type": "array",
          "items": {
            "enum": [
              "check.domain-strategy-approved",
              "check.stage-decision-package-approved"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "target_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "resolution_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "outcome": {
          "enum": [
            null,
            "passed",
            "blocked"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "dispatched_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "result_digest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "check_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "status"
            ],
            "properties": {
              "check_id": {
                "enum": [
                  "check.domain-strategy-approved",
                  "check.stage-decision-package-approved"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "blocked"
                ]
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "dispatched"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "task_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "dispatched_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "task_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "dispatched_at": {
                "type": "string",
                "format": "date-time"
              },
              "completed_at": {
                "type": "string",
                "format": "date-time"
              },
              "result_ref": {
                "type": "string",
                "minLength": 1
              },
              "result_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "outcome": {
                "enum": [
                  "passed",
                  "blocked"
                ]
              },
              "check_results": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "phase": {
                "const": "exception"
              }
            },
            "required": [
              "phase"
            ]
          },
          "then": {
            "properties": {
              "target_finding_ids": {
                "minItems": 1
              },
              "resolution_evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "finding_ids",
        "resolution_evidence",
        "completed_at"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "resolution_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cycle_id",
        "scope_digest",
        "history_evidence",
        "scope_change_evidence",
        "user_decision_ref",
        "user_decision_digest"
      ],
      "properties": {
        "cycle_id": {
          "type": "string",
          "minLength": 1
        },
        "scope_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "history_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "scope_change_evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "user_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "user_decision_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "resultFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "origin",
        "rule_ref",
        "scenario",
        "evidence",
        "close_condition",
        "status",
        "first_attempt_id",
        "history"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "violation",
            "missing-evidence",
            "suggestion"
          ]
        },
        "origin": {
          "enum": [
            "initial",
            "repair",
            "new-evidence",
            "initial-miss"
          ]
        },
        "rule_ref": {
          "type": "string"
        },
        "scenario": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          },
          "minItems": 1
        },
        "close_condition": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "closed",
            "backlog"
          ]
        },
        "first_attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "attempt_id",
              "status",
              "evidence",
              "reason"
            ],
            "properties": {
              "attempt_id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "open",
                  "closed",
                  "backlog"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "minItems": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "reopen_reason": {
          "enum": [
            "behavior-changed",
            "closure-evidence-invalid"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "properties": {
            "rule_ref": {
              "minLength": 1
            }
          }
        },
        {
          "properties": {
            "scenario": {
              "minLength": 1
            }
          }
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "suggestion"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "backlog"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "violation",
                  "missing-evidence"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "open",
                  "closed"
                ]
              }
            }
          }
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_review_binding",
        "outcome",
        "check_results",
        "findings"
      ],
      "properties": {
        "plan_review_binding": {
          "$ref": "#/$defs/binding"
        },
        "outcome": {
          "enum": [
            "passed",
            "blocked"
          ]
        },
        "check_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "check_id",
              "status"
            ],
            "properties": {
              "check_id": {
                "enum": [
                  "check.domain-strategy-approved",
                  "check.stage-decision-package-approved"
                ]
              },
              "status": {
                "enum": [
                  "passed",
                  "blocked"
                ]
              }
            }
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultFinding"
          }
        }
      }
    }
  }
}
