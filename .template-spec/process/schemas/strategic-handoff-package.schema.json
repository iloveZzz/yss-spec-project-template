{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/strategic-handoff-package.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "version",
    "handoff_ref",
    "bundle_digest",
    "previous_bundle",
    "files"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "bundle_id": {
      "type": "string",
      "pattern": "^strategic-design-handoff\\.[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "handoff_ref": {
      "type": "string",
      "minLength": 1
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "previous_bundle": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundle_id",
            "version",
            "digest"
          ],
          "properties": {
            "bundle_id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^v[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "original_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minItems": 1
    },
    "source_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "repository_root",
        "tasks",
        "objects",
        "files"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "repository_root": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest",
              "mode"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "mode": {
                "type": "integer",
                "minimum": 0,
                "maximum": 511
              }
            }
          }
        },
        "objects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "oid",
              "data_base64"
            ],
            "properties": {
              "type": {
                "enum": [
                  "commit",
                  "tree",
                  "blob"
                ]
              },
              "oid": {
                "type": "string",
                "pattern": "^[a-f0-9]{40}$"
              },
              "data_base64": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "source_execution"
        ]
      },
      "else": {
        "not": {
          "required": [
            "source_execution"
          ]
        }
      }
    }
  ]
}
