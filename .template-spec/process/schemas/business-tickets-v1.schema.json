          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "status": {
          "enum": [
            "draft",
            "ready-for-human"
          ]
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^v[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "locator": {
              "type": "string",
              "minLength": 1
