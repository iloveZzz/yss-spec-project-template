{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "business-tickets-v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "business-ticket"
        },
        "id": {
          "type": "string",
          "pattern": "^BT-[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "status": {
          "enum": [
            "draft",
            "ready-for-human"
          ]
        },
        "spec": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "pattern": "^v[1-9][0-9]*$"
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "locator": {
              "type": "string",
              "minLength": 1
            },
            "locator_kind": {
              "enum": [
                "id",
                "heading"
              ]
            }
          },
          "required": [
            "ref",
            "version",
            "digest"
          ]
        },
        "requirement_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptance_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^v[1-9][0-9]*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "locator_kind": {
                "enum": [
                  "id",
                  "heading"
                ]
              }
            },
            "required": [
              "ref",
              "version",
              "digest"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "resolve_by": {
                "type": "string",
                "minLength": 1
              },
              "blocking": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "question",
              "owner",
              "resolve_by",
              "blocking"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "status",
        "spec",
        "requirement_refs",
        "acceptance_refs",
        "dependencies",
        "source_refs",
        "open_questions"
      ]
    },
