              "id": {
                "type": "string",
                "minLength": 1
              },
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^v[1-9][0-9]*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            },
            "required": [
              "id",
              "ref",
              "version",
              "digest"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "coverage_deferred": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "risk": {
                "type": "string",
                "minLength": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1
              },
              "target_version": {
                "type": "string",
                "minLength": 1
              },
              "followup_ticket_ref": {
                "type": "string",
                "minLength": 1
              },
              "verification_plan": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "pattern": "^v[1-9][0-9]*$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator_kind": {
                    "enum": [
                      "id",
                      "heading"
                    ]
                  }
                },
                "required": [
                  "ref",
                  "version",
                  "digest"
                ]
              }
            },
            "required": [
              "id",
              "reason",
              "risk",
              "owner",
              "target_version",
              "followup_ticket_ref",
              "verification_plan"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "review_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "kind",
        "id",
        "version",
        "status",
        "spec",
        "tickets",
        "coverage_deferred"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
