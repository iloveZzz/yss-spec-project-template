        "subject_ref": {
          "type": "string",
          "minLength": 1
        },
        "subject_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "drafter": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string",
                "pattern": "^v[1-9][0-9]*$"
              },
              "digest": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "locator_kind": {
                "enum": [
                  "id",
                  "heading"
                ]
              }
            },
            "required": [
              "ref",
              "version",
              "digest"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "schema_version",
        "kind",
        "result",
        "subject_ref",
        "subject_digest",
        "reviewer",
        "drafter",
        "evidence"
      ]
    }
  ]
}
