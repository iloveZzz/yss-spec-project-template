{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/strategic-handoff-delivery-verification-v1.schema.json",
  "title": "YSS Strategic Delivery Verification v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "result", "command", "exit_code", "executed_at", "package_ref", "manifest_ref", "bundle_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "strategic-delivery-verification-v1"},
    "result": {"const": "verified"},
    "command": {"type": "string", "minLength": 1},
    "exit_code": {"const": 0},
    "executed_at": {"type": "string", "format": "date-time"},
    "package_ref": {"const": "package"},
    "manifest_ref": {"const": "package/manifest.json"},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
