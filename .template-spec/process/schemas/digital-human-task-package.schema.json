{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/digital-human-task-package.schema.json",
  "title": "YSS Digital Human Task Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "work_unit_id",
    "actor_id",
    "role_id",
    "runtime_id",
    "execution_state",
    "workflow_status",
    "skill_source",
    "contract",
    "inputs",
    "objective",
    "allowed_write_paths",
    "forbidden_actions",
    "expected_outputs",
    "expected_evidence_files",
    "verification_commands",
    "verification_results",
    "downstream_consumers",
    "convergence"
  ],
  "properties": {
    "transition_evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategic_handoff_consumption": {
          "type": "object"
        },
        "approved_spec": {
          "type": "object"
        },
        "context_reconciliation": {
          "type": "object"
        },
        "technical_design": {
          "type": "object"
        },
        "data_architecture_decision": {
          "type": "object"
        },
        "api_contract_decision": {
          "type": "object"
        },
        "engineering_contract_approval_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan_review_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_approval_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_user_decision_ref": {
      "type": "string",
      "minLength": 1
    },
    "plan_continuation_ref": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "enum": [
        1,
        2
      ]
    },
    "frontend_delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance_ref"
      ],
      "properties": {
        "acceptance_ref": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "slice_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "work_unit_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^work-unit\\.[a-z0-9][a-z0-9-]*$"
    },
    "actor_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
    },
    "role_id": {
      "type": "string",
      "pattern": "^role\\.[a-z0-9][a-z0-9-]*$"
    },
    "runtime_id": {
      "type": "string",
      "pattern": "^runtime\\.[a-z0-9][a-z0-9-]*$"
    },
    "execution_state": {
      "enum": [
        "Explorer",
        "Drafter",
        "Worker",
        "Reviewer",
        "Verifier"
      ]
    },
    "workflow_status": {
      "enum": [
        "not-started",
        "active",
        "paused",
        "resolved",
        "failed"
      ]
    },
    "stage_id": {
      "type": "string",
      "pattern": "^stage\\.[a-z0-9][a-z0-9-]*$"
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "skill_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_ref",
        "defaults_ref",
        "core_skills",
        "forbidden_skills"
      ],
      "properties": {
        "registry_ref": {
          "const": ".template-spec/agents/digital-human-roles.yaml"
        },
        "defaults_ref": {
          "type": "string",
          "minLength": 1
        },
        "core_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "contract_id",
        "contract_version",
        "status",
        "contract_ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lifecycle-work-unit",
            "slice-implementation",
            "template-maintenance",
            "read-only-intake"
          ]
        },
        "contract_id": {
          "type": "string",
          "minLength": 1
        },
        "contract_version": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          ]
        },
        "status": {
          "enum": [
            "issued",
            "stale",
            "blocked"
          ]
        },
        "contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "lifecycle_ref": {
          "type": "string",
          "minLength": 1
        },
        "slice_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "maintenance_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_kind": {
          "type": "string",
          "minLength": 1
        },
        "candidate_requirement": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^(?:sha256:)?[a-f0-9]{64}$"
        },
        "review_axis": {
          "enum": [
            "standards",
            "spec",
            "lead"
          ]
        },
        "review_round": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "applicable_rule_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "artifact_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gate_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "user_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "boundary",
          "subject_ref",
          "scope"
        ],
        "oneOf": [
          {
            "required": [
              "user_decision_ref"
            ]
          },
          {
            "required": [
              "continuation_ref"
            ]
          }
        ],
        "properties": {
          "boundary": {
            "type": "string"
          },
          "subject_ref": {
            "type": "string"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "user_decision_ref": {
            "type": "string",
            "minLength": 1
          },
          "continuation_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_read_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "allowed_write_paths": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "forbidden_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expected_evidence_files": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command",
          "exit_code",
          "executed_at",
          "evidence_ref"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "exit_code": {
            "type": "integer",
            "minimum": 0
          },
          "duration_ms": {
            "type": "integer",
            "minimum": 0
          },
          "executed_at": {
            "type": "string",
            "minLength": 1
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "stdout_ref": {
            "type": "string",
            "minLength": 1
          },
          "stderr_ref": {
            "type": "string",
            "minLength": 1
          },
          "evidence_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "review_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implementation_actor_id"
      ],
      "properties": {
        "implementation_actor_id": {
          "type": "string",
          "minLength": 1
        },
        "implementation_task_id": {
          "type": "string",
          "minLength": 1
        },
        "check_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(gate|check)\\.[a-z0-9][a-z0-9-]*$"
          }
        },
        "capability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^capability\\.[a-z0-9][a-z0-9-]*$"
          }
        },
        "candidate_ref": {
          "type": "string",
          "minLength": 1
        },
        "candidate_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "policy_ref": {
          "const": ".template-spec/agents/digital-human-roles.yaml"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewer_principal_ref": {
          "type": "string",
          "minLength": 1
        },
        "drafter_principal_ref": {
          "type": "string",
          "minLength": 1
        },
        "approval_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "basis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "current_approvals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "boundary",
              "subject_ref",
              "subject_digest",
              "approval_scope",
              "basis",
              "drafter_principal_ref"
            ],
            "properties": {
              "boundary": {
                "type": "string",
                "pattern": "^(gate|check)\\.[a-z0-9][a-z0-9-]*$"
              },
              "subject_ref": {
                "type": "string",
                "minLength": 1
              },
              "subject_digest": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "approval_scope": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "basis": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "ref",
                    "digest"
                  ],
                  "properties": {
                    "ref": {
                      "type": "string",
                      "minLength": 1
                    },
                    "digest": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  }
                }
              },
              "drafter_principal_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "plan_review_binding": {
          "$ref": "plan-review-control.schema.json#/$defs/binding"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "capability_ids"
            ]
          },
          "then": {
            "required": [
              "check_ids",
              "capability_ids",
              "candidate_ref",
              "candidate_digest",
              "policy_ref",
              "policy_digest",
              "reviewer_principal_ref",
              "drafter_principal_ref",
              "approval_scope",
              "basis",
              "current_approvals"
            ]
          }
        }
      ]
    },
    "downstream_consumers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_work_unit",
        "convergence_ref"
      ],
      "properties": {
        "parent_work_unit": {
          "type": "string",
          "pattern": "^work-unit\\.[a-z0-9][a-z0-9-]*$"
        },
        "convergence_ref": {
          "type": "string",
          "minLength": 1
        },
        "conflict_escalation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result_schema": {
          "const": "workflow-execution-result-v1"
        },
        "work_unit": {
          "type": "string",
          "minLength": 1
        },
        "workflow_reference": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "completed",
            "blocked",
            "needs-human",
            "failed"
          ]
        },
        "context_reconciliation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "ref"
          ],
          "properties": {
            "status": {
              "enum": [
                "reconciled",
                "not-applicable",
                "blocked"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "skill": {
          "type": "string",
          "minLength": 1
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "changed_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deferred_seams": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "drift": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "violation": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "new_impacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stale_candidates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next_route": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "blocking_signals": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "checkpoint_ref": {
          "type": "string",
          "minLength": 1
        },
        "research_verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "maintenance_authorization": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref",
            "digest"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            },
            "digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "review_input": {
      "type": "object",
      "properties": {
        "slice_contract_ref": {
          "type": "string",
          "minLength": 1
        },
        "scope_kind": {
          "enum": [
            "baseline",
            "change"
          ]
        },
        "standards_coverage_ref": {
          "type": "string",
          "minLength": 1
        },
        "standards_coverage_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "review_base_ref": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "responsibility_evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "digest"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "digest": {
                "type": "string",
                "pattern": "^(sha256:)?[a-f0-9]{64}$"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "scope_kind"
            ],
            "properties": {
              "scope_kind": {
                "const": "change"
              }
            }
          },
          "then": {
            "required": [
              "slice_contract_ref",
              "standards_coverage_ref",
              "standards_coverage_digest"
            ]
          }
        }
      ]
    },
    "review_result_ref": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_ref": {
      "type": "string",
      "minLength": 1
    },
    "verification_status": {
      "enum": [
        "not-executed",
        "executed"
      ]
    },
    "observation_ref": {
      "type": "string",
      "pattern": "^run:"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "kind": {
                "const": "lifecycle-work-unit"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "stage_id"
        ],
        "properties": {
          "contract": {
            "required": [
              "lifecycle_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "kind": {
                "const": "slice-implementation"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "stage_id"
        ],
        "properties": {
          "contract": {
            "required": [
              "slice_contract_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "contract": {
            "properties": {
              "kind": {
                "const": "template-maintenance"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "contract": {
            "required": [
              "maintenance_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "execution_state": {
            "const": "Reviewer"
          }
        }
      },
      "then": {
        "required": [
          "review_context"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "contract": {
            "properties": {
              "kind": {
                "enum": [
                  "lifecycle-work-unit",
                  "slice-implementation",
                  "template-maintenance"
                ]
              }
            }
          },
          "allowed_write_paths": {
            "minItems": 1
          },
          "expected_evidence_files": {
            "minItems": 1
          },
          "verification_commands": {
            "minItems": 1
          }
        }
      },
      "else": {
        "required": [
          "verification_status"
        ],
        "properties": {
          "execution_state": {
            "const": "Explorer"
          },
          "work_unit_id": {
            "enum": [
              "work-unit.entry-triage",
              "work-unit.harness-entry"
            ]
          },
          "allowed_write_paths": {
            "maxItems": 0
          },
          "contract": {
            "properties": {
              "kind": {
                "const": "read-only-intake"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "maintenance_ref"
                  ]
                },
                {
                  "required": [
                    "slice_contract_ref"
                  ]
                },
                {
                  "required": [
                    "lifecycle_ref"
                  ]
                }
              ]
            }
          },
          "result": {
            "properties": {
              "changed_files": {
