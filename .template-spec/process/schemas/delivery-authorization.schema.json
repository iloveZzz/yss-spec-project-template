{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "basis",
    "external_rules",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "delivery-authorization"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "governance-evidence.schema.json#/$defs/asset"
      }
    },
    "external_rules": {
      "$ref": "governance-evidence.schema.json#/$defs/external_rules"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundary",
          "subject_ref",
          "scope",
          "decision_basis"
        ],
        "properties": {
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "business_scope",
              "acceptance",
              "contract_commitments",
              "authorization",
              "risk_acceptance",
              "quality",
              "external_commitments"
            ],
            "properties": {
              "business_scope": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "contract_commitments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "authorization": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "risk_acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "quality": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "external_commitments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              }
            },
            "description": "Seven required dimensions contain concrete JSON Pointer selectors into the originally approved subject model; values must remain equal. Markdown uses frontmatter and body."
          },
          "continuation_paths": {
            "type": "object",
            "additionalProperties": false,
            "description": "Optional original authorization of existing nonprotected technical/evidence containers only; never permits future unknown fields or protected selector intersections.",
            "properties": {
              "implementation-detail": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              },
              "evidence-supplement": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^/(?:[^~*]|~[01])+$"
                }
              }
            }
          },
          "implementation_limits": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "repositories",
                "allowed_write_paths"
              ],
              "properties": {
                "repositories": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "allowed_write_paths": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "boundary": {
                  "const": "implementation-scope"
                }
              },
              "required": [
                "boundary"
              ]
            },
            "then": {
              "required": [
                "implementation_limits"
              ]
            }
          }
        ]
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/delivery-authorization.schema.json"
}
