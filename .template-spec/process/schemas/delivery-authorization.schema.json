{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "basis",
    "external_rules",
    "targets"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "delivery-authorization"
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "governance-evidence.schema.json#/$defs/asset"
      }
    },
    "external_rules": {
      "$ref": "governance-evidence.schema.json#/$defs/external_rules"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "boundary",
          "subject_ref",
          "scope",
          "decision_basis"
        ],
        "properties": {
          "boundary": {
            "type": "string",
            "minLength": 1
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "decision_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "business_scope",
              "acceptance",
              "contract_commitments",
              "authorization",
              "risk_acceptance",
              "quality",
              "external_commitments"
            ],
            "properties": {
              "business_scope": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "contract_commitments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "authorization": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "risk_acceptance": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "quality": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "external_commitments": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.dev/schemas/delivery-authorization.schema.json"
}
