{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.local/schemas/strategic-consumer-feedback-v1.json",
  "title": "YSS Strategic Consumer Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feedback_id", "status", "import_receipt_ref", "bundle", "route_id", "source", "issue_type", "severity", "suggestion", "raised_by", "evidence_refs", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "feedback_id": {"type": "string", "pattern": "^consumer-feedback\\.[a-z0-9][a-z0-9-]*$"},
    "status": {"const": "submitted"},
    "import_receipt_ref": {"type": "string", "minLength": 1},
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^strategic-design-handoff\\.[a-z0-9][a-z0-9-]*$"},
        "version": {"type": "string", "pattern": "^v[1-9][0-9]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "route_id": {"type": "string", "pattern": "^route\\.[a-z0-9][a-z0-9-]*$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "digest"],
      "properties": {
        "id": {"type": "string", "pattern": "^(rule|scenario|invariant)\\.[a-z0-9][a-z0-9-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "issue_type": {"enum": ["rule-conflict", "scenario-gap", "impact-mismatch", "context-conflict", "design-baseline", "other"]},
    "severity": {"enum": ["blocking", "non-blocking"]},
    "suggestion": {"type": "string", "minLength": 1},
    "raised_by": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
