{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yss.example/schemas/data-architecture-decision.schema.json",
  "title": "YSS Data Architecture Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "decision_id", "decision_version", "status", "current_version", "impact", "assessment_ref", "assessment_digest", "evidence_refs"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "data-architecture-decision" },
    "decision_id": { "type": "string", "pattern": "^data-architecture\\.[a-z0-9][a-z0-9-]*$" },
    "decision_version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "status": { "const": "approved" },
    "current_version": { "const": true },
    "impact": { "enum": ["required", "not-applicable"] },
    "assessment_ref": { "type": "string", "minLength": 1 },
    "assessment_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "data_architecture_ref": { "type": "string", "minLength": 1 },
    "data_architecture_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "review_evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "reason": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "impact": { "const": "required" } }, "required": ["impact"] },
      "then": { "required": ["data_architecture_ref", "data_architecture_digest", "review_evidence_refs"], "not": { "required": ["reason"] } }
    },
    {
      "if": { "properties": { "impact": { "const": "not-applicable" } }, "required": ["impact"] },
      "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["data_architecture_ref"] }, { "required": ["data_architecture_digest"] }, { "required": ["review_evidence_refs"] }] } }
    }
  ]
}
