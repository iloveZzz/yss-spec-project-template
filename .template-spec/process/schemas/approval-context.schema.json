{
  "type": "object",
  "required": [
    "subject_ref",
    "approval_scope",
    "basis",
    "drafter_principal_ref"
  ],
  "properties": {
    "subject_ref": {
      "type": "string",
      "minLength": 1
    },
    "subject_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[a-f0-9]{64}$"
    },
    "approval_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "basis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "ref",
          "digest"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^(sha256:)?[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "drafter_principal_ref": {
      "type": "string",
      "minLength": 1
    },
    "review_package": {
      "type": "boolean"
    },
    "review_context": {
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consumer-owned current approval context",
  "additionalProperties": false
}
