#!/usr/bin/env node
// 薄壳：校验语义归 yss（contract verify --kind scaffold-decisions），这里只翻译参数、透传结论与退出码。
import path from "node:path";
import { realpathSync } from "node:fs";
import { parseArgs } from "node:util";
import { nativeContractVerify, assertNativeCapabilities, NEEDS } from "./lib/native-evidence.mjs";

try {
  const { values, positionals } = parseArgs({ options: { "allow-template": { type: "boolean" }, root: { type: "string", default: path.resolve(import.meta.dirname, "..") } }, allowPositionals: true, strict: true });
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-scaffold-architecture-decisions [--allow-template] [--root <project>] <file.yaml>");
  assertNativeCapabilities(NEEDS.scaffoldDecisions);
  const root = realpathSync(path.resolve(values.root));
  const result = nativeContractVerify({ root, kind: "scaffold-decisions", file: path.resolve(positionals[0]), extra: values["allow-template"] ? ["--allow-template"] : [] });
  if (result.exitCode !== 0) { process.stderr.write(`脚手架架构选择记录验证失败: ${result.message}\n`); process.exitCode = result.exitCode; }
  else process.stdout.write("脚手架架构选择记录验证通过\n");
} catch (error) {
  process.stderr.write(`脚手架架构选择记录验证失败: ${error.message}\n`);
  process.exitCode = 1;
}
