#!/usr/bin/env node
import { test } from 'node:test';
import assert from 'node:assert/strict';
import { existsSync, mkdtempSync, mkdirSync, readFileSync, writeFileSync, cpSync, rmSync } from 'node:fs';
import path from 'node:path';
import { tmpdir } from 'node:os';
import { spawnSync } from 'node:child_process';
import { fixture, context } from './fixtures/strategic-handoff/fixture.mjs';
import { exportBundle, openBundle, importBundle } from './lib/strategic-handoff.mjs';
import { read, json, hash, digest } from './lib/strategic-handoff-io.mjs';
import { parseContextContract } from './lib/context-contract.mjs';
const setup=async t=>{const base=mkdtempSync(path.join(tmpdir(),'handoff-test-'));t.after(()=>rmSync(base,{recursive:true,force:true}));const source=path.join(base,'source');mkdirSync(source);return{base,source,...await fixture(source,{technicalDesign:true})};};
const setupV4=async (t,options={})=>{const base=mkdtempSync(path.join(tmpdir(),'handoff-v4-test-'));t.after(()=>rmSync(base,{recursive:true,force:true}));const source=path.join(base,'source');mkdirSync(source);return{base,source,...await fixture(source,{handoffVersion:4,...options})};};
function advanceStrategy(f,version='v2') {
 f.handoff.handoff_version=version;
 f.strategy.domain_version=version;
 f.strategy.approval.current_version=version;
 f.stage.package_version=version;
 f.stage.approval.current_version=version;
 f.stage.domain_strategy_ref.domain_version=version;
 f.handoff.source.domain_strategy_ref.version=version;
 f.handoff.source.stage_decision_package_ref.version=version;
 f.strategy.rule_catalog[0].statement='材料完整且有效';
 f.strategy.scenarios[0].rules=['材料完整且有效'];
 f.strategy.invariants[0].statement='材料完整且有效';
 f.put('source/strategy.yaml',f.strategy);
 f.handoff.source.domain_strategy_ref.digest=digest(f.strategy);
 f.stage.domain_strategy_ref.digest=digest(f.strategy);
 f.put('source/stage.yaml',f.stage);
 f.handoff.source.stage_decision_package_ref.digest=digest(f.stage);
 f.sign();
}
test('目录和 ZIP 可脱离源仓验包；导入幂等且不修改词汇表',async t=>{
 const f=await setup(t);const output=path.join(f.base,'package');
 const result=await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output,zip:true});
 rmSync(f.source,{recursive:true});
 for(const bundle of [output,`${output}.zip`])assert.equal(await openBundle(bundle,b=>b.manifest.bundle_digest),result.bundle_digest);
 const target=path.join(f.base,'target');mkdirSync(target);writeFileSync(path.join(target,'yss-project.yaml'),'schema_version: 1\nrepository_mode: project-instance\n');writeFileSync(path.join(target,'CONTEXT.md'),context);
 const imported=await importBundle({bundle:`${output}.zip`,targetRoot:target});assert.equal(imported.result,'imported-pending-reconciliation');
 assert.equal(read(path.join(target,imported.receipt_ref)).schema_version,1);
 assert.equal(readFileSync(path.join(target,'CONTEXT.md'),'utf8'),context);parseContextContract({root:target});
 assert.equal((await importBundle({bundle:output,targetRoot:target})).result,'already-imported');
});
test('v4 按消费者能力导入 Import Receipt v2 并生成路由草案',async t=>{
 const f=await setupV4(t),output=path.join(f.base,'package');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output});
 const target=path.join(f.base,'target');mkdirSync(path.join(target,'docs/process'),{recursive:true});
 writeFileSync(path.join(target,'yss-project.yaml'),'schema_version: 1\nrepository_mode: project-instance\n');writeFileSync(path.join(target,'CONTEXT.md'),context);
 writeFileSync(path.join(target,'docs/process/harness-profile.yaml'),json({schema_version:2,profile_id:'yss-harness-backend',handoff:{consumer_capabilities:['backend-technical-design']}}));
 const imported=await importBundle({bundle:output,targetRoot:target});const receipt=read(path.join(target,imported.receipt_ref));
 assert.equal(receipt.schema_version,2);assert.equal(receipt.target_profile_id,'yss-harness-backend');assert.deepEqual(receipt.selected_consumer_capabilities,['backend-technical-design']);
 assert.equal(receipt.routes[0].route_id,'route.backend');assert.match(receipt.routes[0].artifact_refs.join(','),/backend-technical-traceability-draft/);
 assert.equal(read(path.join(target,`docs/handoffs/${receipt.bundle_id}/${receipt.version}/context-reconciliation-draft.json`)).schema_version,2);
});
test('v4 路由必须与影响矩阵一致；未知版本 fail closed',async t=>{
 const f=await setupV4(t),run=()=>exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:path.join(f.base,'out')});
 const backendRoute=f.handoff.consumer_routes.find(route=>route.capability==='backend-technical-design');backendRoute.activation='not-applicable';backendRoute.reason='伪造不适用';backendRoute.evidence_refs=['evidence/offline.log'];f.sign();
 await assert.rejects(run,/路由.*影响|影响.*路由/);
 f.handoff.schema_version=99;f.sign();
 await assert.rejects(run,/支持版本.*3.*4|未知.*版本/);
});
test('v4 无实现影响时三条路由均 N/A，且不生成消费者空合同',async t=>{
 const impacts={ui:false,api:false,data:false,backend:false,frontend:false,cross_repo:false,high_risk:false};
 const f=await setupV4(t,{impacts}),output=path.join(f.base,'package');
 await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output});
 assert(f.handoff.consumer_routes.every(route=>route.activation==='not-applicable'));
 const target=path.join(f.base,'target');mkdirSync(target);writeFileSync(path.join(target,'yss-project.yaml'),'schema_version: 1\nrepository_mode: project-instance\n');writeFileSync(path.join(target,'CONTEXT.md'),context);
 const imported=await importBundle({bundle:output,targetRoot:target});const receipt=read(path.join(target,imported.receipt_ref));
 assert(receipt.routes.every(route=>route.activation==='not-applicable'));
 const importedRoot=path.dirname(path.join(target,imported.receipt_ref));
 for(const name of ['backend-technical-traceability-draft.json','frontend-strategic-preflight-draft.json','frontend-traceability-draft.json','consumer-status-index-draft.json'])assert.equal(existsSync(path.join(importedRoot,name)),false,name);
});
test('消费者反馈按源摘要裁决，amend 与 blocking defer 保持阻断',async t=>{
 const {verifyConsumerFeedback,verifyFeedbackAdjudication}=await import('./lib/strategic-feedback.mjs');
 const f=await setupV4(t),output=path.join(f.base,'package');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output});
 const sourceRule=await openBundle(output,b=>b.indexes.rules[0]);
 const target=path.join(f.base,'target');mkdirSync(path.join(target,'docs/process'),{recursive:true});writeFileSync(path.join(target,'yss-project.yaml'),'schema_version: 1\nrepository_mode: project-instance\n');writeFileSync(path.join(target,'CONTEXT.md'),context);writeFileSync(path.join(target,'docs/process/harness-profile.yaml'),json({schema_version:2,profile_id:'harness.backend-delivery',handoff:{consumer_capabilities:['backend-technical-design']}}));
 const imported=await importBundle({bundle:output,targetRoot:target}),receipt=read(path.join(target,imported.receipt_ref));writeFileSync(path.join(target,'feedback-evidence.md'),'Synthetic consumer feedback evidence.');writeFileSync(path.join(target,'feedback-approval.md'),'Synthetic adjudication approval evidence.');
 const feedback={schema_version:1,feedback_id:'consumer-feedback.supplier-rule',status:'submitted',import_receipt_ref:imported.receipt_ref,bundle:{id:receipt.bundle_id,version:receipt.version,digest:receipt.bundle_digest},route_id:'route.backend',source:{id:sourceRule.rule_id,digest:sourceRule.source_digest},issue_type:'rule-conflict',severity:'blocking',suggestion:'补充材料有效期规则',raised_by:'role.backend-agent',evidence_refs:['feedback-evidence.md'],created_at:'2026-09-11T00:00:00Z'};
 writeFileSync(path.join(target,'feedback.json'),json(feedback));assert.equal((await verifyConsumerFeedback({root:target,feedbackRef:'feedback.json'})).result,'feedback-verified');
 const baseAdjudication={schema_version:1,adjudication_id:'feedback-adjudication.supplier-rule',status:'approved',feedback:{ref:'feedback.json',digest:hash(readFileSync(path.join(target,'feedback.json')))},decision:'keep',reason:'当前规则已覆盖该约束',owner:'role.product-manager',return_work_unit:'work-unit.business-boundary-and-rules-design',target_version:'v1',approval_ref:'feedback-approval.md',evidence_refs:['feedback-approval.md'],decided_at:'2026-09-11T01:00:00Z'};
 writeFileSync(path.join(target,'adjudication.json'),json(baseAdjudication));assert.equal((await verifyFeedbackAdjudication({root:target,adjudicationRef:'adjudication.json'})).may_continue,true);
 writeFileSync(path.join(target,'feedback.json'),json({...feedback,suggestion:'changed'}));await assert.rejects(()=>verifyFeedbackAdjudication({root:target,adjudicationRef:'adjudication.json'}),/digest 已失效/);writeFileSync(path.join(target,'feedback.json'),json(feedback));
 const amend={...baseAdjudication,decision:'amend',reason:'需要修改战略规则',target_version:'v2'};writeFileSync(path.join(target,'adjudication.json'),json(amend));assert.equal((await verifyFeedbackAdjudication({root:target,adjudicationRef:'adjudication.json'})).requires_new_handoff,true);
 const defer={...baseAdjudication,decision:'defer',reason:'下一版本处理',target_version:'v2',risk:'当前切片可能违反材料有效期',verification_plan:'新增场景回归并重发交接'};delete defer.approval_ref;writeFileSync(path.join(target,'adjudication.json'),json(defer));assert.equal((await verifyFeedbackAdjudication({root:target,adjudicationRef:'adjudication.json'})).result,'blocked');
});
test('规则遗漏、摘要漂移、批准不匹配和离线资源丢失阻断导出',async t=>{
 const f=await setup(t);const run=()=>exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:path.join(f.base,'out')});
 const text=readFileSync(path.join(f.source,'source/strategy.yaml'));f.put('source/strategy.yaml',{...f.strategy,traceability_version:undefined});
 await assert.rejects(run,/不一致|过期|migration/);writeFileSync(path.join(f.source,'source/strategy.yaml'),text);
 const approved=read(path.join(f.source,'approvals/spec_ref.yaml'));f.put('approvals/spec_ref.yaml',{...approved,artifact_bindings:[]});await assert.rejects(run,/批准记录未绑定/);f.put('approvals/spec_ref.yaml',approved);
 const roles=read(path.join(f.source,'docs/agents/digital-human-roles.yaml'));f.put('docs/agents/digital-human-roles.yaml',{...roles,user_decision_policy:{...roles.user_decision_policy,gates:['gate.domain-strategy-approved']}});await assert.rejects(run,/user-decision|升级/);f.put('docs/agents/digital-human-roles.yaml',roles);
 const sourceBytes=readFileSync(path.join(f.source,'prototype-src/main.js'));f.put('prototype-src/main.js','changed');await assert.rejects(run,/源码\/锁文件批准摘要/);writeFileSync(path.join(f.source,'prototype-src/main.js'),sourceBytes);
 const verification=read(path.join(f.source,'evidence/offline.json'));f.put('evidence/offline.json',{...verification,command:'changed'});await assert.rejects(run,/验证记录批准摘要/);f.put('evidence/offline.json',verification);
 f.put('preview/index.html','<img src="missing.png">');await assert.rejects(run,/过期/);
});
test('篡改 payload、重新封摘要后的虚构规则索引、额外文件均拒绝',async t=>{
 const f=await setup(t),output=path.join(f.base,'package');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output});
 const spec=path.join(output,'payload/files/source/spec.md'),bytes=readFileSync(spec);writeFileSync(spec,'tampered');await assert.rejects(()=>openBundle(output,()=>null),/摘要/);writeFileSync(spec,bytes);
 writeFileSync(path.join(output,'extra.txt'),'extra');await assert.rejects(()=>openBundle(output,()=>null),/未登记/);rmSync(path.join(output,'extra.txt'));
 const manifest=read(path.join(output,'manifest.json'));const idx=Buffer.from(json([]));writeFileSync(path.join(output,'indexes/rules.json'),idx);const row=manifest.files.find(x=>x.path==='indexes/rules.json');row.sha256=hash(idx);row.size_bytes=idx.length;delete manifest.bundle_digest;manifest.bundle_digest=digest(manifest);writeFileSync(path.join(output,'manifest.json'),json(manifest));await assert.rejects(()=>openBundle(output,()=>null),/索引与源/);
});
test('ZIP 路径穿越和重复条目拒绝',async t=>{
 const f=await setup(t);
 for(const names of [['../escape'],['manifest.json','manifest.json']]){
  const zip=path.join(f.base,'bad.zip');rmSync(zip,{force:true});const py='import zipfile,json,sys; z=zipfile.ZipFile(sys.argv[1],"w"); [z.writestr(n,"x") for n in json.loads(sys.argv[2])]; z.close()';assert.equal(spawnSync('python3',['-c',py,zip,JSON.stringify(names)]).status,0);await assert.rejects(()=>openBundle(zip,()=>null),/ZIP/);
 }
});
test('版本差异绑定前版，重复版本不允许；修改规则产生更新集合',async t=>{
 const f=await setup(t),first=path.join(f.base,'v1');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:first});
 await assert.rejects(()=>exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:path.join(f.base,'bad'),previous:first}),/提升/);
 advanceStrategy(f);
 const second=path.join(f.base,'v2');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:second,previous:first});assert.deepEqual(await openBundle(second,b=>b.changes.updated),['rule.complete','scenario.submit']);
});

test('受控延期只阻断依赖切片；未知依赖扩大阻断；目标未对账禁止消费',async t=>{
 const {verifyConsumption}=await import('./lib/strategic-handoff-consumption.mjs');
 const f=await setup(t),output=path.join(f.base,'package');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output});
 const target=path.join(f.base,'target');mkdirSync(target);writeFileSync(path.join(target,'yss-project.yaml'),'schema_version: 1\nrepository_mode: project-instance\n');writeFileSync(path.join(target,'CONTEXT.md'),context);
 const result=await importBundle({bundle:output,targetRoot:target});
 const draft=read(path.join(target,result.traceability_ref));
 const tactical={status:'approved',strategic_handoff:{...draft,context_reconciliation_ref:'reconciliation.yaml'},behavior_catalog:[{behavior_id:'behavior.submit'}],test_seams:[{seam_id:'test-seam.submit',subject_ref:'behavior.submit'}]};
 const record={schema_version:1,repository_mode:'project-instance',stage:'stage.system-data-engineering',work_unit:'work-unit.technical-analysis',status:'reconciled',context_snapshot:f.snapshot,changes:{added:['Global/Supplier'],updated:[],deprecated:[]},unresolved_terms:[],evidence_refs:['CONTEXT.md']};
 writeFileSync(path.join(target,'reconciliation.yaml'),json(record));
 for(const row of tactical.strategic_handoff.rows)Object.assign(row,{disposition:'implemented',tactical_refs:['behavior.submit'],test_seam_refs:['test-seam.submit'],scenario_tests:[{outcome:'success',seam_ref:'test-seam.submit'},{outcome:'failure',seam_ref:'test-seam.submit'}],evidence_refs:['CONTEXT.md'],dependency_status:'known',dependent_slice_refs:['slice.submit']});
 assert.equal((await verifyConsumption(tactical,{root:target})).result,'verified');
 const mvc={schema_version:2,status:'approved',architecture:{family:'layered-mvc'},strategic_handoff:structuredClone(tactical.strategic_handoff),design:{use_case_catalog:[{use_case_id:'use-case.submit'}],test_seams:[{seam_id:'test-seam.submit',subject_ref:'use-case.submit'}]}};
 for(const row of mvc.strategic_handoff.rows)row.tactical_refs=['use-case.submit'];
 assert.equal((await verifyConsumption(mvc,{root:target})).result,'verified');
 mvc.strategic_handoff.rows[0].tactical_refs=['aggregate.fake'];
 await assert.rejects(()=>verifyConsumption(mvc,{root:target}),/落点悬空/);

 const row=tactical.strategic_handoff.rows[0];Object.assign(row,{disposition:'deferred',reason:'分批实现',risk:'不能提交',owner:'需求负责人',followup_ticket_ref:'ticket.followup',verification_plan:'提交测试',target_version:'v2'});
 assert.equal((await verifyConsumption(tactical,{root:target,sliceRef:'slice.submit'})).result,'blocked');
 assert.equal((await verifyConsumption(tactical,{root:target,sliceRef:'slice.other'})).result,'verified');
 row.dependency_status='unknown';assert.equal((await verifyConsumption(tactical,{root:target,sliceRef:'slice.other'})).result,'blocked');
 row.dependency_status='known';row.disposition='implemented';advanceStrategy(f);const second=path.join(f.base,'v2');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:second,previous:output});await importBundle({bundle:second,targetRoot:target});
 const stale=await verifyConsumption(tactical,{root:target,sliceRef:'slice.submit'});assert.equal(stale.result,'blocked');assert(stale.issues.some(x=>x.reason==='stale-source'));assert.equal((await verifyConsumption(tactical,{root:target,sliceRef:'slice.other'})).result,'verified');
 f.strategy.contexts[0].responsibilities.push('新增责任边界');advanceStrategy(f,'v3');const third=path.join(f.base,'v3');await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:third,previous:second});await importBundle({bundle:third,targetRoot:target});const changedBoundary=await verifyConsumption(tactical,{root:target,sliceRef:'slice.other'});assert.equal(changedBoundary.block_all,true);assert(changedBoundary.issues.some(x=>x.reason==='upstream-design-stale'));
 writeFileSync(path.join(target,'reconciliation.yaml'),json({...record,status:'blocked',unresolved_terms:[{term:'Supplier',reason:'冲突',owner:'需求负责人',next_action:'回交战略方'}]}));
 await assert.rejects(()=>verifyConsumption(tactical,{root:target}),/对账未通过/);
});

test('源规则必须稳定可追溯，关键场景不能遗漏结果',async t=>{
 const {extractTraceability}=await import('./lib/strategic-handoff-rules.mjs');const f=await setup(t);
 for(const mutate of [s=>delete s.traceability_version,s=>s.scenarios[0].rule_refs=['rule.missing'],s=>delete s.scenarios[0].success_results,s=>s.invariants[0].rule_ref='rule.missing',s=>s.rule_catalog.push({...s.rule_catalog[0]})]){const s=structuredClone(f.strategy);mutate(s);assert.throws(()=>extractTraceability(s));}
});
test('统一 CLI 在源目录消失后通过 ZIP 验包',async t=>{
 const f=await setup(t),output=path.join(f.base,'cli');
 const cli=path.join(import.meta.dirname,'strategic-handoff');
 const exported=spawnSync(process.execPath,[cli,'export','--source-root',f.source,'--handoff','handoff.yaml','--output',output,'--zip'],{encoding:'utf8'});assert.equal(exported.status,0,exported.stderr);
 rmSync(f.source,{recursive:true});const checked=spawnSync(process.execPath,[cli,'verify','--bundle',`${output}.zip`],{encoding:'utf8'});assert.equal(checked.status,0,checked.stderr);assert.equal(JSON.parse(checked.stdout).result,'verified');
});

test('当前决定与交接复用可离线验证；范围缺失、回复丢失和未知能力拒绝',async t=>{
 const f=await setup(t);
 const {buildDecisionFixture}=await import('./fixtures/user-decision/build-fixture.mjs');
 const roles=read(path.join(f.source,'docs/agents/digital-human-roles.yaml'));
 roles.gate_policy.dual_digital_human.push({gate:'gate.strategic-design-handoff-approved',drafter:'role.product-manager',countersigners:['role.requirements-manager']});
 for(const key of ['business_ticket_set_ref','handoff']) {
   const approval=f.handoff.package_export.approvals[key];approval.gate_id='gate.strategic-design-handoff-approved';
   const record=read(path.join(f.source,approval.record_ref));f.put(approval.record_ref,{...record,gate_id:approval.gate_id,role_id:'role.requirements-manager'});
 }
 f.put('handoff.yaml',f.handoff);
 const handoffApproval=read(path.join(f.source,'approvals/handoff.yaml'));handoffApproval.artifact_bindings[0].digest=hash(readFileSync(path.join(f.source,'handoff.yaml')));f.put('approvals/handoff.yaml',handoffApproval);
 roles.user_decision_policy={schema_version:1,source_kinds:['session-export'],gates:['gate.spec-baseline-approved','gate.user-confirmation','gate.strategic-design-handoff-approved'],work_units:{},required_capabilities:['strategic-decision-reuse-v1']};
 f.put('docs/agents/digital-human-roles.yaml',roles);
 const scope=['feature.supplier'];
 const decide=(key,ref,boundary)=>{
   const directory=path.join(f.source,'decisions',key);
   const d=buildDecisionFixture(directory,{subjectRef:path.join(f.source,ref),boundary,scope});
   const relative=ref=>path.relative(f.source,ref).split(path.sep).join('/');
   d.record.request.items[0].subject.ref=ref;
   d.record.request.requester_source.ref=relative(d.record.request.requester_source.ref);
   d.present();
   d.record.responses=[];d.respond();d.record.request.presented_source.ref=relative(d.record.request.presented_source.ref);d.record.responses[0].source.ref=relative(d.record.responses[0].source.ref);
   d.save();
   return {boundary,subject_ref:ref,scope,user_decision_ref:relative(d.ref)};
 };
 const requirements=[];const assets=[];
 for(const [key,ref]of Object.entries(f.handoff.source)) {
   const file=key==='visual_baseline_ref'?`${ref.persisted_ref}/${ref.manifest_ref}`:ref.persisted_ref;
   const approval=read(path.join(f.source,f.handoff.package_export.approvals[key].record_ref));
   const boundary=key==='business_ticket_set_ref'?'gate.spec-baseline-approved':approval.gate_id;
   const requirement=decide(key,file,boundary);requirements.push(requirement);
   assets.push({ref:file,version:ref.version,digest:hash(readFileSync(path.join(f.source,file))),boundary,scope});
   f.put(f.handoff.package_export.approvals[key].record_ref,{...approval,subject_ref:file,approval_scope:scope,user_decision_ref:requirement.user_decision_ref});
 }
 const {package_export,status,...delivery}=f.handoff;
 f.put('delivery.json',delivery);
 const deliveryDecision=decide('delivery','delivery.json','gate.spec-baseline-approved');requirements.push(deliveryDecision);
 assets.push({ref:'delivery.json',version:'v1',digest:hash(readFileSync(path.join(f.source,'delivery.json'))),boundary:deliveryDecision.boundary,scope});
 f.put('delivery-scope.json',{schema_version:1,kind:'strategic-delivery-scope',delivery_ref:'delivery.json',assets,risks:[],conditions:[]});
 f.put('reuse.json',{schema_version:1,kind:'strategic-decision-reuse-v1',target_gate:'gate.strategic-design-handoff-approved',scope_ref:'delivery-scope.json',scope,requirements});
 const ticketsApproval=read(path.join(f.source,'approvals/business_ticket_set_ref.yaml'));
 f.put('approvals/business_ticket_set_ref.yaml',{...ticketsApproval,subject_ref:'delivery-scope.json',approval_scope:scope,user_decision_ref:undefined,decision_reuse_ref:'reuse.json'});
 const terminal=read(path.join(f.source,'approvals/handoff.yaml'));
 f.put('approvals/handoff.yaml',{...terminal,subject_ref:'delivery-scope.json',approval_scope:scope,decision_reuse_ref:'reuse.json'});
 const output=path.join(f.base,'current-package');
 await exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output});
 const saved=read(path.join(f.source,'delivery-scope.json'));f.put('delivery-scope.json',{...saved,assets:assets.slice(1)});
 await assert.rejects(()=>exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:path.join(f.base,'bad')}),/遗漏当前资产/);
 f.put('delivery-scope.json',saved);
 f.put('docs/agents/digital-human-roles.yaml',{...roles,user_decision_policy:{...roles.user_decision_policy,required_capabilities:['unsupported-v2']}});
 await assert.rejects(()=>exportBundle({sourceRoot:f.source,handoffRef:'handoff.yaml',output:path.join(f.base,'bad')}),/不支持/);
 rmSync(f.source,{recursive:true});
 await openBundle(output,()=>null);
 const response=path.join(output,'payload/files/decisions/spec_ref/reply-0.json');rmSync(response);
 await assert.rejects(()=>openBundle(output,()=>null),/缺失|ENOENT/);
});
