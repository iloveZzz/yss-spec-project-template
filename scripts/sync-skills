#!/usr/bin/env node
import { syncSkills } from "./lib/skill-supply-chain.mjs";

try {
  const args = process.argv.slice(2);
  if (args.some(arg => arg !== "--check")) throw new TypeError("仅支持 --check");
  process.stdout.write(`${syncSkills({ check: args.includes("--check") })}\n`);
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
}
