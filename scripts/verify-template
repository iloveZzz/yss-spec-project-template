#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
node -e 'const [major]=process.versions.node.split(".").map(Number); if (major < 22 || major >= 27) { console.error("模板工具需要 Node >=22 <27"); process.exit(1); }'

required_files=(yss-project.yaml AGENTS.md CONTEXT.md skills-lock.json docs/process/lifecycle-registry.yaml docs/process/lifecycle-registry-baseline.json scripts/repository-mode scripts/implementation-path-policy scripts/sync-skills scripts/update-skill-lock scripts/generate-lifecycle-artifacts scripts/verify-lifecycle-registry scripts/export-yss-skills)
for required in "${required_files[@]}"; do test -f "$required" || { echo "缺少模板必需文件: $required" >&2; exit 1; }; done

repository_mode="$(scripts/repository-mode)"
if [[ "$repository_mode" == "template-source" ]]; then
  test -x .template-source/scripts/evidence-index
  .template-source/scripts/evidence-index --check
  pnpm --dir .template-source/tooling/node test
  pnpm --dir .template-source/tooling/node check:vendor
fi

scripts/sync-skills --check
scripts/update-skill-lock --check
scripts/verify-lifecycle-registry
scripts/verify-lifecycle-scenarios
scripts/verify-governance-release
scripts/verify-implementation-path-scenarios
scripts/verify-scaffold-generator-scenarios
scripts/verify-prototype-backend-scaffold-scenarios
scripts/verify-matt-yss-integration-scenarios
scripts/verify-yss-router-scenarios
scripts/verify-yss-ui-scenarios
scripts/verify-openapi-yaml-first-scenarios
scripts/verify-openapi-json-handoff-scenarios

for entry in scripts/sync-skills scripts/update-skill-lock scripts/generate-lifecycle-artifacts scripts/verify-lifecycle-registry scripts/verify-lifecycle-scenarios scripts/verify-matt-yss-integration-scenarios scripts/verify-prototype-backend-scaffold-scenarios scripts/verify-yss-router-scenarios scripts/verify-openapi-yaml-first-scenarios scripts/verify-openapi-json-handoff-scenarios scripts/export-yss-skills; do node --check "$entry"; done

legacy_runtime="ru""by"
if rg -n "^#!.*${legacy_runtime}|\\b${legacy_runtime}\\b" scripts .template-source/scripts --glob '!*.md'; then echo "模板脚本不得保留活跃 Ruby 调用或 shebang" >&2; exit 1; fi
if rg --files scripts .template-source/scripts | rg '\.rb$'; then echo "模板脚本不得保留 .rb 路径" >&2; exit 1; fi
git diff --check
echo "模板发布校验通过"
