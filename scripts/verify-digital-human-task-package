#!/usr/bin/env node
// 薄壳：校验语义归 yss（contract verify --kind task），这里只翻译参数、透传结论与退出码。
import path from "node:path";
import { parseArgs } from "node:util";
import { nativeContractVerify, assertNativeCapabilities, NEEDS } from "./lib/native-evidence.mjs";

try {
  const { positionals, values } = parseArgs({ options: { help:{type:"boolean"}, "run-dir": { type: "string" } }, allowPositionals: true, strict: true });
  if(values.help)process.stdout.write("用法: scripts/verify-digital-human-task-package <任务包.yaml> [--run-dir <结果目录>]\n0=当前任务包检查通过，1=失败；不派发或重复执行任务。校验由 yss contract verify --kind task 执行。\n");
  else {
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-digital-human-task-package <task-package.yaml|task-package.json>");
  const root = path.resolve(import.meta.dirname, "..");
  assertNativeCapabilities(NEEDS.task);
  const result = nativeContractVerify({ root, kind: "task", file: path.resolve(positionals[0]), extra: values["run-dir"] ? ["--run-dir", path.resolve(values["run-dir"])] : [] });
  if (result.exitCode !== 0) { process.stderr.write(`数字人任务包验证失败: ${result.message}\n`); process.exitCode = result.exitCode; }
  else process.stdout.write("数字人任务包验证通过\n");
  }
} catch (error) {
  process.stderr.write(`数字人任务包验证失败: ${error.message}\n`);
  process.exitCode = 1;
}
