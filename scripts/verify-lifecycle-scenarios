#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"
require "set"
require "yaml"

ROOT = Pathname.new(__dir__).join("..").realpath
REGISTRY = YAML.safe_load(
  ROOT.join("docs/process/lifecycle-registry.yaml").read,
  permitted_classes: [],
  aliases: false
)
REGISTRY_IDS = %w[stages gates artifacts work_units evidence].flat_map do |collection|
  REGISTRY.fetch(collection).map { |record| record.fetch("id") }
end.to_set
ROUTE_REGISTRY_IDS = {
  "impact-assessment" => "artifact.impact-assessment",
  "ssot-update" => "work-unit.ssot-update",
  "skill-projection-sync" => "work-unit.skill-projection-sync",
  "pressure-scenarios" => "evidence.fresh-verification",
  "fresh-verification" => "work-unit.fresh-verification",
  "independent-review" => "work-unit.independent-review",
  "tracker-sync" => "evidence.checkpoint-and-rollback",
  "spec" => "artifact.spec",
  "product-overview" => "artifact.product-overview",
  "functional-architecture" => "artifact.functional-architecture",
  "interaction-spec" => "artifact.interaction-spec",
  "low-fidelity-prototype" => "artifact.low-fidelity-prototype",
  "state-matrix" => "artifact.state-matrix",
  "prototype-review" => "gate.prototype-reviewed",
  "high-fidelity-html-prototype" => "artifact.high-fidelity-html-prototype",
  "prototype-verification" => "gate.prototype-verified",
  "user-confirmation" => "gate.user-confirmation",
  "openapi-draft" => "artifact.openapi-draft",
  "draft-review" => "gate.openapi-draft-reviewed",
  "design-review" => "gate.design-reviewed",
  "openapi-freeze" => "gate.openapi-frozen",
  "engineering-baseline" => "artifact.engineering-baseline",
  "architecture-review" => "artifact.architecture-review",
  "data-architecture" => "artifact.data-architecture",
  "spec-delta" => "artifact.spec-delta",
  "parent-ticket" => "artifact.parent-ticket",
  "vertical-slice-tickets" => "artifact.vertical-slice-ticket"
}.freeze

def route(facts)
  if facts.fetch(:repository_mode) == "template-source"
    return %w[
      impact-assessment
      ssot-update
      skill-projection-sync
      pressure-scenarios
      fresh-verification
      independent-review
    ]
  end

  gates = %w[impact-assessment tracker-sync fresh-verification]
  small_change = facts.fetch(:scale) == :small && !facts.fetch(:high_risk) &&
                 !facts.fetch(:ui_impact) && !facts.fetch(:api_impact) &&
                 !facts.fetch(:backend_impact) && !facts.fetch(:data_impact)
  return gates if small_change

  gates.concat(%w[spec product-overview functional-architecture])

  if facts.fetch(:ui_impact)
    gates.concat(%w[
      interaction-spec
      low-fidelity-prototype
      state-matrix
      prototype-review
      high-fidelity-html-prototype
      prototype-verification
      user-confirmation
    ])
  end

  gates.concat(%w[openapi-draft draft-review design-review openapi-freeze]) if facts.fetch(:api_impact)

  if facts.fetch(:backend_impact) || facts.fetch(:high_risk)
    gates.concat(%w[engineering-baseline architecture-review])
  end

  gates << "data-architecture" if facts.fetch(:data_impact)
  gates << "spec-delta" if facts.fetch(:existing_frozen_baseline) && facts.fetch(:high_risk)
  gates.concat(%w[parent-ticket vertical-slice-tickets])
  gates.uniq
end

scenarios = [
  {
    name: "小文案调整",
    facts: {
      repository_mode: "project-instance", scale: :small, high_risk: false,
      ui_impact: false, api_impact: false, backend_impact: false,
      data_impact: false, existing_frozen_baseline: true
    },
    required: %w[impact-assessment tracker-sync fresh-verification],
    forbidden: %w[spec product-overview spec-delta interaction-spec high-fidelity-html-prototype prototype-review prototype-verification]
  },
  {
    name: "纯后端新功能",
    facts: {
      repository_mode: "project-instance", scale: :new_module, high_risk: false,
      ui_impact: false, api_impact: true, backend_impact: true,
      data_impact: false, existing_frozen_baseline: false
    },
    required: %w[spec product-overview functional-architecture openapi-draft engineering-baseline parent-ticket vertical-slice-tickets],
    forbidden: %w[interaction-spec low-fidelity-prototype state-matrix prototype-review high-fidelity-html-prototype prototype-verification user-confirmation spec-delta]
  },
  {
    name: "普通 API 功能无需专项输入",
    facts: {
      repository_mode: "project-instance", scale: :small, high_risk: false,
      ui_impact: false, api_impact: true, backend_impact: true,
      data_impact: false, existing_frozen_baseline: false
    },
    required: %w[spec product-overview functional-architecture openapi-draft draft-review openapi-freeze engineering-baseline parent-ticket vertical-slice-tickets],
    forbidden: %w[interaction-spec low-fidelity-prototype state-matrix prototype-review high-fidelity-html-prototype prototype-verification user-confirmation spec-delta]
  },
  {
    name: "有 UI 的新功能",
    facts: {
      repository_mode: "project-instance", scale: :new_module, high_risk: false,
      ui_impact: true, api_impact: true, backend_impact: true,
      data_impact: false, existing_frozen_baseline: false
    },
    required: %w[spec product-overview interaction-spec low-fidelity-prototype state-matrix prototype-review high-fidelity-html-prototype prototype-verification user-confirmation openapi-freeze vertical-slice-tickets],
    forbidden: %w[spec-delta]
  },
  {
    name: "既有冻结基线的高风险变更",
    facts: {
      repository_mode: "project-instance", scale: :medium, high_risk: true,
      ui_impact: false, api_impact: true, backend_impact: true,
      data_impact: true, existing_frozen_baseline: true
    },
    required: %w[spec product-overview spec-delta openapi-draft data-architecture architecture-review vertical-slice-tickets],
    forbidden: %w[interaction-spec prototype-review high-fidelity-html-prototype prototype-verification]
  },
  {
    name: "模板源流程修订",
    facts: {
      repository_mode: "template-source", scale: :process, high_risk: true,
      ui_impact: false, api_impact: false, backend_impact: false,
      data_impact: false, existing_frozen_baseline: false
    },
    required: %w[impact-assessment ssot-update skill-projection-sync pressure-scenarios fresh-verification independent-review],
    forbidden: %w[spec product-overview openapi-draft spec-delta vertical-slice-tickets]
  }
].freeze

failures = []

scenarios.each do |scenario|
  result = route(scenario.fetch(:facts))
  missing = scenario.fetch(:required) - result
  unexpected = scenario.fetch(:forbidden) & result
  failures << "#{scenario.fetch(:name)} 缺少门禁: #{missing.join(', ')}" unless missing.empty?
  failures << "#{scenario.fetch(:name)} 错误触发: #{unexpected.join(', ')}" unless unexpected.empty?
end

route_keys = scenarios.flat_map { |scenario| scenario.fetch(:required) + scenario.fetch(:forbidden) }.uniq
route_keys.each do |route_key|
  registry_id = ROUTE_REGISTRY_IDS[route_key]
  failures << "生命周期场景 route key 未映射稳定 ID: #{route_key}" unless registry_id
  failures << "生命周期场景 route key 映射到不存在的稳定 ID: #{route_key} -> #{registry_id}" if registry_id && !REGISTRY_IDS.include?(registry_id)
end

prototype_registry_requirements = {
  "gate.prototype-reviewed" => ["evidence.prototype-review-result"],
  "gate.prototype-verified" => ["evidence.antd-cli-validation", "evidence.browser-prototype-verification"],
  "gate.user-confirmation" => ["evidence.prototype-confirmation"]
}.freeze
prototype_registry_requirements.each do |gate_id, required_evidence|
  gate = REGISTRY.fetch("gates").find { |record| record.fetch("id") == gate_id }
  failures << "原型阶段缺少生命周期门禁: #{gate_id}" unless gate
  next unless gate

  missing_evidence = required_evidence - gate.fetch("evidence", [])
  failures << "#{gate_id} 缺少证据: #{missing_evidence.join(', ')}" unless missing_evidence.empty?
end

%w[
  artifact.interaction-spec
  artifact.prototype-review
  artifact.prototype-confirmation
  evidence.prototype-review-result
  evidence.antd-cli-validation
  evidence.browser-prototype-verification
  evidence.prototype-confirmation
].each do |stable_id|
  failures << "原型阶段缺少生命周期对象: #{stable_id}" unless REGISTRY_IDS.include?(stable_id)
end

semantic_markers = {
  "AGENTS.md" => [
    "生命周期注册表中的条件门禁全部按影响面强制",
    "只要进入 Spec 基线",
    "才构成产品设计影响",
    "Spec Delta 只记录相对既有冻结 Spec 基线",
    "安全 / 权限不设独立生命周期资料或专属门禁",
    "普通 action 注册",
    "SQL / DDL / 迁移和上传 / 下载本身不构成安全 / 权限专项",
    "template-source",
    "apps/backend/<project>/",
    "apps/frontend/<project>/",
    "app/backend/",
    "app/frontend/",
    "集中同步",
    "集中记录不得丢失各阶段因果关系"
  ],
  "docs/process/harness-process-tailoring.md" => [
    "全新产品 / 模块",
    "不生成空文档",
    "最近可信阶段",
    "同一独立执行者",
    "集中 checkpoint",
    "安全 / 权限不单独分诊",
    "不自动升级为安全专项"
  ],
  "docs/process/lifecycle-artifact-map.md" => [
    "安全 / 权限不形成独立门禁",
    "按实际 UI、API、Backend、Data、High-risk 影响"
  ],
  ".agents/skills/yss-product-lifecycle/references/artifact-dependencies.md" => [
    "不使用独立影响类型",
    "不增加安全 / 权限传播"
  ],
  "docs/process/implementation-repo-integration.md" => [
    "apps/backend/<project>/",
    "apps/frontend/<project>/",
    "app/backend/",
    "app/frontend/",
    "项目容器"
  ],
  ".agents/skills/yss-product-lifecycle/SKILL.md" => [
    "apps/backend/<project>/",
    "apps/frontend/<project>/",
    "app/backend/",
    "app/frontend/",
    "项目路径策略"
  ]
}.freeze

obsolete_checkpoint_rules = {
  "AGENTS.md" => ["每个阶段结束时执行 Git checkpoint 判断"],
  "docs/process/harness-executive-blueprint.md" => ["每个阶段结束必须记录 Ticket 同步状态"],
  "docs/process/harness-optimization-backlog.md" => ["每个阶段都能按固定字段记录"],
  "docs/user-guide/生命周期最佳实践.md" => ["阶段结束做 Ticket 同步和 Git checkpoint"],
  "docs/user-guide/产品生命周期工作流.md" => ["每个阶段结束、垂直切片创建"]
}.freeze

obsolete_checkpoint_rules.each do |relative_path, markers|
  body = ROOT.join(relative_path).read
  markers.each do |marker|
    failures << "#{relative_path} 仍保留逐阶段 checkpoint 规则: #{marker}" if body.include?(marker)
  end
end

semantic_markers.each do |relative_path, markers|
  body = ROOT.join(relative_path).read
  markers.each do |marker|
    failures << "#{relative_path} 缺少语义标记: #{marker}" unless body.include?(marker)
  end
end

unless failures.empty?
  warn failures.join("\n")
  exit 1
end

puts "六类生命周期压力场景验证通过"

skill_root = ROOT.join(".agents/skills/yss-product-lifecycle")
skill = skill_root.join("SKILL.md").read
required_skill_markers = [
  "`route`",
  "`orchestrate`",
  "`resume`",
  "`audit`",
  "有界推进",
  "不得绕过专项 skill",
  "ready-for-agent",
  "stale",
  "阶段边界",
  "`to-questionnaire`",
  "`wait-what`",
  "`wizard`",
  "直接入口",
  "readiness"
]
required_skill_markers.each do |marker|
  failures << "yss-product-lifecycle 缺少编排语义: #{marker}" unless skill.include?(marker)
end

