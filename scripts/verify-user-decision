#!/usr/bin/env node
// 薄壳：校验语义归 yss（evidence verify --kind user-decision），这里只翻译参数、透传结论与退出码。
import path from "node:path";
import { parseArgs } from "node:util";
import { decisionIO } from "./lib/user-decision-core.mjs";
import { nativeEvidenceVerify, assertNativeCapabilities, NEEDS } from "./lib/native-evidence.mjs";
const fail = (message, code = 1) => { process.stderr.write(`用户决定校验失败: ${message}\n`); process.exitCode = code; };
try {
  const { positionals, values } = parseArgs({ allowPositionals: true, options: { root: { type: "string" }, requirements: { type: "string" }, continuation: { type: "boolean" } } });
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-user-decision [--root <repo>] [--requirements <当前事项.json>] <record.yaml>");
  const root = path.resolve(values.root ?? path.join(import.meta.dirname, ".."));
  const inside = (ref) => { const abs = path.resolve(root, ref); const rel = path.relative(root, abs); return rel && !rel.startsWith("..") && !path.isAbsolute(rel) ? rel : abs; };
  let file = positionals[0];
  const extra = [];
  if (values.continuation) {
    // 延续模式下位置参数是当前事项本身，待验的延续证明是它的 continuation_ref。
    file = decisionIO({ root }).document(positionals[0]).continuation_ref;
    if (typeof file !== "string" || !file) throw new TypeError("当前事项缺少 continuation_ref");
    extra.push("--continuation", "--requirements", inside(positionals[0]));
  } else if (values.requirements) extra.push("--requirements", inside(values.requirements));
  else extra.push("--from-record");
  assertNativeCapabilities(NEEDS.userDecision);
  const result = nativeEvidenceVerify({ root, kind: "user-decision", file: inside(file), extra });
  if (result.exitCode === 0) process.stdout.write(values.continuation ? "已有授权与当前延续范围校验通过\n" : "用户决定及当前批准范围校验通过\n");
  else fail(result.message, result.exitCode);
} catch (error) {
  fail(error.message);
}
