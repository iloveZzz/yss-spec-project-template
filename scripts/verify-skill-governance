#!/usr/bin/env node
import { validateSkillGovernance } from "./lib/skill-governance.mjs";

try {
  const result = validateSkillGovernance();
  process.stdout.write(`技能规范冲突扫描通过（${result.legacy_aliases} 个兼容 alias，${result.retired_frontend_skills} 个已退役前端 skills 未回流）\n`);
} catch (error) {
  process.stderr.write(`技能规范冲突扫描失败: ${error.message}\n`);
  process.exitCode = 1;
}
