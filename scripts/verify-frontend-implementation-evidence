#!/usr/bin/env node
import { existsSync, readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { parseArgs } from "node:util";
import { fileURLToPath } from "node:url";
import { parseDocument } from "./vendor/yaml.mjs";
import { validateVisualBaseline } from "../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs";

const repoRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const schemaPath = path.join(repoRoot, "docs/process/schemas/frontend-implementation-evidence.schema.json");
const validator = String.raw`
import json
import sys
from jsonschema import Draft202012Validator
schema = json.load(open(sys.argv[1], encoding="utf-8"))
value = json.load(sys.stdin)
errors = sorted(Draft202012Validator(schema).iter_errors(value), key=lambda error: list(error.absolute_path))
for error in errors:
    location = ".".join(str(part) for part in error.absolute_path) or "<root>"
    print(f"{location}: {error.message}", file=sys.stderr)
sys.exit(1 if errors else 0)
`;

try {
  const { values, positionals } = parseArgs({ options: { "allow-template": { type: "boolean" }, root: { type: "string", default: repoRoot } }, allowPositionals: true, strict: true });
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-frontend-implementation-evidence [--allow-template] [--root <repo>] <file.yaml>");
  const root = path.resolve(values.root);
  const document = parseDocument(readFileSync(path.resolve(positionals[0]), "utf8"), { maxAliasCount: 0, uniqueKeys: true });
  if (document.errors.length) throw new TypeError(document.errors[0].message);
  const value = document.toJS({ maxAliasCount: 0 });
  if (value.schema_version === 1 && !values["allow-template"]) throw new TypeError("migration-required: frontend implementation evidence v1 是只读历史资产；在途 UI 工作必须升级 v2 并绑定 Visual Baseline case_id");
  const result = spawnSync("python3", ["-c", validator, schemaPath], { cwd: repoRoot, encoding: "utf8", input: JSON.stringify(value) });
  if (result.status !== 0) throw new TypeError(`${result.stdout}${result.stderr}`.trim());
  if (!values["allow-template"] && value.template !== false) throw new TypeError("正式证据必须设置 template: false");
  if (!values["allow-template"] && value.status !== "approved") throw new TypeError("正式证据必须达到 status: approved");
  const serialized = JSON.stringify(value);
  if (!values["allow-template"] && /REPLACE_ME|<[^>]+>|docs\/\.scratch\/example/.test(serialized)) throw new TypeError("正式证据不得保留模板占位值");
  if (!values["allow-template"]) {
    for (const field of ["prototype_ref", "spec_ref", "visual_baseline.manifest_ref"]) {
      const reference = field === "visual_baseline.manifest_ref" ? value.visual_baseline.manifest_ref : value[field];
      if (!/^https?:\/\//.test(reference) && !existsSync(path.resolve(root, reference))) throw new TypeError(`${field} 不可读取: ${reference}`);
    }
    const baselineDocument = parseDocument(readFileSync(path.resolve(root, value.visual_baseline.manifest_ref), "utf8"), { maxAliasCount: 0, uniqueKeys: true });
    if (baselineDocument.errors.length) throw new TypeError(baselineDocument.errors[0].message);
    const baseline = baselineDocument.toJS({ maxAliasCount: 0 });
    const baselineValidation = await validateVisualBaseline(baseline, { bundleRoot: path.dirname(path.resolve(root, value.visual_baseline.manifest_ref)) });
    if (baselineValidation.errors.length) throw new TypeError(`Visual Baseline Bundle 无效:\n${baselineValidation.errors.join("\n")}`);
    if (baseline.baseline_id !== value.visual_baseline.baseline_id || baseline.version !== value.visual_baseline.version || baseline.bundle?.digest !== value.visual_baseline.digest || baseline.status !== "approved") throw new TypeError("Visual Baseline 身份、版本、digest 或状态不一致");
    const manifestCaseIds = new Set((baseline.cases ?? []).map((item) => item.case_id));
    const selectedCaseIds = value.visual_baseline.case_ids;
    if (selectedCaseIds.some((id) => !manifestCaseIds.has(id))) throw new TypeError("前端证据引用了 Visual Baseline 中不存在的 case_id");
    for (const item of value.route_and_page_inventory) if (item.case_ids.some((id) => !selectedCaseIds.includes(id))) throw new TypeError("route_and_page_inventory.case_ids 必须属于选定 Visual Baseline cases");
    if (value.kind === "plan" && value.baseline_case_ids.some((id) => !selectedCaseIds.includes(id))) throw new TypeError("baseline_case_ids 必须属于选定 Visual Baseline cases");
  }
  if (!values["allow-template"] && value.kind === "verification") {
    if (value.console_warning_check !== "pass") throw new TypeError("前端验证必须通过 console warning 检查");
    if (value.uncovered_differences.length > 0) throw new TypeError("存在未解释视觉差异，不能通过前端实现还原验证");
    if (value.independent_review?.status !== "approved") throw new TypeError("前端验证必须通过独立 UI fidelity review");
    const expected = [...value.visual_baseline.case_ids].sort();
    const actual = value.case_results.map((item) => item.case_id).sort();
    if (new Set(actual).size !== actual.length || JSON.stringify(actual) !== JSON.stringify(expected)) throw new TypeError("case_results 必须与选定 Visual Baseline case_ids 一一对应");
    for (const item of value.case_results) {
      if (item.result !== "pass" || item.uncovered_difference !== false) throw new TypeError(`${item.case_id} 存在未通过或未解释差异`);
      for (const field of ["baseline_image_ref", "implementation_image_ref", "diff_ref"]) if (!existsSync(path.resolve(root, item[field]))) throw new TypeError(`${item.case_id}.${field} 不可读取`);
      if (item.mask_ref !== "not-applicable" && !existsSync(path.resolve(root, item.mask_ref))) throw new TypeError(`${item.case_id}.mask_ref 不可读取`);
    }
    if (value.actual_verification.some((item) => item.exit_code !== 0)) throw new TypeError("pnpm fresh verification 存在非零退出码");
  }
  process.stdout.write(`前端实现还原 ${value.kind} 验证通过\n`);
} catch (error) {
  process.stderr.write(`前端实现还原证据验证失败: ${error.message}\n`);
  process.exitCode = 1;
}
