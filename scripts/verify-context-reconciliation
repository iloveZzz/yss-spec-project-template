#!/usr/bin/env node
import { parseArgs } from "node:util";
import { verifyContextReconciliation } from "./lib/context-reconciliation.mjs";
try {
  const { values, positionals } = parseArgs({ options: { root: { type: "string", default: process.cwd() } }, allowPositionals: true, strict: true });
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-context-reconciliation [--root <repo>] <record.yaml|json>");
  verifyContextReconciliation(positionals[0], { root: values.root });
  process.stdout.write("Context reconciliation 验证通过\n");
} catch (error) {
  process.stderr.write(`Context reconciliation 验证失败: ${error.message}\n`);
  process.exitCode = 1;
}
