#!/usr/bin/env node
import assert from "node:assert/strict";
import { readFileSync } from "node:fs";
import path from "node:path";
import { loadRegistry, renderLifecycleStructure, renderWorkUnits, semanticDigest, validateRegistry } from "./lib/lifecycle-registry.mjs";
import {loadLifecyclePresenter, createLifecyclePresenter} from './lib/lifecycle-presentation.mjs';
import {renderReadingValue} from './lib/reading-view-markdown.mjs';

const ROOT = path.resolve(import.meta.dirname, "..");
const PUBLIC_FILES = [
  "CONTEXT.md",
  ".template-spec/templates/spec-template.md",
  ".template-spec/design/templates/product-overview-design-template.md",
  ".agents/skills/yss-stage-decision/SKILL.md",
];
const JARGON = ["DDD", "子域", "限界上下文", "Context Map", "统一语言", "不变量", "Strategic Design", "Tactical Design"];

function read(relativePath) {
  return readFileSync(path.join(ROOT, relativePath), "utf8");
}

for (const relativePath of PUBLIC_FILES) {
  const source = read(relativePath);
  for (const term of JARGON) {
    assert.equal(source.includes(term), false, `${relativePath} 不应向业务角色展示术语: ${term}`);
  }
}

const businessEntry = read("README.md").split("\n").find((line) => line.startsWith("业务方可从"));
assert.ok(businessEntry, "README.md 应保留业务入口");
assert.match(businessEntry, /生命周期注册表/);
for (const term of JARGON) assert.equal(businessEntry.includes(term), false, `README.md 业务入口不应展示术语: ${term}`);

const registry = read(".template-spec/process/lifecycle-registry.yaml");
for (const stableId of ["work-unit.domain-strategy-design", "artifact.domain-strategy", "check.domain-strategy-approved"]) {
  assert.match(registry, new RegExp(`id: ${stableId.replaceAll(".", "\\.")}`));
}
for (const displayName of ["业务边界与协作梳理", "业务边界与规则设计", "业务边界与规则评审", "方案决策包"]) {
  assert.match(registry, new RegExp(displayName));
}

const registryContract = loadRegistry();
const withoutPublicPresentation = structuredClone(registryContract);
for (const collection of ["stages", "gates", "checks", "artifacts", "work_units", "evidence"]) {
  for (const record of withoutPublicPresentation[collection]) {
    for (const key of Object.keys(record).filter((key) => key.startsWith("public_"))) delete record[key];
  }
}
assert.equal(semanticDigest(registryContract), semanticDigest(withoutPublicPresentation), "public_* 展示字段不得改变稳定 ID 语义摘要");
const rendered = `${renderLifecycleStructure(registryContract)}${renderWorkUnits(registryContract)}`;
for (const displayName of ["业务边界与协作梳理", "业务边界与规则设计", "业务边界与规则评审", "方案决策包"]) {
  assert.match(rendered, new RegExp(displayName));
}
const invalidPresentation = structuredClone(registryContract);
invalidPresentation.artifacts[0].public_name = "";
assert.throws(() => validateRegistry(invalidPresentation, { baseline: null }), /public_name 必须是非空字符串/);

const presenter = loadLifecyclePresenter(ROOT);
assert.deepEqual(presenter.warnings, []);
let count = 0;
for (const collection of ['stages','gates','checks','artifacts','work_units','evidence']) {
  for (const record of registryContract[collection]) {
    assert.equal(presenter.describe(record.id).name, record.public_name ?? record.name);
    assert.equal(presenter.describe(record.id).known, true);
    count++;
  }
}
for (const id of presenter.roleIds) { assert.equal(presenter.describe(id).known, true); count++; }
assert.equal(presenter.label('role.requirements-manager', {trace:false}), '需求经理');
assert.equal(presenter.label('check.stage-decision-package-approved', {trace:false}), '方案决策包评审');
assert.doesNotMatch(presenter.label('check.stage-decision-package-approved', {trace:false}), /已批准|已通过/);
assert.equal(presenter.label('work-unit.future', {trace:false}), '名称未识别（work-unit.future）');
assert.equal(presenter.text('docs/artifact.spec.yaml'), 'docs/artifact.spec.yaml', '文件路径不可被名称替换');
assert.equal(presenter.text('artifact.spec-extra'), '名称未识别（artifact.spec-extra）', '不能用已知 ID 的前缀误译未知 ID');
assert.equal(createLifecyclePresenter({artifacts:[{id:'artifact.a',name:'旧名',public_name:'新名'}]}).describe('artifact.a').name,'新名');
assert.equal(renderReadingValue('toString'), 'toString', '普通业务文本不可命中对象原型属性');
assert.equal(renderReadingValue('constructor'), 'constructor');
assert.equal(renderReadingValue({toString:'原始业务规则'}), '- **toString**：原始业务规则');
assert.deepEqual(createLifecyclePresenter({}, {roles:[null, {id:17}]}).roleIds, []);
process.stdout.write(`本体业务角色通俗语言场景验证通过；覆盖 ${count} 个名称\n`);
