#!/usr/bin/env node
import path from "node:path";
import { parseArgs } from "node:util";
import { fileURLToPath } from "node:url";
import { runGate } from "./lib/ci-gate.mjs";
import {selectVerificationInputs} from '../.template-source/scripts/lib/template-verification-worker.mjs';
import {compileExpectedVerificationPlan,validateVerificationReport} from '../.template-source/scripts/lib/verification-report-validator.mjs';
import {verificationInputDigest} from './lib/verification-report.mjs';

const SCRIPT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");

function usage() {
  return [
    "用法: scripts/ci-gate --mode pr --base <目标分支的完整提交SHA> [--report-dir <仓外绝对目录>]",
    "      scripts/ci-gate --mode push [--report-dir <仓外绝对目录>]",
    "      scripts/ci-gate --mode slow [--report-dir <仓外绝对目录>]  只运行 tier: slow 慢检查（定时或按需）",
    "--prepare-tools 按所选检查调用 ci-setup；本地默认不安装工具。",
    "PR 按变更运行无需额外构建工具的离线检查并列出延后项；推送模式运行完整选中的 fast。",
    "必需步骤失败即非零退出，保留实际退出码与日志。报告默认写入仓外维护目录，仓内不得新增文件。退出码：0 必需检查通过，1 必需检查失败，2 用法或环境错误。",
  ].join("\n");
}

try {
  const { values } = parseArgs({
    options: { mode: { type: "string" }, base: { type: "string" }, "report-dir": { type: "string" }, root: { type: "string" }, "prepare-tools": { type: "boolean", default: false }, help: { type: "boolean" } },
    strict: true,
  });
  if (values.help) {
    process.stdout.write(`${usage()}\n`);
  } else {
    const result = await runGate({
      verification:{selectVerificationInputs,compileExpectedVerificationPlan,validateVerificationReport,verificationInputDigest},
      root: values.root ? path.resolve(values.root) : SCRIPT_ROOT,
      mode: values.mode,
      base: values.base,
      reportDir: values["report-dir"],
      prepareTools: values["prepare-tools"],
    });
    process.exitCode = result.exitCode;
  }
} catch (error) {
  process.stderr.write(`ci-gate 错误: ${error.message}\n${error instanceof TypeError ? `${usage()}\n` : ""}`);
  process.exitCode = 2;
}
