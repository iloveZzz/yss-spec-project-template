#!/usr/bin/env ruby
# frozen_string_literal: true

require "pathname"

root = Pathname.new(__dir__).parent
skill_root = root.join(".agents/skills/yss-ui")
failures = []

required_references = %w[
  component-routing.md
  antdv-compatibility.md
  theme-locale-overlay.md
  accessibility.md
  verification.md
  migration-antdv-to-yss.md
]
required_references.each do |name|
  path = skill_root.join("references", name)
  failures << "Missing YSS UI governance reference: #{name}" unless path.file?
end

%w[yss-ui yss-components].each do |skill_name|
  body = root.join(".agents/skills", skill_name, "SKILL.md").read
  failures << "Nonexistent yss-hooks route remains in #{skill_name}" if body.include?("yss-hooks")
end

ui_body = skill_root.join("SKILL.md").read
%w[yss-hook YssFormily component-routing.md antdv-compatibility.md ConfigProvider accessibility].each do |marker|
  failures << "YSS UI router missing marker: #{marker}" unless ui_body.include?(marker)
end

routing_body = skill_root.join("references/component-routing.md").read
%w[YButton YCard YTable YTree YssFormily YSplitPane required fallback specialized].each do |marker|
  failures << "Component routing missing marker: #{marker}" unless routing_body.include?(marker)
end

compatibility_body = skill_root.join("references/antdv-compatibility.md").read
%w[pnpm\ why 4.2.6 2026-08-08 lockfile].each do |marker|
  expected = marker.tr("\\", "")
  failures << "AntDV compatibility reference missing marker: #{expected}" unless compatibility_body.include?(expected)
end

wrapped_antdv_components = %w[Button Card Table Tree]
skill_root.glob("assets/demos/**/*.vue").each do |path|
  body = path.read
  body.scan(/import\s*\{([^}]*)\}\s*from\s*['\"]ant-design-vue['\"]/m).flatten.each do |imports|
    names = imports.split(",").map { |item| item.strip.split(/\s+as\s+/).first }
    forbidden = names & wrapped_antdv_components
    failures << "Demo bypasses required YSS wrapper: #{path.relative_path_from(root)} -> #{forbidden.join(', ')}" unless forbidden.empty?
  end
end

quick_recipes = skill_root.join("references/quick-recipes.md").read
failures << "Quick recipes still recommend YFormily alias" if quick_recipes.match?(/<YFormily\b|\bYFormily：/)

scenario_index = skill_root.join("assets/scenario-index.md").read
failures << "Recommended scenario index contains pending-verification demo" if scenario_index.include?("pending-verification")

unless failures.empty?
  warn failures.join("\n")
  exit 1
end

puts "YSS UI governance scenarios passed"
