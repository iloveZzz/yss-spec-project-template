#!/usr/bin/env node
import { existsSync, readFileSync, readdirSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const skillRoot = path.join(root, ".agents/skills/yss-ui");
const failures = [];
const read = (filePath) => readFileSync(filePath, "utf8");
function filesUnder(directory) {
  return readdirSync(directory, { withFileTypes: true }).flatMap((entry) => {
    const target = path.join(directory, entry.name);
    return entry.isDirectory() ? filesUnder(target) : entry.isFile() ? [target] : [];
  });
}

const requiredReferences = [
  "component-routing.md",
  "antdv-compatibility.md",
  "theme-locale-overlay.md",
  "accessibility.md",
  "verification.md",
  "migration-antdv-to-yss.md"
];
for (const name of requiredReferences) if (!existsSync(path.join(skillRoot, "references", name))) failures.push(`Missing YSS UI governance reference: ${name}`);

for (const skillName of ["yss-ui", "yss-components"]) if (read(path.join(root, ".agents/skills", skillName, "SKILL.md")).includes("yss-hooks")) failures.push(`Nonexistent yss-hooks route remains in ${skillName}`);

const uiBody = read(path.join(skillRoot, "SKILL.md"));
for (const marker of ["yss-hook", "YssFormily", "component-routing.md", "antdv-compatibility.md", "ConfigProvider", "accessibility"]) if (!uiBody.includes(marker)) failures.push(`YSS UI router missing marker: ${marker}`);

const routingBody = read(path.join(skillRoot, "references/component-routing.md"));
for (const marker of ["YButton", "YCard", "YTable", "YTree", "YssFormily", "YSplitPane", "required", "fallback", "specialized"]) if (!routingBody.includes(marker)) failures.push(`Component routing missing marker: ${marker}`);

const compatibilityBody = read(path.join(skillRoot, "references/antdv-compatibility.md"));
for (const marker of ["pnpm why", "4.2.6", "2026-08-08", "lockfile"]) if (!compatibilityBody.includes(marker)) failures.push(`AntDV compatibility reference missing marker: ${marker}`);

const wrappedAntdvComponents = new Set(["Button", "Card", "Table", "Tree"]);
for (const filePath of filesUnder(path.join(skillRoot, "assets/demos")).filter((filePath) => filePath.endsWith(".vue"))) {
  for (const match of read(filePath).matchAll(/import\s*\{([^}]*)\}\s*from\s*['"]ant-design-vue['"]/gm)) {
    const forbidden = match[1].split(",").map((item) => item.trim().split(/\s+as\s+/)[0]).filter((name) => wrappedAntdvComponents.has(name));
    if (forbidden.length > 0) failures.push(`Demo bypasses required YSS wrapper: ${path.relative(root, filePath)} -> ${forbidden.join(", ")}`);
  }
}

if (/<YFormily\b|\bYFormily：/.test(read(path.join(skillRoot, "references/quick-recipes.md")))) failures.push("Quick recipes still recommend YFormily alias");

if (read(path.join(skillRoot, "assets/scenario-index.md")).includes("pending-verification")) failures.push("Recommended scenario index contains pending-verification demo");
if (failures.length > 0) {
  process.stderr.write(`${failures.join("\n")}\n`);
  process.exitCode = 1;
} else {
  process.stdout.write("YSS UI governance scenarios passed\n");
}
