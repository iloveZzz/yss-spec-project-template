#!/usr/bin/env node
import { scanRetiredSkillIds } from "./lib/skill-retirement.mjs";

try {
  const result = scanRetiredSkillIds();
  const hard = result.hard;
  const violations = result.violations;
  const summary = "退役检查：hard=" + hard.length + " text=" + violations.length + " allowed-references=" + result.allowedReferences.length;
  if (hard.length || violations.length) {
    process.stderr.write("退役 skill id 仍存在于活跃资产:\n" + [...hard, ...violations].join("\n") + "\n");
    process.exitCode = 1;
  } else {
    process.stdout.write(summary + "\nretired skill ids are absent from active assets\n");
  }
} catch (error) {
  process.stderr.write("verify-retired-skill-ids 错误: " + error.message + "\n");
  process.exitCode = 1;
}
