#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { parseArgs } from 'node:util';
import { planProjectCi, applyProjectCi } from './lib/project-ci-install.mjs';
import { checkProjectGovernance } from './lib/project-governance.mjs';
import { assertNodeVersion, beginRuntimeRun } from './lib/runtime-store.mjs';

try {
  const {values,positionals}=parseArgs({allowPositionals:true,options:{root:{type:'string',default:'.'},provider:{type:'string',default:'github'},branch:{type:'string'},plan:{type:'string'},'additional-path':{type:'string',multiple:true},base:{type:'string'},recover:{type:'boolean'},json:{type:'boolean'},help:{type:'boolean'},'runtime-store':{type:'string',default:'off'}}});
  if(values.help){process.stdout.write('用法: scripts/project-ci plan --provider github --root <项目> [--branch main] [--additional-path <根相对路径>]\n      scripts/project-ci apply --root <项目> --plan <plan.json>\n      scripts/project-ci apply --root <项目> --recover\n      scripts/project-ci check --root <项目> [--base <40位commit>] [--runtime-store sqlite|off] --json\nplan/check 只读，apply 仅显式管理自身工作流；不改远端或批准。退出码 0=通过/计划完成，1=检查失败/冲突，2=输入/能力/执行异常。\n');}
  else {
    if(positionals.length!==1||!['plan','apply','check'].includes(positionals[0]))throw new Error('需要 plan、apply 或 check；参见 --help');
    assertNodeVersion();
    if(!['sqlite','off'].includes(values['runtime-store']))throw new Error('runtime-store 必须为 sqlite 或 off');
    const root=path.resolve(values.root);let result;
    if(positionals[0]==='plan'){result=planProjectCi({root,provider:values.provider,branch:values.branch,additionalPaths:values['additional-path']});if(result.conflicts.length)process.exitCode=1;}
    if(positionals[0]==='apply'){if(!values.recover&&!values.plan)throw new Error('apply 需要 --plan');result=applyProjectCi({root,recover:values.recover,plan:values.plan?JSON.parse(fs.readFileSync(values.plan,'utf8')):undefined});}
    if(positionals[0]==='check'){
      const session=beginRuntimeRun({root,kind:'project-ci-check',mode:values['runtime-store'],input:{base:values.base||null}});
      try {
        const started=performance.now(),check=checkProjectGovernance({root,base:values.base});result=check.report;process.exitCode=check.exitCode;
        if(session)try { session.recordCommand({command:'project-ci check',exit_code:check.exitCode,duration_ms:Math.round(performance.now()-started)});session.finish({status:check.exitCode===0?'passed':'failed',exitCode:check.exitCode,report:result}); }
        catch(error){process.stderr.write(`运行存储异常，原检查退出码=${check.exitCode}: ${error.message}\n`);}
      }finally{session?.close();}
    }
    process.stdout.write(JSON.stringify(result,null,2)+'\n');
  }
}catch(error){process.stdout.write(JSON.stringify({schema_version:1,status:'error',read_only:process.argv[2]!=='apply',error:error.message})+'\n');process.stderr.write(error.message+'\n');process.exitCode=error.exitCode||2;}
process.stdout.on('error',error=>{process.stderr.write(`输出失败: ${error.message}\n`);process.exitCode=2;});
