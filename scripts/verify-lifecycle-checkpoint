#!/usr/bin/env node
import { assertBusinessApprovalBasis } from './lib/business-ticket-lifecycle.mjs';
import { assertBusinessCheckpoint } from './lib/business-tickets.mjs';
import { assertStageTracking } from './lib/stage-tracking.mjs';
import { readFileSync, withValidationPhase } from "./lib/validation-phase.mjs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { parseArgs } from "node:util";
import { fileURLToPath } from "node:url";
import { parseDocument } from "./vendor/yaml.mjs";
import { assertCheckpointApprovals, assertCheckpointUserDecisions } from "./lib/approval-record.mjs";
import { loadExecutionScope, assertScopeWorkUnit, verifyDeliveryTerminal } from './lib/lifecycle-execution-scope.mjs';
import { assertPlanCheckpoint } from "./lib/plan-spec-entry.mjs";
import { assertCheckpointBoundary } from './lib/checkpoint-boundary.mjs';
import { parseAsset, validateAssetStructure } from './lib/structured-assets.mjs';
import { assertCurrentAssetReference } from './lib/asset-transactions.mjs';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const schemaPath = path.join(root, ".template-spec/process/schemas/lifecycle-checkpoint.schema.json");
const validator = String.raw`
import json
import sys
from jsonschema import Draft202012Validator
schema = json.load(open(sys.argv[1], encoding="utf-8"))
if sys.argv[2] == 'history':
    for key in ['phase_boundary', 'stage_trace']:
        schema['properties'][key] = {'type': 'object'}
value = json.load(sys.stdin)
errors = sorted(Draft202012Validator(schema).iter_errors(value), key=lambda error: list(error.absolute_path))
for error in errors:
    location = ".".join(str(part) for part in error.absolute_path) or "<root>"
    print(f"{location}: {error.message}", file=sys.stderr)
sys.exit(1 if errors else 0)
`;

try {
  const { positionals, values } = parseArgs({ options: { history:{type:'boolean'},help:{type:'boolean'} }, allowPositionals: true, strict: true });
  if(values.help){process.stdout.write('用法: scripts/verify-lifecycle-checkpoint [--history] <checkpoint.yaml|json>\n默认核验当前记录；--history 仅检查历史结构，不证明当前批准或流转。退出码 0=检查完成，1=失败。\n');}
  else {
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-lifecycle-checkpoint <checkpoint.yaml|checkpoint.json>");
  const verify = () => {
  const sourcePath = path.resolve(positionals[0]);
  if(!values.history)assertCurrentAssetReference(root,path.relative(root,sourcePath));
  const value = parseAsset(readFileSync(sourcePath), sourcePath);
  if (values.history) {
    const result = spawnSync("python3", ["-c", validator, schemaPath,'history'], { cwd: root, encoding: "utf8", input: JSON.stringify(value) });
    if (result.status !== 0) throw new TypeError(`${result.stdout}${result.stderr}`.trim());
  } else validateAssetStructure(value, 'checkpoint');
  if(values.history) process.stdout.write('历史兼容结构检查完成；不证明当前批准或流转，execution_authorization=not-evaluated\n');
  else {
  assertCheckpointBoundary(value,{root});
  assertBusinessCheckpoint(root,value);
  assertBusinessApprovalBasis(root,value,{required:['work-unit.technical-analysis','work-unit.strategic-design-handoff','work-unit.implementation-repository-preparation','work-unit.ticket-decomposition','work-unit.slice-implementation'].includes(value.next_work_unit)});
  if(loadExecutionScope(root)) {
    if(value.status==='completed') {
      if(value.next_work_unit!==null)throw new TypeError('后端终点不得继续其他工作单元');
      verifyDeliveryTerminal(root);
    } else if(value.next_work_unit) assertScopeWorkUnit(value.next_work_unit,{root,readOnly:value.mode==='audit'||value.mode==='route'});
    else if(value.mode==='resume'||value.mode==='orchestrate') assertScopeWorkUnit('work-unit.entry-triage',{root});
  }
  assertStageTracking(value, { root, checkpointRef: path.relative(root, sourcePath), nextWorkUnit: value.next_work_unit, entering: value.mode === 'resume' || value.mode === 'orchestrate' });
  assertCheckpointApprovals(value, sourcePath, {root});
  assertPlanCheckpoint(value, { root });
  assertCheckpointUserDecisions(value,{root});
  if (value.repository_mode === "project-instance" && ["paused-human-gate", "completed"].includes(value.status)) {
    if (value.context_reconciliation?.status !== "reconciled" || !value.context_reconciliation?.ref) throw new TypeError("project-instance 在会签或完成前必须具有 reconciled context_reconciliation");
    const reconciliation = path.resolve(root, value.context_reconciliation.ref);
    const checked = spawnSync(path.join(root, "scripts/verify-context-reconciliation"), ["--root", root, reconciliation], { cwd: root, encoding: "utf8" });
    if (checked.status !== 0) throw new TypeError(checked.stderr.trim() || "context_reconciliation 无效");
  }
  if (value.repository_mode === "template-source" && value.context_reconciliation?.status !== "not-applicable") throw new TypeError("template-source context_reconciliation 必须为 not-applicable");
  process.stdout.write("生命周期 checkpoint 验证通过\n");
  }
  };
  if(values.history) verify();
  else withValidationPhase({root,purpose:'lifecycle-checkpoint-current',readOnly:true},verify);
  }
} catch (error) {
  process.stderr.write(`生命周期 checkpoint 验证失败: ${error.message}\n`);
  process.exitCode = 1;
}
