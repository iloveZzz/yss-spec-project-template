#!/usr/bin/env node
import { existsSync, mkdirSync, writeFileSync } from "node:fs";
import path from "node:path";
import { parseArgs } from "node:util";
import { stringify } from "./vendor/yaml.mjs";
import { generateReviewerTaskPackages } from "./lib/maintenance-review-workflow.mjs";
import { ROOT } from "./lib/template-verification.mjs";
import { resolveMaintenanceOutput, maintenanceReference } from './lib/maintenance-storage.mjs';

try {
  const { values } = parseArgs({ options: {
    checkpoint: { type: "string" }, candidate: { type: "string" }, "output-dir": { type: "string" },
    "candidate-kind": { type: "string" }, "candidate-requirement": { type: "string" },
    "implementation-actor": { type: "string" }, round: { type: "string" }
  }, strict: true });
  for (const field of ["checkpoint", "candidate", "output-dir", "candidate-requirement", "implementation-actor", "round"]) if (!values[field]) throw new TypeError(`缺少 --${field}`);
  const outputPath = resolveMaintenanceOutput(values["output-dir"], { root: ROOT });
  if (existsSync(outputPath)) throw new TypeError("output-dir 必须不存在，拒绝覆盖已有审查任务包");
  const outputRef = maintenanceReference(outputPath, { root: ROOT });
  const packages = generateReviewerTaskPackages({ checkpointRef: values.checkpoint, candidateRef: values.candidate, outputDir: outputRef, candidateKind: values["candidate-kind"], candidateRequirement: values["candidate-requirement"], implementationActorId: values["implementation-actor"], round: Number(values.round) });
  mkdirSync(path.dirname(outputPath), { recursive: true });
  mkdirSync(outputPath);
  for (const item of packages) writeFileSync(resolveMaintenanceOutput(item.packageRef, { root: ROOT }), stringify(item.package, { lineWidth: 0 }), { flag: 'wx' });
  process.stdout.write(`${JSON.stringify(packages.map(({ axis, packageRef, reportRef }) => ({ axis, package_ref: packageRef, report_ref: reportRef })), null, 2)}\n`);
} catch (error) {
  process.stderr.write(`维护审查任务包生成失败: ${error.message}\n`);
  process.exitCode = 1;
}
