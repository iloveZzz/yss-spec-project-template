#!/usr/bin/env node
import { existsSync, readFileSync } from "node:fs";
import { spawnSync } from "node:child_process";
import path from "node:path";
import { treeHash } from "./lib/skill-supply-chain.mjs";

const root = path.resolve(path.dirname(new URL(import.meta.url).pathname), "..");
const args = process.argv.slice(2);
const sourceRootArg = args.find((arg) => arg.startsWith("--source-root="))?.slice("--source-root=".length);
if (!sourceRootArg) {
  process.stderr.write("用法: scripts/verify-upstream-skill-source --source-root=<上游 checkout>\n");
  process.exit(2);
}
const sourceRoot = path.resolve(sourceRootArg);
const lock = JSON.parse(readFileSync(path.join(root, "skills-lock.json"), "utf8"));
const source = "mattpocock/skills";
const revision = lock.sources?.[source]?.revision;
if (!revision) throw new TypeError(`锁文件缺少 ${source} source revision`);
const git = spawnSync("git", ["-C", sourceRoot, "rev-parse", "HEAD"], { encoding: "utf8" });
if (git.status !== 0) throw new TypeError(`无法读取上游 checkout revision: ${sourceRoot}`);
if (git.stdout.trim() !== revision) throw new TypeError(`上游 revision 不匹配: expected=${revision} actual=${git.stdout.trim()}`);

const shared = lock.skills?.shared ?? {};
for (const [name, item] of Object.entries(shared)) {
  if (item.source !== source) continue;
  if (item.sourceRevision !== revision) throw new TypeError(`${name} 缺少一致的 sourceRevision`);
  const directory = path.dirname(path.join(sourceRoot, item.skillPath));
  if (!existsSync(directory)) throw new TypeError(`${name} 的上游路径不存在: ${item.skillPath}`);
  const actualHash = treeHash(directory);
  if (actualHash !== item.upstreamHash) throw new TypeError(`${name} upstreamHash 不匹配: expected=${item.upstreamHash} actual=${actualHash}`);
}
process.stdout.write(`上游 ${source}@${revision} 及其 skill hashes 验证通过\n`);
