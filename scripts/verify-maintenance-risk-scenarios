#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { parseArgs } from 'node:util';
import { spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';
import { readDocument, safeFile, fileBinding, digest } from './lib/governance-io.mjs';
const root=path.resolve(path.dirname(fileURLToPath(import.meta.url)),'..');
try {
  const {values}=parseArgs({options:{output:{type:'string'},help:{type:'boolean'}}});
  if(values.help)process.stdout.write('用法: scripts/verify-maintenance-risk-scenarios --output <新的根相对目录>\n运行权限、流转和发布拒绝场景，生成可绑定的实际反例记录。退出码 0=拒绝断言通过、1=失败。\n');
  else {
    if(!values.output)throw new Error('需要 --output');
    const destination=safeFile(root,values.output);
    if(fs.existsSync(destination))throw new Error('证据目录已存在，保留原记录；请指定新目录');
    fs.mkdirSync(destination,{recursive:true});
    const cp=readDocument(root,'.template-spec/process/templates/lifecycle-checkpoint-template.yaml');
    const release={schema_version:2,intensity:'L3',classification_reason:'发布反例',triggers:['core-validator'],changed_assets:['scripts/verify-template'],verification_evidence:[{kind:'fresh-verification',command:'scripts/verify-template',result:'pass'},{kind:'self-check',command:'test',result:'pass'}],review_mode:'self-check',escalation:'none',target_state:'release-ready',current_state:'release-ready',verification_profile:'release',review_round:0,candidate_digest:null};
    const cases=[
      {trigger:'permission-boundary',id:'vetoed-approval',script:'scripts/verify-approval-record',expected_diagnostic:'已被生物人否决，不能标为 approved',input:{schema_version:1,gate_id:'gate.delivery-accepted',decision:'approved',actor_kind:'digital-human',role_id:'role.test-engineer',runtime_id:'runtime.generic',principal_ref:'instance:counterexample',biological_veto:true}},
      {trigger:'lifecycle-gate',id:'handoff-without-evidence',script:'scripts/verify-lifecycle-checkpoint',expected_diagnostic:"'source_ref' is a required property",input:{...cp,phase_boundary:{decision:'handoff',reason:'缺少交接证据'}}},
      {trigger:'release-semantics',id:'release-without-final-verification',script:'scripts/verify-maintenance-checkpoint',expected_diagnostic:'release-ready 缺少 final-release-verification 证据',input:release}
    ];
    const code=['scripts/vendor/yaml.mjs','scripts/verify-approval-record','.template-spec/agents/digital-human-roles.yaml','.template-spec/process/lifecycle-registry.yaml','.agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml','scripts/verify-maintenance-risk-scenarios','scripts/verify-lifecycle-checkpoint','scripts/verify-maintenance-checkpoint','.template-source/process/maintenance-intensity.yaml','.template-spec/process/schemas/lifecycle-checkpoint.schema.json',...fs.readdirSync(path.join(root,'scripts/lib')).filter(x=>x.endsWith('.mjs')).map(x=>'scripts/lib/'+x)];
    const records=[];
    for(const scenario of cases) {
      const inputRef=`${values.output}/${scenario.trigger}.input.json`,logRef=`${values.output}/${scenario.trigger}.log.json`,runRef=`${values.output}/${scenario.trigger}.run.json`;
      fs.writeFileSync(safeFile(root,inputRef),JSON.stringify(scenario.input,null,2)+'\n');
      const inputs=[...code,inputRef].sort().map(ref=>({ref,digest:fileBinding(root,ref)})),started_at=new Date().toISOString();
      const command=[process.execPath,scenario.script,inputRef],result=spawnSync(command[0],command.slice(1),{cwd:root,encoding:'utf8',timeout:30000,maxBuffer:4*1024*1024});
      if(result.error||result.status!==1||!`${result.stderr}\n${result.stdout}`.includes(scenario.expected_diagnostic))throw new Error(`${scenario.id}: 未命中预期拒绝原因: ${result.stderr}`);
      const log=[{id:scenario.id,command,exit_code:result.status,stdout:result.stdout,stderr:result.stderr}];
      fs.writeFileSync(safeFile(root,logRef),JSON.stringify(log,null,2)+'\n');
      const evidenceCommand=`scripts/verify-maintenance-risk-scenarios --output ${values.output}`;
      const run={schema_version:1,kind:'maintenance-counterexample-run',trigger:scenario.trigger,command:evidenceCommand,exit_code:0,started_at,finished_at:new Date().toISOString(),assertions:[{id:scenario.id,expected:'reject',actual:'rejected',expected_diagnostic:scenario.expected_diagnostic}],inputs,input_digest:digest(JSON.stringify(inputs)),log:{ref:logRef,digest:fileBinding(root,logRef)}};
      fs.writeFileSync(safeFile(root,runRef),JSON.stringify(run,null,2)+'\n');records.push({kind:'counterexample',trigger:scenario.trigger,command:evidenceCommand,result:'pass',run_ref:runRef});
    }
    process.stdout.write(JSON.stringify({status:'passed',verification_evidence:records},null,2)+'\n');
  }
}catch(error){process.stderr.write(error.message+'\n');process.exitCode=1;}
