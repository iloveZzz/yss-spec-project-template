#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { existsSync, mkdtempSync, rmSync, mkdirSync, realpathSync, writeFileSync } from "node:fs";
import os from "node:os";
import path from "node:path";
import { parseArgs } from "node:util";
import { assertRequiredFiles, planTemplateVerification, ROOT } from "./lib/template-verification.mjs";
import { printResults, runGroups } from "./lib/template-verification-runner.mjs";
import { assertNodeVersion, beginRuntimeRun } from "./lib/runtime-store.mjs";

import {verificationInputDigest,resolveVerificationScope,createVerificationReport,finalizeVerificationReport,saveVerificationReport} from './lib/verification-report.mjs';
let report, reportDir, logRoot, mode, beforeDigest, started, runtimeSession, runtimeMode, storageErrors = [], controller=new AbortController();
const interrupt=()=>controller.abort();process.on('SIGINT',interrupt);process.on('SIGTERM',interrupt);
function git(args) {
  const result = spawnSync("git", args, { cwd: ROOT, encoding: "utf8", maxBuffer: 32 * 1024 * 1024 });
  if (result.status !== 0) throw new TypeError(result.stderr.trim() || `git ${args.join(" ")} 执行失败`);
  return result.stdout;
}

function collectChangedFiles(base) {
  const files = new Set();
  const collect = (source) => source.split("\0").filter(Boolean).forEach((file) => files.add(file));
  if (base) collect(git(["diff", "--name-only", "-z", "--no-renames", "--diff-filter=ACDMRTUXB", `${base}...HEAD`]));
  collect(git(["diff", "--name-only", "-z", "--no-renames", "--diff-filter=ACDMRTUXB"]));
  collect(git(["diff", "--cached", "--name-only", "-z", "--no-renames", "--diff-filter=ACDMRTUXB"]));
  collect(git(["ls-files", "-z", "--others", "--exclude-standard"]));
  return [...files];
}

function recordRuntime(operation) {
  if (!runtimeSession) return;
  try { operation(runtimeSession); } catch (error) { storageErrors.push(error.message); }
}
function runValidator(command, args) {
  const begin=performance.now();
  const result = spawnSync(command, args, { cwd: ROOT, encoding: "utf8" });
  if(report){const index=report.results.length,stdoutFile=path.join(logRoot,`post-${index}.stdout`),stderrFile=path.join(logRoot,`post-${index}.stderr`);mkdirSync(logRoot,{recursive:true});writeFileSync(stdoutFile,result.stdout||'');writeFileSync(stderrFile,result.stderr||'');report.results.push({id:`post.${index}`,group:'postchecks',command:JSON.stringify([command,...args]),code:result.status??1,actual_exit_code:Number.isInteger(result.status)?result.status:null,actual_exit_signal:result.signal??null,actual_exit_code_observed:Number.isInteger(result.status),duration_ms:Math.round(performance.now()-begin),stdoutFile,stderrFile,reused:false});recordRuntime(session=>session.recordCommand(report.results.at(-1)));if(reportDir)saveVerificationReport(reportDir,report);}
  if (result.status !== 0) throw new TypeError(result.stderr.trim() || `${command} 校验失败`);
}

async function main() {
try {
  const { values } = parseArgs({
    options: {
      help: { type: "boolean", default: false },
      profile: { type: "string", default: "fast" },
      base: { type: "string" },
      "changed-file": { type: "string", multiple: true },
      selection: {type:"string"},
      "report-dir": {type:"string"},
      "runtime-store": {type:"string",default:"off"},
      plan: { type: "boolean", default: false },
      json: { type: "boolean", default: false },
      concurrency: { type: "string" },
      "tooling-mode": { type: "string" },
      checkpoint: { type: "string", multiple: true },
      "task-package": { type: "string", multiple: true }
    },
    strict: true
  });
  if (values.help) {
    process.stdout.write('用法: scripts/verify-template[-fast|-candidate] [--base <commit>] [--plan --json] [--report-dir <仓库外新目录>] [--concurrency 1..4] [--tooling-mode legacy|optimized] [--runtime-store sqlite|off]\n--concurrency 1 同时限制内部测试并行度；release 强制 legacy 且整体串行。\n--plan 只输出计划，不执行验证；退出码 0 表示计划输出完成或适用检查通过，1 表示失败。\n');
    return;
  }
  const explicit = values["changed-file"] || [];
  const scope=resolveVerificationScope({profile:values.profile,explicit,actual:collectChangedFiles(values.base)});
  let plan = planTemplateVerification({ profile: values.profile, changedFiles: scope.files, ...(values.selection?{selection:values.selection}:{}) });
  scope.base=values.base||null;
  if(values.profile==='candidate'&&!values.base){plan=planTemplateVerification({profile:'release',changedFiles:scope.files,...(values.selection?{selection:values.selection}:{})});plan.requested_profile='candidate';plan.escalation_reason='未指定候选基线，使用全量验证防止遗漏已提交改动';}
  plan.scope=scope;
  const requestedConcurrency = Number(values.concurrency || plan.max_concurrency);
  if (!Number.isInteger(requestedConcurrency) || requestedConcurrency < 1 || requestedConcurrency > 4) throw new TypeError("concurrency 必须为 1..4");
  const concurrency = plan.effective_profile === 'release' ? 1 : requestedConcurrency;
  const requestedMode = values['tooling-mode'] || 'legacy';
  if (!['legacy', 'optimized'].includes(requestedMode)) throw new TypeError('tooling-mode 必须为 legacy 或 optimized');
  const effectiveMode = plan.effective_profile === 'release' ? 'legacy' : requestedMode;
  plan.tooling = { requested_mode: requestedMode, effective_mode: effectiveMode, verification_concurrency: concurrency,
    test_concurrency: effectiveMode === 'legacy' ? 1 : Math.min(2, concurrency),
    reason: plan.effective_profile === 'release' ? 'release-full-serial' : values['tooling-mode'] ? 'explicit' : 'qualification-pending' };
  if(values['report-dir']) {
    reportDir=path.resolve(values['report-dir']);
    if(existsSync(reportDir))throw Error('report-dir 必须为新目录，防止覆盖历史证据');
    const parent=realpathSync(path.dirname(reportDir));
    if(parent===ROOT||parent.startsWith(ROOT+path.sep))throw Error('report-dir 必须位于仓库外；验证完成后再归档证据');
  }
  runtimeMode = values["runtime-store"];
  if (!["sqlite", "off"].includes(runtimeMode)) throw new TypeError("runtime-store 必须为 sqlite 或 off");
  assertNodeVersion();
  if (values.plan) {
    process.stdout.write(`${JSON.stringify(plan, null, values.json ? 2 : 0)}\n`);
    return;
  }

  assertRequiredFiles(plan);
  beforeDigest=verificationInputDigest(ROOT);
  const modeResult = spawnSync(process.execPath, [path.join(ROOT, "scripts/repository-mode")], { cwd: ROOT, encoding: "utf8" });
  if (modeResult.status !== 0) throw new TypeError(modeResult.stderr?.trim() || modeResult.error?.message || "仓库身份校验失败");

  mode=modeResult.stdout.trim();started=performance.now();
  runtimeSession=beginRuntimeRun({root:ROOT,kind:"template-verification",mode:runtimeMode,input:{input_sha256:beforeDigest,plan},reportDir});
  if(reportDir)mkdirSync(reportDir);
  report=createVerificationReport(plan,{root:ROOT,inputDigest:beforeDigest,concurrency,scope});
  if(reportDir)saveVerificationReport(reportDir,report);
  process.stderr.write(`验证 selection: ${plan.selection.requested} -> ${plan.selection.effective}，范围: ${scope.kind}\n`);
  process.stderr.write(`模板核验 profile: ${plan.requested_profile} -> ${plan.effective_profile}，来源要求: ${plan.source_requirement}\n`);
  if (plan.escalation_reason) process.stderr.write(`自动升级原因: ${plan.escalation_reason}\n`);
  logRoot = reportDir ? path.join(reportDir,'logs') : runtimeSession ? path.join(runtimeSession.runDir, "logs") : mkdtempSync(path.join(os.tmpdir(), "yss-template-verification-"));
  const environment = { ...process.env, PYTHONDONTWRITEBYTECODE: '1', YSS_TOOLING_MODE: effectiveMode,
    YSS_TOOLING_CONCURRENCY: String(plan.tooling.test_concurrency),
    ...(reportDir ? { YSS_TOOLING_REPORT_DIR: path.join(reportDir, 'tooling') } : {}) };
  const groups = await runGroups(plan, mode, concurrency, { cwd: ROOT, environment, logRoot, signal:controller.signal, runtimeSession, runtimeEvent:'check-result', onResult:row=>{report.results.push(row);if(row.storageError)storageErrors.push(row.storageError);if(reportDir)saveVerificationReport(reportDir,report);} });
  await printResults(groups);
  if(storageErrors.length)throw Error(`运行存储异常: ${storageErrors.join("; ")}`);
  if(controller.signal.aborted)throw Error('验证被中断');
  const failed = groups.flatMap((group) => group.results).find((result) => result.code !== 0);
  if (failed) throw new TypeError(`检查失败: ${failed.command}`);

  if (plan.effective_profile === "release") {
    for (const file of plan.syntax_files) runValidator(process.execPath, ["--check", file]);
    const roots = ["scripts", ".template-source/scripts"].filter((dir) => existsSync(`${ROOT}/${dir}`));
    const legacyRuntime = ["ru", "by"].join("");
    const legacyCall = spawnSync("rg", ["-n", `^#!.*${legacyRuntime}|\\b${legacyRuntime}\\b`, ...roots, "--glob", "!*.md"], { cwd: ROOT, encoding: "utf8" });
    if (legacyCall.status === 0) throw new TypeError("模板脚本不得保留活跃 Ruby 调用或 shebang");
    const legacyFiles = spawnSync("sh", ["-c", `rg --files ${roots.join(" ")} | rg '\\.rb$'`], { cwd: ROOT, encoding: "utf8" });
    if (legacyFiles.status === 0) throw new TypeError("模板脚本不得保留 .rb 路径");
  }
  for (const checkpoint of values.checkpoint || []) runValidator("scripts/verify-maintenance-checkpoint", [checkpoint]);
  for (const taskPackage of values["task-package"] || []) runValidator("scripts/verify-digital-human-task-package", [taskPackage]);
  runValidator("git", ["diff", "--check"]);
  if (verificationInputDigest(ROOT) !== beforeDigest) throw new TypeError("核验命令修改了工作树；检查必须只读");
  finalizeVerificationReport(report,{status:'passed',wallMs:Math.round(performance.now()-started),repositoryMode:mode});

} catch (error) {
  if(report)finalizeVerificationReport(report,{status:controller.signal.aborted?'interrupted':'failed',error:error.message,wallMs:Math.round(performance.now()-started),repositoryMode:mode});
  process.stderr.write(`模板核验失败: ${error.message}\n`);
  process.exitCode = 1;
}
finally {
  if(report)try{report.input_after_sha256=verificationInputDigest(ROOT);report.input_drift=report.input_after_sha256!==beforeDigest;if(report.input_drift){report.status='failed';report.error=[report.error,'验证输入变化，必须重新生成计划'].filter(Boolean).join('; ');process.exitCode=1;}}catch(error){report.status='failed';report.error=[report.error,error.message].filter(Boolean).join('; ');process.exitCode=1;}
  if(report) {
    if(storageErrors.length){report.status='failed';report.error=[report.error,`运行存储异常: ${storageErrors.join('; ')}`].filter(Boolean).join('; ');process.exitCode=1;}
    try {
      if(reportDir)saveVerificationReport(reportDir,report);
      if(runtimeSession) {
        runtimeSession.recordEvent('unexecuted',report.unexecuted);
        runtimeSession.registerFiles(reportDir || runtimeSession.runDir);
        runtimeSession.finish({status:report.status,exitCode:process.exitCode||0,report});
      }
    } catch(error) { storageErrors.push(error.message); }
    if(storageErrors.length) {
      report.status='failed';report.error=[report.error,`运行存储异常: ${storageErrors.join('; ')}`].filter(Boolean).join('; ');process.exitCode=1;
      // Preserve original command results and logs even when SQLite cannot save its terminal state.
      try { saveVerificationReport(reportDir || runtimeSession?.runDir || logRoot,report); } catch(error) {process.stderr.write(`报告保存失败: ${error.message}\n`);}
      process.stderr.write(`运行存储异常，日志已保留: ${logRoot}\n`);
    }
    if(report.status==='passed'&&!process.exitCode)process.stdout.write(`模板核验通过（${report.plan.requested_profile} → ${report.plan.effective_profile}，来源要求：${report.plan.source_requirement}）\n`);
  }
  try {runtimeSession?.close();}catch(error){process.stderr.write(`运行存储关闭异常: ${error.message}\n`);process.exitCode=1;}
  if(logRoot&&!reportDir&&!runtimeSession&&!storageErrors.length)rmSync(logRoot,{recursive:true,force:true});
  process.off('SIGINT',interrupt);process.off('SIGTERM',interrupt);
}
}
process.stdout.on('error', error => { process.stderr.write(`输出失败: ${error.message}\n`); process.exitCode = 1; });
await main();
