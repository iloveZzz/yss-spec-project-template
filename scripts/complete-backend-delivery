#!/usr/bin/env node
// verify 的校验语义归 yss（contract verify --kind backend-delivery-terminal），这里只翻译参数、透传结论与退出码；
// complete 是写终点的工作流，仍在 Node（写入前的预检查与写后复验见 lib/backend-delivery-terminal.mjs）。
import path from 'node:path';
import { parseArgs } from 'node:util';
import { readFileSync } from 'node:fs';
import { nativeContractVerify, assertNativeCapabilities, NEEDS } from './lib/native-evidence.mjs';

// yss 的资产引用是项目根内的相对路径；根外路径原样交给 yss 拒绝。
const inside = (root, ref) => { const rel = path.relative(root, path.resolve(root, ref)); return rel && !rel.startsWith('..') && !path.isAbsolute(rel) ? rel.split(path.sep).join('/') : path.resolve(root, ref); };
const RESULT_ORDER = ['result', 'delivery_id', 'version', 'next_work_unit', 'business_completed', 'release_authorized', 'live_service_checked', 'downstream', 'terminal_ref', 'checkpoint_ref', 'delivery_mode', 'bundle_digest'];

try {
  const { values, positionals } = parseArgs({ allowPositionals: true, options: { root: { type: 'string' }, input: { type: 'string' }, checkpoint: { type: 'string' } } });
  if (positionals.length !== 1 || !values.root) throw new TypeError('用法: complete-backend-delivery complete --root <governance> --input <plan.json> [--checkpoint <ref>] | verify --root <governance> [--checkpoint <ref>]');
  const root = path.resolve(values.root);
  let result;
  if (positionals[0] === 'verify' && !values.input) {
    assertNativeCapabilities(NEEDS.backendTerminal);
    const checkpoint = values.checkpoint ? inside(root, values.checkpoint) : null;
    const verdict = nativeContractVerify({ root, kind: 'backend-delivery-terminal', file: checkpoint ?? '.yss-backend-delivery.json', extra: checkpoint ? ['--checkpoint', checkpoint] : [] });
    if (verdict.exitCode !== 0) { process.stderr.write(`${JSON.stringify({ result: 'blocked', error: verdict.message })}\n`); process.exitCode = verdict.exitCode; }
    else {
      const coverage = verdict.envelope.result.coverage;
      const keys = [...RESULT_ORDER.filter((key) => key in coverage), ...Object.keys(coverage).filter((key) => !RESULT_ORDER.includes(key))];
      process.stdout.write(`${JSON.stringify(Object.fromEntries(keys.map((key) => [key, coverage[key]])), null, 2)}\n`);
    }
  } else if (positionals[0] === 'complete' && values.input) {
    const { completeBackendDelivery } = await import('./lib/backend-delivery-terminal.mjs');
    const { parse } = await import('./lib/strategic-handoff-io.mjs');
    result = await completeBackendDelivery(root, parse(readFileSync(values.input)), {checkpointRef: values.checkpoint});
    process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  } else throw new TypeError('需要 complete 或 verify 及匹配参数');
} catch (error) { process.stderr.write(`${JSON.stringify({ result: 'blocked', error: error.message })}\n`); process.exitCode = 1; }
