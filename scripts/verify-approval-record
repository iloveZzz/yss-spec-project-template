#!/usr/bin/env node
import { parseArgs } from "node:util";
import { validateApprovalRecordFile } from "./lib/approval-record.mjs";

try {
  const { positionals } = parseArgs({ allowPositionals: true, strict: true });
  if (positionals.length !== 1) throw new TypeError("用法: scripts/verify-approval-record <approval-record.yaml>");
  validateApprovalRecordFile(positionals[0]);
  process.stdout.write("会签记录校验通过\n");
} catch (error) {
  process.stderr.write(`会签记录校验失败: ${error.message}\n`);
  process.exitCode = 1;
}
