shared.push('.template-spec/process/schemas/digital-human-task-package.schema.json','scripts/lib/maintenance-candidate.mjs','scripts/lib/first-slice-artifacts.mjs','scripts/lib/first-slice-tests.mjs','scripts/lib/slice-repositories.mjs','scripts/lib/slice-applicability.mjs','scripts/lib/slice-contract.mjs','.template-spec/process/schemas/slice-implementation-contract-v3.schema.json');
shared.push('scripts/instantiate-harness','scripts/backend-delivery','scripts/verify-frontend-delivery','scripts/verify-frontend-strategic-preflight','scripts/strategic-feedback','scripts/verify-strategic-handoff-tools-lock','scripts/lib/backend-delivery.mjs','scripts/lib/frontend-delivery.mjs','scripts/lib/frontend-delivery-boundary.mjs','scripts/lib/strategic-feedback.mjs','.template-spec/process/frontend-backend-delivery.md','.template-spec/process/schemas/backend-delivery.schema.json','.template-spec/process/schemas/backend-delivery-verification.schema.json','.template-spec/process/schemas/frontend-delivery-acceptance.schema.json','.template-spec/process/schemas/frontend-delivery-acceptance-v1.schema.json','.template-spec/process/schemas/frontend-strategic-preflight.schema.json','.template-spec/process/schemas/strategic-design-handoff-v3.schema.json','.template-spec/process/schemas/strategic-design-handoff-v4.schema.json','.template-spec/process/schemas/strategic-consumer-feedback.schema.json','.template-spec/process/schemas/strategic-feedback-adjudication.schema.json');
// Existing-project evidence is wire validation, not scaffold/prototype authoring capability.
shared.push('scripts/lib/approved-execution-context.mjs','scripts/fixtures/backend-delivery/approval-fixture.mjs',...readdirSync(path.join(root,'scripts/fixtures/delivery-preflight')).map(ref=>`scripts/fixtures/delivery-preflight/${ref}`),'scripts/fixtures/existing-backend/fixture.mjs','scripts/preflight-delivery','scripts/verify-delivery-preflight-scenarios','scripts/verify-existing-ui-baseline-scenarios','scripts/lib/delivery-preflight.mjs','scripts/lib/backend-architecture.mjs','scripts/lib/existing-backend-architecture.mjs','scripts/lib/ui-baseline.mjs','scripts/lib/existing-ui-baseline.mjs','.template-spec/process/delivery-preflight.md','.template-spec/process/existing-backend-architecture.md','.template-spec/process/existing-ui-baseline.md','.template-spec/process/schemas/delivery-preflight-input.schema.json','.template-spec/process/schemas/delivery-preflight-result.schema.json','.template-spec/process/schemas/backend-architecture-identity.schema.json','.template-spec/process/schemas/lifecycle-checkpoint.schema.json','.template-spec/process/schemas/existing-ui-baseline.schema.json','.template-spec/process/schemas/strategic-design-handoff-v5.schema.json','.template-spec/process/schemas/frontend-strategic-preflight-v2.schema.json','.template-spec/process/schemas/frontend-delivery-acceptance-v3.schema.json',...readdirSync(path.join(root,'scripts/fixtures/existing-ui-baseline')).map(ref=>`scripts/fixtures/existing-ui-baseline/${ref}`));
let differences=[];
// 专职执行范围由各模板持有；后端只消费 wire 校验器，不恢复原型构建技能。
function replaceExactly(bytes,from,to,name){const content=bytes.toString();const count=content.split(from).length-1;if(count!==1)throw new Error(`${name} 转换基线失效，预期 1 处，实际 ${count} 处`);return Buffer.from(content.replace(from,to));}
const visualSource='.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs',visualWire='scripts/lib/visual-baseline-contract.mjs';
const transformations={
 'backend-wire-library':bytes=>replaceExactly(replaceExactly(bytes,'../../../../scripts/vendor/yaml.mjs','../vendor/yaml.mjs','backend-wire-yaml'),'../../../../scripts/lib/validation-phase.mjs','./validation-phase.mjs','backend-wire-phase'),
 identity:bytes=>bytes,
 'backend-wire-runtime':bytes=>replaceExactly(bytes,'../../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','./visual-baseline-contract.mjs','backend-wire-runtime'),
 'backend-wire-command':bytes=>replaceExactly(bytes,'../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','./lib/visual-baseline-contract.mjs','backend-wire-command'),
 'backend-wire-fixture':bytes=>replaceExactly(bytes,'../../../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','../../lib/visual-baseline-contract.mjs','backend-wire-fixture'),
};
function transformationFor(target,ref){if(!target.endsWith('yss-harness-backend-agent'))return'identity';if(['scripts/lib/ui-baseline.mjs','scripts/lib/delivery-preflight.mjs'].includes(ref))return'backend-wire-runtime';if(['scripts/verify-strategic-context-import-scenarios','scripts/verify-frontend-implementation-evidence'].includes(ref))return'backend-wire-command';if(ref==='scripts/fixtures/strategic-handoff/fixture.mjs')return'backend-wire-fixture';return'identity';}
function sync(source,dest,transformation='identity'){const bytes=transformations[transformation](readFileSync(source));if(!existsSync(dest)||!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check){mkdirSync(path.dirname(dest),{recursive:true});writeFileSync(dest,bytes);}}if(!check&&path.basename(path.dirname(dest))==='scripts'&&!path.extname(dest))chmodSync(dest,0o755);}
const digestBytes=bytes=>`sha256:${createHash('sha256').update(bytes).digest('hex')}`;
shared.push('scripts/lib/lifecycle-execution-scope.mjs');
shared.push('scripts/inspect-skill-discovery','scripts/lib/skill-discovery.mjs');
// Diagnostic-only content inspection: shared authoring format, no lifecycle gate.
shared.push('scripts/vendor/yaml.mjs','scripts/vendor/manifest.json','scripts/vendor/NOTICES.md');
shared.push('scripts/inspect-plan-spec','scripts/lib/plan-spec-markdown.mjs','scripts/lib/plan-spec-quality.mjs','scripts/vendor/markdown.mjs','.template-spec/process/plan-spec-quality.md','.template-spec/plan/templates/plan-template.md','.template-spec/templates/spec-template.md','.template-spec/templates/spec-delta-template.md',...readdirSync(path.join(root,'.template-spec/templates/examples/plan-spec')).map(name=>`.template-spec/templates/examples/plan-spec/${name}`));
shared.push('scripts/stage-tracking','scripts/lib/stage-tracking.mjs','scripts/lib/stage-tracking-migration.mjs','.template-spec/process/stage-tracking.md','.template-spec/process/schemas/stage-tracking.schema.json');
shared.push('scripts/contract','scripts/api-contract-decision','scripts/lib/contract-views.mjs','scripts/lib/contract-source.mjs','scripts/lib/validation-phase.mjs','scripts/lib/slice-contract-views.mjs','scripts/lib/api-contract-decision.mjs','scripts/lib/openapi-draft-validation.mjs','.template-spec/process/schemas/api-contract-decision.schema.json','.template-spec/process/schemas/api-contract-decision-v2.schema.json','.template-spec/process/schemas/openapi-draft-validation-record.schema.json','.template-spec/process/contract-reading.md');
shared.push('scripts/prepare-read-only-intake','scripts/run-read-only-intake','scripts/lib/read-only-intake.mjs','scripts/lib/task-package-schema.mjs','scripts/lib/harness-execution-scope.mjs','scripts/verify-digital-human-task-package','.template-spec/process/subagent-collaboration.md');
// Read-only wire schemas do not grant the stage-decision authoring capability.
for(const kind of ['domain-strategy','stage-decision-package']){
 const source=path.join(root,`.agents/skills/yss-stage-decision/references/${kind}.schema.json`),dest=path.join(root,`.template-spec/process/schemas/${kind}-reading.schema.json`);
 sync(source,dest);
 shared.push(`.template-spec/process/schemas/${kind}-reading.schema.json`);
}
shared.push(...readdirSync(path.join(root,'scripts/lib')).filter(x=>x.startsWith('reading-view-')).map(x=>`scripts/lib/${x}`),'.template-spec/process/reading-policy.yaml','.template-spec/process/schemas/reading-policy.schema.json','.template-spec/process/schemas/reading-manifest.schema.json');
// Generated wire policy retains only checkpoint evidence rules; lifecycle authority stays canonical.
const checkpointContract=parseDocument(readFileSync(path.join(root,'.agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml'),'utf8')).toJS();
const checkpointWire='.template-spec/process/checkpoint-boundary.yaml';
const checkpointBytes=Buffer.from(JSON.stringify({schema_version:1,derived_from:'.agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml',phase_boundary:checkpointContract.phase_boundary,checkpoint_policy:checkpointContract.checkpoint_policy},null,2)+'\n');
if(!existsSync(path.join(root,checkpointWire))||!checkpointBytes.equals(readFileSync(path.join(root,checkpointWire)))){differences.push(checkpointWire);if(!check)writeFileSync(path.join(root,checkpointWire),checkpointBytes);}
shared.push('scripts/verify-context-contract','scripts/verify-approval-record',checkpointWire,'scripts/project-ci','scripts/project-ci-transition','scripts/lib/project-ci-install.mjs','scripts/lib/project-governance.mjs','scripts/lib/governance-io.mjs','scripts/lib/checkpoint-boundary.mjs','scripts/lifecycle-status','scripts/lib/lifecycle-status.mjs','.template-spec/process/project-ci.md');
shared.push('scripts/verify-business-tickets','scripts/lib/business-tickets.mjs','scripts/lib/business-ticket-lifecycle.mjs','.template-spec/process/business-tickets.md','.template-spec/process/schemas/business-tickets-v1.schema.json','.template-spec/templates/business-ticket-template.md','.template-spec/templates/business-ticket-set-template.yaml','.template-spec/templates/business-ticket-review-template.yaml',...readdirSync(path.join(root,'scripts/fixtures/business-tickets')).map(name=>`scripts/fixtures/business-tickets/${name}`));
shared.push('scripts/feature-assets','scripts/lib/feature-assets.mjs','.template-spec/process/feature-assets.md','.template-spec/templates/local-parent-ticket-template.md');
const sharedRefs=[...new Set(shared)].sort();
const sliceExecutionRefs=['scripts/generate-yss-skill-boundaries','scripts/lib/backend-delivery-terminal.mjs','scripts/complete-backend-delivery','scripts/dispatch-slice-task','scripts/lib/backend-standards-coverage.mjs','scripts/backend-standards-coverage','scripts/lib/backend-review.mjs','scripts/lib/slice-execution-preflight.mjs','scripts/slice-contract','scripts/lib/slice-contract-preparation.mjs','scripts/lib/slice-contract-views.mjs','scripts/lib/slice-task-package.mjs','scripts/lib/implementation-contract-compiler.mjs','scripts/lib/skill-registry.mjs','scripts/lib/skill-supply-chain.mjs','scripts/lib/technical-design-boundary.mjs'];
const backendPlatformRefs=['scripts/verify-backend-platform-matrix','scripts/fixtures/backend-scaffold/generate-candidate.mjs','scripts/fixtures/backend-scaffold/platform-scenarios.test.mjs','scripts/verify-scaffold-architecture-decision-scenarios','scripts/verify-scaffold-generator-scenarios'];
const routingContractRef='.agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml';
sliceExecutionRefs.push('scripts/lib/execution-evidence.mjs');
sliceExecutionRefs.push('scripts/verify-frontend-implementation-evidence','.template-spec/process/schemas/frontend-implementation-evidence.schema.json','.template-spec/process/templates/frontend-implementation-verification-template.yaml');
const routingSource=readFileSync(path.join(root,routingContractRef));
const consumerRoutes=parseDocument(routingSource.toString(),{uniqueKeys:true}).toJS({maxAliasCount:0}).consumer_entry_routes;
if(!consumerRoutes)throw new Error('源主控缺少 consumer_entry_routes');
function targetRoutingRef(targetRoot){return targetRoot===root?routingContractRef:targetRoot.endsWith('design-agent')?'.agents/skills/yss-strategic-design/references/orchestration-contract.yaml':'.agents/skills/harness-orchestrator/references/orchestration-contract.yaml';}
function projectedRouting(targetRoot){
 const bytes=readFileSync(path.join(targetRoot,targetRoutingRef(targetRoot))),document=parseDocument(bytes.toString(),{uniqueKeys:true});
 if(document.errors.length)throw new Error('目标主控不可读');
 if(JSON.stringify(document.toJS({maxAliasCount:0}).consumer_entry_routes)===JSON.stringify(consumerRoutes))return bytes;
 document.set('consumer_entry_routes',consumerRoutes);return Buffer.from(document.toString());
}
function syncRouting(targetRoot){const dest=path.join(targetRoot,targetRoutingRef(targetRoot)),bytes=projectedRouting(targetRoot);if(!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}}
const registryRef='.template-spec/agents/yss-skill-registry.yaml';
const sourceRegistry=parseDocument(readFileSync(path.join(root,registryRef),'utf8'),{uniqueKeys:true});
if(sourceRegistry.errors.length)throw new Error('源技能注册表不可读');
const existingProfiles=sourceRegistry.toJS({maxAliasCount:0}).existing_project_profiles;
if(!existingProfiles||typeof existingProfiles!=='object'||Array.isArray(existingProfiles))throw new Error('源注册表缺少 existing_project_profiles');
// Only observation profiles are projected. Recipes, capabilities and authoring skills remain profile-owned.
function projectedRegistry(targetRoot){
 const bytes=readFileSync(path.join(targetRoot,registryRef));
 const document=parseDocument(bytes.toString(),{uniqueKeys:true});if(document.errors.length)throw new Error(`${targetRoot} 技能注册表不可读`);
 if(JSON.stringify(document.toJS({maxAliasCount:0}).existing_project_profiles)===JSON.stringify(existingProfiles))return bytes;
 document.set('existing_project_profiles',existingProfiles);return Buffer.from(document.toString());
}
function syncExistingProfiles(targetRoot){const dest=path.join(targetRoot,registryRef),bytes=projectedRegistry(targetRoot);if(!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}}

const revision=spawnSync('git',['-C',root,'rev-parse','HEAD'],{encoding:'utf8'}).stdout.trim();
const scopedState=spawnSync('git',['-C',root,'status','--porcelain=v1','--untracked-files=all','--','scripts/sync-strategic-handoff-tools',registryRef,routingContractRef,visualSource,...sharedRefs,...sliceExecutionRefs,...backendPlatformRefs],{encoding:'utf8'}).stdout.trim();
const sourceState=scopedState?'working-tree':'committed';
function expectedLock(target,targetRoot){
 const lockedRefs=[...new Set([...sharedRefs,...(target==='.'||!target.endsWith('design-agent')?sliceExecutionRefs:[]),...(target==='.'||target.endsWith('backend-agent')?backendPlatformRefs:[])])].sort();
 const sourceFiles=Object.fromEntries(lockedRefs.map(ref=>[ref,digestBytes(readFileSync(path.join(root,ref)))]));
 const effectiveFiles=Object.fromEntries(lockedRefs.map(ref=>[ref,digestBytes(transformations[transformationFor(target,ref)](readFileSync(path.join(root,ref))))]));
 if(target.endsWith('backend-agent')){sourceFiles[visualSource]=digestBytes(readFileSync(path.join(root,visualSource)));effectiveFiles[visualWire]=digestBytes(transformations['backend-wire-library'](readFileSync(path.join(root,visualSource))));}
 sourceFiles[routingContractRef]=digestBytes(routingSource);
 effectiveFiles[targetRoutingRef(targetRoot)]=digestBytes(target==='.'?routingSource:projectedRouting(targetRoot));
 sourceFiles[registryRef]=digestBytes(readFileSync(path.join(root,registryRef)));
 effectiveFiles[registryRef]=digestBytes(target==='.'?readFileSync(path.join(root,registryRef)):projectedRegistry(targetRoot));
 return {schema_version:1,target_id:target==='.'?'template-root':path.basename(target),source_repository:'yss-spec-project-template',source_revision:revision,source_state:sourceState,transformation_set:[...new Set([...lockedRefs.map(ref=>transformationFor(target,ref)),...(target.endsWith('backend-agent')?['backend-wire-library']:[])])].sort(),source_files:sourceFiles,effective_files:effectiveFiles};
}
function lock(target,targetRoot){const ref='.template-source/distribution/strategic-handoff-tools.lock.json',dest=path.join(targetRoot,ref),bytes=Buffer.from(`${JSON.stringify(expectedLock(target,targetRoot),null,2)}\n`);if(!existsSync(dest)||!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check){mkdirSync(path.dirname(dest),{recursive:true});writeFileSync(dest,bytes);}}}
// CLI core owns the portable external-command runner. Only create-yss-spec still consumes
// the legacy src copy; the three thin subproject CLIs use their official sync-core command.
sync(path.join(root,'.template-source/cli-core/command-runner.mjs'),path.join(root,'scripts/lib/command-runner.mjs'));
lock('.',root);
for(const name of ['create-yss-spec']) {
 const target=`submodules/${name}`;
 if(!existsSync(path.join(root,target,'.git')))continue;
 if(!check){const state=inspectWorkingTreeScope(root,{project_root:target,repository_scope:'git-submodule',checkout_state:'attached-branch'});if(!state.writable)throw new Error(`${target}: ${state.violation}`);}
 sync(path.join(root,'.template-source/cli-core/command-runner.mjs'),path.join(root,target,'src/command-runner.mjs'));
}
for(const target of targets){
 if(!existsSync(path.join(root,target,'.git')))continue;
 if(!check){const state=inspectWorkingTreeScope(root,{project_root:target,repository_scope:'git-submodule',checkout_state:'attached-branch'});if(!state.writable)throw new Error(`${target}: ${state.violation}`);}
 if(!target.endsWith('design-agent'))for(const ref of sliceExecutionRefs)sync(path.join(root,ref),path.join(root,target,ref),transformationFor(target,ref));
 if(!target.endsWith('design-agent'))for(const ref of ['scripts/verify-frontend-delivery-scenarios','scripts/fixtures/backend-delivery/revision-server.mjs'])sync(path.join(root,ref),path.join(root,target,ref));
 if(target.endsWith('backend-agent'))for(const ref of ['scripts/fixtures/existing-backend/scenarios.test.mjs','scripts/verify-existing-backend-architecture-scenarios','scripts/lib/implementation-contract-compiler.mjs','scripts/lib/technical-design-boundary.mjs',...backendPlatformRefs])sync(path.join(root,ref),path.join(root,target,ref));
 if(target.endsWith('backend-agent'))sync(path.join(root,visualSource),path.join(root,target,visualWire),'backend-wire-library');
 syncExistingProfiles(path.join(root,target));
 syncRouting(path.join(root,target));
 for(const ref of new Set(shared))sync(path.join(root,ref),path.join(root,target,ref),transformationFor(target,ref));
 lock(target,path.join(root,target));
}
if(check&&differences.length){process.stderr.write(`交接工具同步漂移: ${differences.join(', ')}\n`);process.exitCode=1;}else process.stdout.write(`战略交接共享工具 ${check?'同步检查通过':`同步 ${differences.length} 文件`}\n`);
