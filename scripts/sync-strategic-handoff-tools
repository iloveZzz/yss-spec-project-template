function targetRoutingRef(targetRoot){return targetRoot===root?routingContractRef:targetRoot.endsWith('design-agent')?'.agents/skills/yss-strategic-design/references/orchestration-contract.yaml':'.agents/skills/harness-orchestrator/references/orchestration-contract.yaml';}
function projectedRouting(targetRoot){
 const bytes=readFileSync(path.join(targetRoot,targetRoutingRef(targetRoot))),document=parseDocument(bytes.toString(),{uniqueKeys:true});
 if(document.errors.length)throw new Error('目标主控不可读');
 const current=document.toJS({maxAliasCount:0});
 const planReview=checkpointContract.planning?.review_control;
 if(!planReview)throw new Error('源主控缺少 Plan 收敛协议');
 const planReviewChanged=JSON.stringify(current.planning?.review_control)!==JSON.stringify(planReview);
 const checkpointChanged=['phase_boundary','checkpoint_policy'].some(key=>JSON.stringify(current[key])!==JSON.stringify(checkpointContract[key]));
 const progress={...userProgressReport,owner:targetRoot.endsWith('design-agent')?'yss-strategic-design':'harness-orchestrator',reference:userProgressReport.writing_reference};
 if(JSON.stringify(current.request_triage)===JSON.stringify(checkpointContract.request_triage)&&!planReviewChanged&&!checkpointChanged&&JSON.stringify(current.consumer_entry_routes)===JSON.stringify(consumerRoutes)&&JSON.stringify(current.skill_preflight)===JSON.stringify(skillPreflight)&&JSON.stringify(current.user_progress_report)===JSON.stringify(progress)&&JSON.stringify(current.profile_guidance)===JSON.stringify(profileGuidance))return bytes;
 for(const key of ['phase_boundary','checkpoint_policy'])document.set(key,checkpointContract[key]);
 document.setIn(['planning','review_control'],planReview);
 document.set('request_triage',checkpointContract.request_triage);
 document.set('consumer_entry_routes',consumerRoutes);
 document.set('skill_preflight',skillPreflight);
 document.set('user_progress_report',progress);
 document.set('profile_guidance',profileGuidance);
 return Buffer.from(document.toString());
}
function syncRouting(targetRoot){const dest=path.join(targetRoot,targetRoutingRef(targetRoot)),bytes=projectedRouting(targetRoot);if(!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}}
function syncBusinessDecisions(targetRoot){
 if(targetRoot.endsWith('design-agent'))return;
 const ref='.template-spec/agents/digital-human-roles.yaml',dest=path.join(targetRoot,ref),document=parseDocument(readFileSync(dest,'utf8'));
 const canonical=parseDocument(readFileSync(path.join(root,ref),'utf8')).toJS().user_decision_policy;
 const registry=parseDocument(readFileSync(path.join(targetRoot,'.template-spec/process/lifecycle-registry.yaml'),'utf8')).toJS();
 const gates=new Set(registry.gates.map(x=>x.id)),units=new Set(registry.work_units.map(x=>x.id));
 const policy={...canonical,gates:canonical.gates.filter(id=>gates.has(id)),work_units:Object.fromEntries(Object.entries(canonical.work_units).filter(([id])=>units.has(id))),work_unit_gates:Object.fromEntries(Object.entries(canonical.work_unit_gates).filter(([id])=>units.has(id)).map(([id,ids])=>[id,ids.filter(x=>gates.has(x))])),continuation:{...canonical.continuation,boundaries:canonical.continuation.boundaries.filter(id=>gates.has(id)||id==='implementation-scope')}};
 if(JSON.stringify(document.toJS().user_decision_policy)===JSON.stringify(policy))return;
 document.set('user_decision_policy',policy);differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,document.toString());
}
function syncOwnerPreflight(targetRoot){
 const owner=targetRoot.endsWith('design-agent')?'yss-strategic-design':'harness-orchestrator';
 const ref='.agents/skills/'+owner+'/SKILL.md',dest=path.join(targetRoot,ref),marker='<!-- SKILL_PREFLIGHT_ROUTE -->';
 const guidance=marker+'\n专项技能调用前，运行 `scripts/query-lifecycle-context --work-unit <当前工作单元> --check-skills`；多运行时指定 `--agent-runtime`，条件用 `--when`。按合同 `skill_preflight` 处理缺失、漂移与冲突，在既有授权内核对补装计划、应用后重验。预检不授予执行或批准。Matt 上游为 https://github.com/mattpocock/skills，生效版本以根 `skills-lock.json` 为准。\n';
 const old=readFileSync(dest,'utf8'),pattern=new RegExp(marker+'\\n[^\\n]*(?:\\n|$)');
 if(old.includes(marker)&&!pattern.test(old))throw new Error('技能预检路由标记内容不明: '+dest);
 const bytes=Buffer.from(old.includes(marker)?old.replace(pattern,guidance):old.trimEnd()+'\n\n'+guidance);
 if(!bytes.equals(Buffer.from(old))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}
}
function syncOwnerProgress(targetRoot){
 const owner=targetRoot.endsWith('design-agent')?'yss-strategic-design':'harness-orchestrator';
 const ref='.agents/skills/'+owner+'/SKILL.md',dest=path.join(targetRoot,ref),marker='<!-- USER_PROGRESS_REPORT -->';
 const guidance=marker+'\n每轮返回或暂停按合同 `user_progress_report` 给出中文状态：当前阶段与本轮结果、下一阶段/单元与进入条件、问题/阻塞、已登记责任方、解除动作及复验、主控下一动作与用户待决定项。未知写“待核验”，负责人缺失写“未登记”；目标不代表批准，已授权工作继续执行。发送前核对证据、状态及结构化结果一致；写法见 `.template-spec/process/document-writing.md`。\n';
 const old=readFileSync(dest,'utf8'),pattern=new RegExp(marker+'\\n[^\\n]*(?:\\n|$)');
 if(old.includes(marker)&&!pattern.test(old))throw new Error('状态输出路由标记内容不明: '+dest);
 const bytes=Buffer.from(old.includes(marker)?old.replace(pattern,guidance):old.trimEnd()+'\n\n'+guidance);
 if(!bytes.equals(Buffer.from(old))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}
}
function syncOwnerProfileGuidance(targetRoot){
 const owner=targetRoot.endsWith('design-agent')?'yss-strategic-design':'harness-orchestrator';
 const ref='.agents/skills/'+owner+'/SKILL.md',dest=path.join(targetRoot,ref),marker='<!-- PROFILE_GUIDANCE -->';
 const guidance=marker+'\n当前职责完成、状态查询或恢复时，消费合同 `profile_guidance` 与 `yss lifecycle status --root <当前工程> --checkpoint <当前checkpoint>` 给出下游 Profile 建议；不按邻近目录猜初始化状态。Spec 默认继续当前职责；没有当前战略交接时，可经用户明确选择交给独立 Design。Spec 或 Design 已形成经核验的当前战略交接后，按消费者路由建议 Backend、Frontend 或同时准备，两者仍在独立目录执行；设计完成声明不能替代交接及来源批准，显式交接失效时先解除阻断。目标 Design 接入已批准 Spec 走 `spec-baseline` 冻结包与 Receipt、目标 Context 对账后从设计继续，不重走 Plan，不复制源 checkpoint 批准到目标；目标 Backend / Frontend 使用战略接收记录及各自消费合同。建议不改变当前工作单元、不授予批准或执行，下游推荐不扩展本 Profile 的实现写范围。\n';
 const old=readFileSync(dest,'utf8'),pattern=new RegExp(marker+'\\n[^\\n]*(?:\\n|$)');
 const bytes=Buffer.from(old.includes(marker)?old.replace(pattern,guidance):old.trimEnd()+'\n\n'+guidance);
 if(!bytes.equals(Buffer.from(old))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}
}
function syncOwnerPlanReview(targetRoot){
 if(!targetRoot.endsWith('design-agent'))return;
 const dest=path.join(targetRoot,'.agents/skills/yss-strategic-design/SKILL.md'),marker='<!-- PLAN_REVIEW_CONTROL -->';
 const guidance=marker+'\nPlan 专业审查按当前主控合同 `planning.review_control` 和 checkpoint `plan_review_control` 执行；准备、派发、消费和恢复均核验原周期及本轮检查范围。聚合复用内部结论，诊断不默认请求用户；关键决定与最终 Plan 批准展示当前资产后取得同一次真实回复。工具与受控历史接入见 `.template-spec/plan/entry-review.md`。\n';
 const old=readFileSync(dest,'utf8'),pattern=new RegExp(marker+'\\n[^\\n]*(?:\\n|$)');
 if(old.includes(marker)&&!pattern.test(old))throw new Error('Plan 收敛路由标记内容不明: '+dest);
 const bytes=Buffer.from(old.includes(marker)?old.replace(pattern,guidance):old.trimEnd()+'\n\n'+guidance);
 if(!bytes.equals(Buffer.from(old))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}
}
const registryRef='.template-spec/agents/yss-skill-registry.yaml';
const sourceRegistry=parseDocument(readFileSync(path.join(root,registryRef),'utf8'),{uniqueKeys:true});
if(sourceRegistry.errors.length)throw new Error('源技能注册表不可读');
const existingProfiles=sourceRegistry.toJS({maxAliasCount:0}).existing_project_profiles;
if(!existingProfiles||typeof existingProfiles!=='object'||Array.isArray(existingProfiles))throw new Error('源注册表缺少 existing_project_profiles');
// Only observation profiles are projected. Recipes, capabilities and authoring skills remain profile-owned.
function projectedRegistry(targetRoot){
 const bytes=readFileSync(path.join(targetRoot,registryRef));
 const document=parseDocument(bytes.toString(),{uniqueKeys:true});if(document.errors.length)throw new Error(`${targetRoot} 技能注册表不可读`);
 if(JSON.stringify(document.toJS({maxAliasCount:0}).existing_project_profiles)===JSON.stringify(existingProfiles))return bytes;
 document.set('existing_project_profiles',existingProfiles);return Buffer.from(document.toString());
}
function syncExistingProfiles(targetRoot){const dest=path.join(targetRoot,registryRef),bytes=projectedRegistry(targetRoot);if(!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check)writeFileSync(dest,bytes);}}

const revision=spawnSync('git',['-C',root,'rev-parse','HEAD'],{encoding:'utf8'}).stdout.trim();
const scopedState=spawnSync('git',['-C',root,'status','--porcelain=v1','--untracked-files=all','--','scripts/sync-strategic-handoff-tools','.template-source/cli-core/runtime-store.mjs','.template-source/cli-core/work-layout.mjs',registryRef,routingContractRef,visualSource,...sharedRefs,...sliceExecutionRefs,...backendPlatformRefs],{encoding:'utf8'}).stdout.trim();
const sourceState=scopedState?'working-tree':'committed';
function expectedLock(target,targetRoot){
 const lockedRefs=[...new Set([...sharedRefs,...(target==='.'||!target.endsWith('design-agent')?sliceExecutionRefs:[]),...(target==='.'||target.endsWith('backend-agent')?backendPlatformRefs:[])])].sort();
 const sourceFiles=Object.fromEntries(lockedRefs.map(ref=>[ref,digestBytes(readFileSync(path.join(root,ref)))]));
 const effectiveFiles=Object.fromEntries(lockedRefs.map(ref=>[ref,digestBytes(transformations[transformationFor(target,ref)](readFileSync(path.join(root,ref))))]));
 if(target.endsWith('backend-agent')){sourceFiles[visualSource]=digestBytes(readFileSync(path.join(root,visualSource)));effectiveFiles[visualWire]=digestBytes(transformations['backend-wire-library'](readFileSync(path.join(root,visualSource))));}
 sourceFiles[routingContractRef]=digestBytes(routingSource);
 effectiveFiles[targetRoutingRef(targetRoot)]=digestBytes(target==='.'?routingSource:projectedRouting(targetRoot));
 sourceFiles[registryRef]=digestBytes(readFileSync(path.join(root,registryRef)));
 effectiveFiles[registryRef]=digestBytes(target==='.'?readFileSync(path.join(root,registryRef)):projectedRegistry(targetRoot));
 return {schema_version:1,target_id:target==='.'?'template-root':path.basename(target),source_repository:'yss-spec-project-template',source_revision:revision,source_state:sourceState,transformation_set:[...new Set([...lockedRefs.map(ref=>transformationFor(target,ref)),...(target.endsWith('backend-agent')?['backend-wire-library']:[])])].sort(),source_files:{...sourceFiles,'.template-source/cli-core/native-context.mjs':digestBytes(readFileSync(path.join(root,'.template-source/cli-core/native-context.mjs'))),'.template-source/cli-core/runtime-store.mjs':digestBytes(readFileSync(path.join(root,'.template-source/cli-core/runtime-store.mjs'))),'.template-source/cli-core/work-layout.mjs':digestBytes(readFileSync(path.join(root,'.template-source/cli-core/work-layout.mjs')))},effective_files:effectiveFiles};
}
function lock(target,targetRoot){const ref='.template-source/distribution/strategic-handoff-tools.lock.json',dest=path.join(targetRoot,ref),bytes=Buffer.from(`${JSON.stringify(expectedLock(target,targetRoot),null,2)}\n`);if(!existsSync(dest)||!bytes.equals(readFileSync(dest))){differences.push(path.relative(root,dest));if(!check){mkdirSync(path.dirname(dest),{recursive:true});writeFileSync(dest,bytes);}}}
// Shared Node governance modules remain independently maintained after CLI retirement.
sync(path.join(root,'.template-source/cli-core/command-runner.mjs'),path.join(root,'scripts/lib/command-runner.mjs'));
lock('.',root);
for(const target of rootOnly?[]:targets){
 if(!existsSync(path.join(root,target,'.git')))continue;
 if(!check){const state=inspectWorkingTreeScope(root,{project_root:target,repository_scope:'git-submodule',checkout_state:'attached-branch'});if(!state.writable)throw new Error(`${target}: ${state.violation}`);}
 if(!target.endsWith('design-agent'))for(const ref of sliceExecutionRefs)sync(path.join(root,ref),path.join(root,target,ref),transformationFor(target,ref));
 if(target.endsWith('backend-agent'))for(const ref of ['scripts/fixtures/existing-backend/scenarios.test.mjs','tests/scenarios/verify-existing-backend-architecture-scenarios.mjs','scripts/lib/implementation-contract-compiler.mjs','scripts/lib/technical-design-boundary.mjs',...backendPlatformRefs])sync(path.join(root,ref),path.join(root,target,ref));
 if(target.endsWith('backend-agent'))sync(path.join(root,visualSource),path.join(root,target,visualWire),'backend-wire-library');
 syncExistingProfiles(path.join(root,target));
 syncRouting(path.join(root,target));
 syncBusinessDecisions(path.join(root,target));
 syncOwnerPreflight(path.join(root,target));
 syncOwnerProgress(path.join(root,target));
 syncOwnerProfileGuidance(path.join(root,target));
 syncOwnerPlanReview(path.join(root,target));
 for(const ref of new Set(shared))sync(path.join(root,ref),path.join(root,target,ref),transformationFor(target,ref));
 lock(target,path.join(root,target));
}
if(check&&differences.length){process.stderr.write(`交接工具同步漂移: ${differences.join(', ')}\n`);process.exitCode=1;}else process.stdout.write(`战略交接共享工具 ${check?'同步检查通过':`同步 ${differences.length} 文件`}\n`);
