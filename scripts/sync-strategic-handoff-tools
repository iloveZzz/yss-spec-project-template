 'implementation-query-runtime':bytes=>replaceExactly(replaceExactly(bytes,'.agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml','.agents/skills/harness-orchestrator/references/orchestration-contract.yaml','implementation-query-runtime'),"const QUERY_PROFILE = 'lifecycle';","const QUERY_PROFILE = 'specialist';",'implementation-query-profile'),
 'backend-wire-library':bytes=>replaceExactly(replaceExactly(bytes,'../../../../scripts/vendor/yaml.mjs','../vendor/yaml.mjs','backend-wire-yaml'),'../../../../scripts/lib/validation-phase.mjs','./validation-phase.mjs','backend-wire-phase'),
 identity:bytes=>bytes,
 'backend-wire-runtime':bytes=>replaceExactly(bytes,'../../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','./visual-baseline-contract.mjs','backend-wire-runtime'),
 'backend-wire-scenario':bytes=>replaceExactly(bytes,'../../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','../../scripts/lib/visual-baseline-contract.mjs','backend-wire-scenario'),
 'backend-wire-command':bytes=>replaceExactly(bytes,'../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','./lib/visual-baseline-contract.mjs','backend-wire-command'),
 'backend-wire-fixture':bytes=>replaceExactly(bytes,'../../../.agents/skills/yss-prototype-stage/scripts/visual-baseline-contract.mjs','../../lib/visual-baseline-contract.mjs','backend-wire-fixture'),
 'profile-vendor-tooling':bytes=>replaceExactly(bytes,'node scripts/test-with-plugin-clis.mjs test/**/*.test.mjs','node --test test/**/*.test.mjs','profile-vendor-tooling'),
};
function transformationFor(target,ref){
 if(target!=='.'&&ref==='.template-source/tooling/node/package.json')return'profile-vendor-tooling';
 if(target!=='.'&&ref==='scripts/lib/lifecycle-context-query.mjs')return target.endsWith('design-agent')?'design-query-runtime':'implementation-query-runtime';
 if(!target.endsWith('yss-harness-backend-agent'))return'identity';
 if(['scripts/lib/ui-baseline.mjs','scripts/lib/delivery-preflight.mjs'].includes(ref))return'backend-wire-runtime';
 if(ref==='tests/scenarios/verify-strategic-context-import-scenarios.mjs')return'backend-wire-scenario';
 if(ref==='scripts/verify-frontend-implementation-evidence')return'backend-wire-command';
 if(ref==='scripts/fixtures/strategic-handoff/fixture.mjs')return'backend-wire-fixture';
 return'identity';
}
