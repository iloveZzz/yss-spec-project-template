#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""验证 YSS 后端脚手架生成器的受控生成边界。"""

from __future__ import annotations

import subprocess
import sys
import tempfile
import json
import os
import hashlib
from pathlib import Path


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
GENERATOR = (
    REPOSITORY_ROOT
    / ".agents"
    / "skills"
    / "yss-ddd-scaffold-generator"
    / "scripts"
    / "generate_scaffold.mjs"
)
VERIFIER = (
    REPOSITORY_ROOT
    / ".agents"
    / "skills"
    / "yss-ddd-scaffold-generator"
    / "scripts"
    / "run_scaffold_verification.mjs"
)
WORKFLOW = (
    REPOSITORY_ROOT
    / ".agents"
    / "skills"
    / "yss-ddd-scaffold-generator"
    / "scripts"
    / "generate_and_verify_scaffold.mjs"
)


def run_generator(*arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["node", str(GENERATOR), *arguments],
        cwd=REPOSITORY_ROOT,
        text=True,
        capture_output=True,
        check=False,
    )


def require(condition: bool, message: str) -> None:
    if not condition:
        raise AssertionError(message)


def write_contract(
    path: Path,
    output_root: Path,
    project_name: str,
    contract_id: str,
    approval_ref: str,
    compiler_draft_ref: str,
    persisted_ref: str,
) -> None:
    decision_path = path.with_suffix(".architecture-decisions.yaml")
    decision_id = f"scaffold-decision.{project_name}"
    decision_text = json.dumps(
        {
            "schema_version": 1,
            "kind": "scaffold-architecture-decisions",
            "template": False,
            "status": "current",
            "decisions": [
                {
                    "decision_id": decision_id,
                    "project_id": project_name,
                    "parent_project_id": None,
                    "status": "lifecycle-approved",
                    "recommended_architecture": "domain-driven",
                    "recommendation_reasons": ["场景验证固定使用 DDD"],
                    "confirmed_architecture": "domain-driven",
                    "override_reason": None,
                    "inheritance_mode": "root-default",
                    "inherited_from": None,
                    "platform_profile": "spring-boot-2.7-jdk8",
                    "architecture_profile": "target-domain-model",
                    "verification_database": "h2",
                    "production_database": "not-bound",
                    "requested_capabilities": [],
                    "resolved_modules": [
                        "domain",
                        "application",
                        "infrastructure",
                        "adapter",
                        "bootstrap",
                    ],
                    "resolution_version": 1,
                    "user_confirmation": {
                        "confirmed_by": "scenario-runner",
                        "channel": "test",
                        "confirmation_ref": "test://scaffold-decision",
                        "confirmed_at": "2026-09-05T00:00:00Z",
                        "normalized_text": "确认使用 DDD",
                    },
                    "decision_inputs_digest": f"sha256:{'1' * 64}",
                }
            ],
        },
        ensure_ascii=False,
        indent=2,
    ) + "\n"
    decision_path.write_text(decision_text, encoding="utf-8")
    contract = {
        "schema_version": 3,
        "contract_id": contract_id,
        "contract_version": 1,
        "scaffold_request_id": f"{project_name}-request",
        "status": "approved",
        "compiler_draft_ref": compiler_draft_ref,
        "lifecycle_approval_ref": approval_ref,
        "persisted_ref": persisted_ref,
        "current_version": 1,
        "implementation_repository": str(output_root),
        "backend_repository": str(output_root),
        "scaffold_status": "required",
        "project_name": project_name,
        "target_output_dir": str(output_root),
        "base_package": f"com.yss.{project_name.removesuffix('-service')}",
        "architecture_family": "domain-driven",
        "architecture_profile": "target-domain-model",
        "generator_skill": "yss-ddd-scaffold-generator",
        "decision_ref": str(decision_path),
        "decision_id": decision_id,
        "decision_digest": f"sha256:{hashlib.sha256(decision_text.encode('utf-8')).hexdigest()}",
        "maven_coordinates": {
            "group_id": "com.yss.datamiddle",
            "project_version": "1.0.0-SNAPSHOT",
            "parent": {
                "group_id": "com.yss.datamiddle",
                "artifact_id": "yss-datamiddle-parent",
                "version": "2.0.0-SNAPSHOT",
            },
            "yss_components_version": "2.0.0-SNAPSHOT",
        },
        "profiles": {
            "architecture": "target-domain-model",
            "persistence": "mybatis-plus",
            "verification_database": "h2",
            "production_database": "not-bound",
            "platform": "spring-boot-2.7-jdk8",
            "validation_namespace": "javax",
            "dto_placement": "web",
            "repository": "yss-internal",
        },
        "module_profile": {
            "resolution_version": 1,
            "requested_capabilities": [],
            "resolved_modules": [
                "domain",
                "application",
                "infrastructure",
                "adapter",
                "bootstrap",
            ],
        },
        "allowed_write_paths": ["."],
        "expected_evidence_files": [
            f"{project_name}/.yss/scaffold-generation.json",
            "scaffold-verification.json",
        ],
        "verification_commands": [
            "./mvnw validate",
            "./mvnw test",
            "./mvnw package",
        ],
        "approval": {
            "approval_ref": approval_ref,
            "approver": "lifecycle-reviewer",
            "persisted_ref": persisted_ref,
            "current_version": 1,
        },
        "work_unit": {
            "id": f"{project_name}-scaffold",
            "behavior": "create pure project scaffold",
            "primary_skill": "yss-ddd-scaffold-generator",
            "supporting_skills": ["yss-backend-scaffold-parent", "alibaba-java-code-style"],
            "tdd_mode": "controlled-generation",
            "allowed_write_paths": ["."],
            "expected_evidence": [".yss/scaffold-generation.json", "scaffold-verification.json"],
            "verification_commands": [
                "./mvnw validate",
                "./mvnw test",
                "./mvnw package",
            ],
            "controlled_generation": True,
        },
        "generation_policy": {
            "mode": "initialize-only",
            "existing_target": "unsupported",
            "old_project_migration": "unsupported",
            "template_upgrade": "unsupported",
        },
    }
    path.write_text(json.dumps(contract, ensure_ascii=False, indent=2), encoding="utf-8")


def assert_pure_scaffold(project_root: Path, contract_id: str) -> None:
    require(project_root.is_dir(), "默认生成必须创建项目目录")
    require((project_root / "pom.xml").is_file(), "默认生成必须包含父级 pom.xml")
    require((project_root / "mvnw").is_file(), "默认生成必须包含 Maven wrapper")
    application_class = "".join(part.capitalize() for part in project_root.name.split("-")) + "Application.java"
    require(
        any(project_root.glob(f"*-bootstrap/src/main/java/**/{application_class}")),
        "默认生成必须包含可被 Spring Boot 插件发现的机械启动入口",
    )
    manifest_path = project_root / ".yss" / "scaffold-generation.json"
    require(manifest_path.is_file(), "生成项目必须携带脚手架合同元数据清单")
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    require(manifest["contract_id"] == contract_id, "生成清单必须记录脚手架合同 ID")
    require(manifest["contract_version"] == 1, "生成清单必须记录脚手架合同版本")
    require(manifest["approval_ref"], "生成清单必须记录生命周期批准引用")
    require(manifest["compiler_draft_ref"], "生成清单必须记录 实现合同编译器 draft 引用")
    require(manifest["persisted_ref"], "生成清单必须记录合同持久化引用")
    require(manifest["generation_mode"] == "controlled-generation", "生成清单必须记录受控生成模式")
    require(manifest["schema_version"] == 3, "新生成清单必须使用 schema v3")
    require(manifest["architecture_family"] == "domain-driven", "生成清单必须记录已确认的 DDD 架构族")
    require(manifest["generator_skill"] == "yss-ddd-scaffold-generator", "生成清单必须记录实际生成器")
    require(manifest["scaffold_request_id"], "生成清单必须记录服务级 scaffold_request_id")
    require("slice_id" not in manifest, "脚手架清单不得伪造 slice_id")
    require(manifest["maven_coordinates_source"] == "approved-contract", "Maven 坐标必须来自批准合同")
    require(manifest["profiles"]["architecture"] == "target-domain-model", "生成清单必须记录目标架构 Profile")
    require(manifest["completion_level"] == "generated", "仅生成文件时完成等级必须是 generated")
    require(manifest["base_package"].startswith("com.yss."), "生成清单必须把 base_package 与 Maven 坐标分开记录")
    require(not (project_root / "API.md").exists(), "默认生成不得写入业务 API 文档")
    require(not (project_root / "db" / "schema.sql").exists(), "默认生成不得写入业务 schema")
    require(not (project_root / "db" / "data.sql").exists(), "默认生成不得写入业务初始化数据")

    forbidden_tokens = (
        "t_user",
        "/api/users",
        "default admin",
        "User CRUD",
    )
    for path in project_root.rglob("*"):
        if not path.is_file() or path.suffix in {".jar", ".class", ".db"}:
            continue
        content = path.read_text(encoding="utf-8")
        for token in forbidden_tokens:
            require(token not in content, f"纯骨架包含业务示例 {token}: {path}")


def main() -> int:
    require(WORKFLOW.is_file(), "脚手架必须提供一键生成并验证入口")
    template_root = REPOSITORY_ROOT / ".agents/skills/yss-ddd-scaffold-generator/assets/templates"
    user_templates = list(template_root.rglob("User*.java.template"))
    require(not user_templates, "脚手架资产不得保留 User 业务 Java 模板")

    with tempfile.TemporaryDirectory(prefix="yss-scaffold-test-") as temp_dir:
        temp_root = Path(temp_dir)
        output_root = temp_root / "output"

        missing_contract_root = temp_root / "missing-contract-output"
        missing_contract_result = run_generator(
            "--project-name",
            "missing-contract-service",
            "--base-package",
            "com.yss.missing",
            "--output-dir",
            str(missing_contract_root),
        )
        require(
            missing_contract_result.returncode != 0,
            "缺少批准脚手架合同元数据时不得生成项目",
        )

        schema_v1_root = temp_root / "schema-v1-output"
        schema_v1_contract = temp_root / "schema-v1-contract.json"
        write_contract(
            schema_v1_contract,
            schema_v1_root,
            "schemav1-service",
            "backend-scaffold-schema-v1",
            "lifecycle/approval-schema-v1",
            "compiler/draft-schema-v1",
            "lifecycle/contracts/backend-scaffold-schema-v1.yaml",
        )
        schema_v1_payload = json.loads(schema_v1_contract.read_text(encoding="utf-8"))
        schema_v1_payload["schema_version"] = 1
        schema_v1_contract.write_text(json.dumps(schema_v1_payload), encoding="utf-8")
        schema_v1_result = run_generator(
            "--project-name", "schemav1-service",
            "--base-package", "com.yss.schemav1",
            "--output-dir", str(schema_v1_root),
            "--contract-id", "backend-scaffold-schema-v1",
            "--contract-version", "1",
            "--approval-ref", "lifecycle/approval-schema-v1",
            "--compiler-draft-ref", "compiler/draft-schema-v1",
            "--persisted-ref", "lifecycle/contracts/backend-scaffold-schema-v1.yaml",
            "--contract-file", str(schema_v1_contract),
            "--group-id", "com.yss.datamiddle",
            "--project-version", "1.0.0-SNAPSHOT",
            "--parent-group-id", "com.yss.datamiddle",
            "--parent-artifact-id", "yss-datamiddle-parent",
            "--parent-version", "2.0.0-SNAPSHOT",
            "--yss-components-version", "2.0.0-SNAPSHOT",
        )
        require(
            schema_v1_result.returncode != 0
            and "unsupported: scaffold contract schema_version=1" in (schema_v1_result.stdout + schema_v1_result.stderr),
            "schema v1 脚手架合同必须直接返回 unsupported，且不得自动升级",
        )
        require(not (schema_v1_root / "schemav1-service").exists(), "schema v1 拒绝后不得留下生成目录")

        forbidden_harness_output = run_generator(
            "--project-name",
            "forbidden-service",
            "--base-package",
            "com.yss.forbidden",
            "--output-dir",
            str(REPOSITORY_ROOT / "app" / "backend"),
            "--contract-file",
            str(temp_root / "forbidden-contract.json"),
        )
        require(
            forbidden_harness_output.returncode != 0
            and "禁止使用单数 app/backend" in (forbidden_harness_output.stdout + forbidden_harness_output.stderr),
            "脚手架不得把 app/backend 作为工程输出路径",
        )

        stale_contract_root = temp_root / "stale-contract-output"
        stale_contract = temp_root / "stale-contract.json"
        write_contract(
            stale_contract,
            stale_contract_root,
            "stale-service",
            "backend-scaffold-stale",
            "lifecycle/approval-stale",
            "compiler/draft-stale",
            "lifecycle/contracts/backend-scaffold-stale.yaml",
        )
        stale_payload = json.loads(stale_contract.read_text(encoding="utf-8"))
        stale_payload["current_version"] = 2
        stale_contract.write_text(json.dumps(stale_payload), encoding="utf-8")
        stale_result = run_generator(
            "--project-name",
            "stale-service",
            "--base-package",
            "com.yss.stale",
            "--output-dir",
            str(stale_contract_root),
            "--contract-id",
            "backend-scaffold-stale",
            "--contract-version",
            "1",
            "--approval-ref",
            "lifecycle/approval-stale",
            "--compiler-draft-ref",
            "compiler/draft-stale",
            "--persisted-ref",
            "lifecycle/contracts/backend-scaffold-stale.yaml",
            "--contract-file",
            str(stale_contract),
        )
        require(stale_result.returncode != 0, "过期脚手架合同不得生成项目")

        default_contract = temp_root / "pure-contract.json"
        write_contract(
            default_contract,
            output_root,
            "pure-service",
            "backend-scaffold-000",
            "lifecycle/approval-000",
            "compiler/draft-000",
            "lifecycle/contracts/backend-scaffold-000.yaml",
        )

        default_result = run_generator(
            "--project-name",
            "pure-service",
            "--base-package",
            "com.yss.pure",
            "--output-dir",
            str(output_root),
            "--contract-id",
            "backend-scaffold-000",
            "--contract-version",
            "1",
            "--approval-ref",
            "lifecycle/approval-000",
            "--compiler-draft-ref",
            "compiler/draft-000",
            "--persisted-ref",
            "lifecycle/contracts/backend-scaffold-000.yaml",
            "--contract-file",
            str(default_contract),
            "--group-id", "com.yss.datamiddle",
            "--project-version", "1.0.0-SNAPSHOT",
            "--parent-group-id", "com.yss.datamiddle",
            "--parent-artifact-id", "yss-datamiddle-parent",
            "--parent-version", "2.0.0-SNAPSHOT",
            "--yss-components-version", "2.0.0-SNAPSHOT",
        )
        require(
            default_result.returncode == 0,
            f"默认纯骨架生成失败:\n{default_result.stdout}\n{default_result.stderr}",
        )
        assert_pure_scaffold(output_root / "pure-service", "backend-scaffold-000")

        verification_project = temp_root / "verification-service"
        verification_project.mkdir()
        verification_manifest = verification_project / ".yss" / "scaffold-generation.json"
        verification_manifest.parent.mkdir()
        verification_manifest.write_text(
            json.dumps(
                {
                    "schema_version": 2,
                    "contract_id": "backend-scaffold-verification",
                    "contract_version": 1,
                    "scaffold_request_id": "verification-service-request",
                    "contract_digest": "a" * 64,
                    "approval_ref": "lifecycle/verification",
                    "lifecycle_approval_ref": "lifecycle/verification",
                    "compiler_draft_ref": "router/verification",
                    "persisted_ref": "lifecycle/contracts/verification.yaml",
                    "contract_file_ref": "lifecycle/contracts/verification.json",
                    "current_version": 1,
                    "approver": "lifecycle-reviewer",
                    "allowed_write_paths": ["verification-service/**"],
                    "expected_evidence_files": ["scaffold-verification.json"],
                    "verification_commands": [
                        "./mvnw validate",
                        "./mvnw test",
                        "./mvnw package",
                    ],
                    "generation_mode": "controlled-generation",
                    "completion_level": "generated",
                    "profiles": {
                        "architecture": "target-domain-model",
                        "repository": "yss-internal",
                    },
                    "ownership": {"generated_files": []},
                    "readiness": {
                        "downstream_skills": {},
                        "architecture_ruleset": "b" * 64,
                    },
                    "generation_policy": {
                        "mode": "initialize-only",
                        "existing_target": "unsupported",
                        "old_project_migration": "unsupported",
                        "template_upgrade": "unsupported",
                    },
                    "maven_coordinates_source": "approved-contract",
                }
            ),
            encoding="utf-8",
        )
        wrapper = verification_project / "mvnw"
        wrapper.write_text(
            "#!/bin/sh\n"
            "printf '%s\\n' \"$*\" >> \"$(dirname \"$0\")/commands.log\"\n"
            "exit 0\n",
            encoding="utf-8",
        )
        os.chmod(wrapper, 0o755)
        maven_dir = verification_project / ".mvn"
        maven_dir.mkdir()
        (maven_dir / "maven.config").write_text(
            "-s .mvn/settings.xml\n-P yss-internal\n", encoding="utf-8"
        )
        (maven_dir / "settings.xml").write_text("<settings/>\n", encoding="utf-8")
        evidence_dir = verification_project / "evidence"
        verification_env = os.environ.copy()
        verification_env.update(
            {
                "YSS_MAVEN_REPOSITORY_URL": "https://repo.example.invalid/repository/maven-public/",
                "MAVEN_REPO_USERNAME": "test-user",
                "MAVEN_REPO_PASSWORD": "test-password",
            }
        )
        verification_result = subprocess.run(
            [
                "node",
                str(VERIFIER),
                "--project-root",
                str(verification_project),
                "--evidence-dir",
                str(evidence_dir),
            ],
            cwd=REPOSITORY_ROOT,
            text=True,
            capture_output=True,
            check=False,
            env=verification_env,
        )
        require(
            verification_result.returncode == 0,
            f"受控验证执行器失败:\n{verification_result.stdout}\n{verification_result.stderr}",
        )
        report = json.loads((evidence_dir / "scaffold-verification.json").read_text(encoding="utf-8"))
        require(
            Path(report["scaffold_manifest_ref"]).resolve() == verification_manifest.resolve(),
            "验证报告必须回勾脚手架生成元数据清单",
        )
        require(
            [item["command"] for item in report["commands"]]
            == ["./mvnw validate", "./mvnw test", "./mvnw package"],
            "验证报告必须记录完整的 wrapper 命令",
        )
        require(
            all(item["exit_code"] == 0 for item in report["commands"]),
            "验证报告必须记录每条命令的 exit_code",
        )
        require(
            all(Path(item["stdout_ref"]).is_file() for item in report["commands"]),
            "验证报告必须包含 stdout 证据文件",
        )
        require(
            all(Path(item["stderr_ref"]).is_file() for item in report["commands"]),
            "验证报告必须包含 stderr 证据文件",
        )
        require(
            all(item["duration_ms"] >= 0 and item["started_at"] and item["executed_at"] for item in report["commands"]),
            "验证报告必须记录耗时和执行时间",
        )
        require(report["failure_category"] is None, "全部成功时 failure_category 必须为空")
        require(report["preflight"]["wrapper_executable"] is True, "验证报告必须包含 Wrapper 预检")
        require(
            (verification_project / "commands.log").read_text(encoding="utf-8").splitlines()
            == ["validate", "test", "package"],
            "验证器必须实际执行三条 wrapper 命令",
        )

        example_root = temp_root / "example-output"
        example_result = run_generator(
            "--project-name",
            "example-service",
            "--base-package",
            "com.yss.example",
            "--output-dir",
            str(example_root),
            "--with-example",
        )
        require(example_result.returncode != 0, "--with-example 必须被受控生成边界拒绝")
        require(
            not (example_root / "example-service").exists(),
            "拒绝 --with-example 时不得留下部分生成目录",
        )

        force_root = temp_root / "force-output"
        force_project = force_root / "force-service"
        force_project.mkdir(parents=True)
        sentinel = force_project / "user-owned.txt"
        sentinel.write_text("preserve me", encoding="utf-8")

        unapproved_force_result = run_generator(
            "--project-name",
            "force-service",
            "--base-package",
            "com.yss.force",
            "--output-dir",
            str(force_root),
            "--force",
        )
        require(
            unapproved_force_result.returncode != 0,
            "非空目录的 --force 必须要求合同元数据",
        )
        require(sentinel.read_text(encoding="utf-8") == "preserve me", "未批准覆盖不得改变原目录")

        force_contract = temp_root / "force-contract.json"
        write_contract(force_contract, force_root, "force-service", "backend-scaffold-001", "lifecycle/approval-001", "compiler/draft-001", "lifecycle/contracts/backend-scaffold-001.yaml")
        approved_force_result = run_generator(
            "--project-name",
            "force-service",
            "--base-package",
            "com.yss.force",
            "--output-dir",
            str(force_root),
            "--force",
            "--contract-id",
            "backend-scaffold-001",
            "--contract-version",
            "1",
            "--approval-ref",
            "lifecycle/approval-001",
            "--compiler-draft-ref",
            "compiler/draft-001",
            "--persisted-ref",
            "lifecycle/contracts/backend-scaffold-001.yaml",
            "--contract-file",
            str(force_contract),
            "--group-id", "com.yss.datamiddle",
            "--project-version", "1.0.0-SNAPSHOT",
            "--parent-group-id", "com.yss.datamiddle",
            "--parent-artifact-id", "yss-datamiddle-parent",
            "--parent-version", "2.0.0-SNAPSHOT",
            "--yss-components-version", "2.0.0-SNAPSHOT",
        )
        require(
            approved_force_result.returncode != 0,
            "即使合同已批准，initialize-only 生成器也必须拒绝 --force",
        )
        require(sentinel.read_text(encoding="utf-8") == "preserve me", "批准合同也不得覆盖已有目录")
        require(not list(force_root.glob(".force-service.backup-*")), "initialize-only 不创建覆盖备份")

        gitlink_root = temp_root / "gitlink-superproject"
        gitlink_backend = gitlink_root / "apps" / "backend"
        gitlink_project = gitlink_backend / "gitlink-service"
        gitlink_project.mkdir(parents=True)
        (gitlink_root / ".gitmodules").write_text(
            '[submodule "backend-gitlink-service"]\n'
            "\tpath = apps/backend/gitlink-service\n"
            "\turl = https://example.invalid/gitlink-service.git\n",
            encoding="utf-8",
        )
        gitlink_contract = temp_root / "gitlink-contract.json"
        write_contract(
            gitlink_contract,
            gitlink_backend,
            "gitlink-service",
            "backend-scaffold-gitlink",
            "lifecycle/approval-gitlink",
            "compiler/draft-gitlink",
            "lifecycle/contracts/backend-scaffold-gitlink.yaml",
        )
        gitlink_result = run_generator(
            "--project-name",
            "gitlink-service",
            "--base-package",
            "com.yss.gitlink",
            "--output-dir",
            str(gitlink_backend),
            "--contract-id",
            "backend-scaffold-gitlink",
            "--contract-version",
            "1",
            "--approval-ref",
            "lifecycle/approval-gitlink",
            "--compiler-draft-ref",
            "compiler/draft-gitlink",
            "--persisted-ref",
            "lifecycle/contracts/backend-scaffold-gitlink.yaml",
            "--contract-file",
            str(gitlink_contract),
            "--group-id", "com.yss.datamiddle",
            "--project-version", "1.0.0-SNAPSHOT",
            "--parent-group-id", "com.yss.datamiddle",
            "--parent-artifact-id", "yss-datamiddle-parent",
            "--parent-version", "2.0.0-SNAPSHOT",
            "--yss-components-version", "2.0.0-SNAPSHOT",
        )
        require(
            gitlink_result.returncode != 0
            and "gitlink 不得由脚手架覆盖" in (gitlink_result.stdout + gitlink_result.stderr)
            and "请显式传入 --force" not in (gitlink_result.stdout + gitlink_result.stderr),
            "空 gitlink 挂载点不得被脚手架覆盖",
        )
        require(not (gitlink_project / "pom.xml").exists(), "拒绝 gitlink 覆盖时不得留下骨架")

    print("YSS 脚手架生成器受控生成场景验证通过")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
