#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "open3"
require "optparse"
require_relative "lifecycle-registry"
require_relative "repository-mode"

options = { registry: LifecycleRegistry::DEFAULT_REGISTRY }
OptionParser.new do |parser|
  parser.on("--registry PATH", "使用指定注册表") { |path| options[:registry] = Pathname.new(path) }
end.parse!

begin
  schema_path = LifecycleRegistry::ROOT.join("docs/process/schemas/lifecycle-registry.schema.json")
  schema = JSON.parse(schema_path.read)
  raise ArgumentError, "生命周期注册表 JSON Schema 缺少 schema_version 约束" unless schema.dig("properties", "schema_version", "const") == 1
  json_schema_program = <<~'PYTHON'
    import json
    import sys
    from jsonschema import Draft202012Validator

    with open(sys.argv[1], encoding="utf-8") as schema_file:
        schema = json.load(schema_file)
    registry = json.load(sys.stdin)
    errors = sorted(Draft202012Validator(schema).iter_errors(registry), key=lambda error: list(error.absolute_path))
    if errors:
        for error in errors:
            location = ".".join(str(part) for part in error.absolute_path) or "<root>"
            print(f"{location}: {error.message}", file=sys.stderr)
        sys.exit(1)
  PYTHON
  registry_json = JSON.generate(LifecycleRegistry.load_registry(options[:registry]))
  output, status = Open3.capture2e("python3", "-c", json_schema_program, schema_path.to_s, stdin_data: registry_json)
  raise ArgumentError, "JSON Schema 校验失败: #{output}" unless status.success?
  registry = LifecycleRegistry.validate!(LifecycleRegistry.load_registry(options[:registry]))

  if options[:registry] == LifecycleRegistry::DEFAULT_REGISTRY
    command = [LifecycleRegistry::ROOT.join("scripts/generate-lifecycle-artifacts").to_s, "--check"]
    output, status = Open3.capture2e(*command, chdir: LifecycleRegistry::ROOT)
    raise ArgumentError, output unless status.success?

    tracked_sources = %w[docs/process/lifecycle-registry.yaml docs/process/lifecycle-registry-baseline.json docs/process/schemas/lifecycle-registry.schema.json]
    tracked_sources.each do |relative_path|
      _output, ignored = Open3.capture2e("git", "check-ignore", "-q", relative_path, chdir: LifecycleRegistry::ROOT)
      raise ArgumentError, "权威注册表资产不得被 Git 忽略: #{relative_path}" if ignored.success?
    end

    stale_count_paths = %w[AGENTS.md README.md docs/user-guide/产品生命周期工作流.md .agents/skills/yss-product-lifecycle/SKILL.md docs/process/lifecycle-artifact-map.md]
    if YssRepositoryMode.template_source?(LifecycleRegistry::ROOT)
      stale_count_paths << ".template-source/derived/harness-work-unit-map.md"
    end
    stale_count_paths.each do |relative_path|
      body = LifecycleRegistry::ROOT.join(relative_path).read
      if body.match?(/\d+\s*个(?:主阶段|门禁|工作单元|职责点)/)
        raise ArgumentError, "#{relative_path} 不得手工声明生命周期对象数量；请引用 lifecycle-registry.yaml"
      end
    end

    public_skills = JSON.parse(LifecycleRegistry::ROOT.join("yss-public-skills.json").read)
    groups = public_skills.fetch("groupings").to_h { |group| [group.fetch("title"), group.fetch("skills")] }
    raise ArgumentError, "yss-web-controller 必须在后端分组" unless groups.fetch("后端").include?("yss-web-controller")
    raise ArgumentError, "yss-web-controller 不得在前端分组" if groups.fetch("前端").include?("yss-web-controller")
  end

  puts "生命周期注册表验证通过（#{registry.fetch("status")}）"
rescue ArgumentError, KeyError, JSON::ParserError => error
  warn "生命周期注册表验证失败: #{error.message}"
  exit 1
end
