#!/usr/bin/env bash
# 托管 runner 的环境准备，GitHub Actions 与 GitLab CI 共用；只依赖 bash。
# 会安装依赖并可能改写全局工具，所以只在 CI 环境运行；本机请用 --dry-run 查看计划。
set -euo pipefail

YSS_CI_NODE_MAJOR="${YSS_CI_NODE_MAJOR:-24}"
YSS_CI_PNPM_VERSION="${YSS_CI_PNPM_VERSION:-10.15.0}"
# 验证预检要求 Python 恰为该版本；GitHub 用 setup-python 供给，缺失时在 CI 的 root 容器里经 uv 补装。
YSS_CI_PYTHON_MINOR="${YSS_CI_PYTHON_MINOR:-3.12}"
YSS_CI_UV_VERSION="${YSS_CI_UV_VERSION:-0.13.0}"
YSS_CI_JSONSCHEMA_VERSION="${YSS_CI_JSONSCHEMA_VERSION:-4.23.0}"
YSS_CLI_REPOSITORY="${YSS_CLI_REPOSITORY:-https://github.com/iloveZzz/yss-cli.git}"
# yss-cli 不是 submodule：它的版本、提交、Go 版本和各平台二进制摘要写在
# .template-source/distribution/yss-cli-pin.json；供 read-only-intake 等检查读取的 CLI 源码历史约 1GB，永远只浅克隆那个固定提交。
YSS_CLI_PIN=.template-source/scripts/lib/yss-cli-pin.mjs

usage() {
  cat <<'EOF'
用法: scripts/ci-setup [--no-python] [--toolchain] [--yss-commit <40位SHA>|pin|latest] [--dry-run]
       scripts/ci-setup --requirements-file <绝对JSON文件> [--dry-run]
       scripts/ci-setup --print-versions
  默认          校验 Node 主版本、确认 template-source、按 frozen lockfile 安装 pnpm 依赖、安装 Python schema 依赖
  --no-python   跳过 Python schema 依赖
  --toolchain   准备原型作者工具链，并（配合 --yss-commit）安装固定版本的 Go 以构建 yss
  --yss-commit  latest 每批查询最新正式 Release 后固定源码与摘要；pin/完整 SHA 保留显式历史构建。按需 native_cli 默认 latest
  --dry-run     只打印计划，不执行
  --print-versions  打印 node= 与 python= 的目标版本（KEY=value，可直接追加到 $GITHUB_OUTPUT），供平台适配器选择运行时，不重复写版本号
环境变量:
  YSS_CI_ENV_FILE  需要传给后续步骤的变量按 NAME=value 追加到该文件
                   （ci-gate 使用专用文件按受控数据读取；不得当 shell 执行）
  YSS_CI_ALLOW_LOCAL=1  允许在未设置 CI 的机器上真实执行
EOF
}

python=1
python_schema=1
go_needed=0
plugin_candidate_needed=0
tooling=1
requirements_file=""
requirements_mode=0
legacy_options=0
toolchain=0
yss_commit=""
dry_run=0
while (($#)); do
  case "$1" in
    --requirements-file) shift; requirements_file="${1:-}"; requirements_mode=1; [[ -n "$requirements_file" ]] || { echo "--requirements-file 缺少路径" >&2; exit 2; } ;;
    --no-python) legacy_options=1; python=0 ;;
    --toolchain) legacy_options=1; toolchain=1 ;;
    --yss-commit)
      legacy_options=1
      shift
      yss_commit="${1:-}"
      ;;
    --dry-run) dry_run=1 ;;
    --print-versions) printf 'node=%s\npython=%s\n' "$YSS_CI_NODE_MAJOR" "$YSS_CI_PYTHON_MINOR"; exit 0 ;;
    --help | -h) usage; exit 0 ;;
    *) echo "未知参数: $1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if ((requirements_mode)); then
  ((legacy_options==0)) || { echo "--requirements-file 不能与旧准备选项混用" >&2; exit 2; }
  requirements="$(node --input-type=module - "$requirements_file" "$ROOT_DIR" <<'JS'
import fs from 'node:fs';import path from 'node:path';import {pathToFileURL} from 'node:url';
try {
  const file=process.argv[2];
  if(!path.isAbsolute(file)||!fs.lstatSync(file).isFile())throw new Error('需求文件必须是绝对普通文件');
  const {validateVerificationToolRequirements}=await import(pathToFileURL(path.join(process.argv[3],'.template-source/scripts/lib/verification-preflight.mjs')));
  const needs=validateVerificationToolRequirements(JSON.parse(fs.readFileSync(file,'utf8')));
  console.log([needs.python,Number(needs.go),Number(needs.native_cli),Number(needs.tooling),Number(needs.vue),Number(needs.plugin_candidate || false)].join(' '));
}catch(error){console.error(error.message);process.exit(2);}
JS
)" || exit 2
  read -r python_requirement go_needed native_needed tooling toolchain plugin_candidate_needed <<< "$requirements"
  if [[ "$python_requirement" == none ]]; then python=0; fi
  if [[ "$python_requirement" != jsonschema ]]; then python_schema=0; fi
  if ((native_needed)); then yss_commit=latest; fi
fi

yss_pinned=0
if [[ "$yss_commit" == gitlink ]]; then
  echo "--yss-commit gitlink 已取消：yss-cli 不再是 submodule，改写 pin（取 .template-source/distribution/yss-cli-pin.json 的提交）" >&2
  exit 2
fi
if [[ "$yss_commit" == pin ]]; then
  yss_commit="$(node "$(dirname "${BASH_SOURCE[0]}")/../$YSS_CLI_PIN" commit 2>/dev/null || true)"
  [[ -n "$yss_commit" ]] || { echo "无法读取 yss-cli 固定文件的 commit" >&2; exit 2; }
  yss_pinned=1
fi
if [[ -n "$yss_commit" && "$yss_commit" != latest && ! "$yss_commit" =~ ^[a-f0-9]{40}$ ]]; then
  echo "--yss-commit 必须是 40 位小写十六进制的完整提交 SHA，或写 pin/latest" >&2
  exit 2
fi
if ((!dry_run)) && [[ -z "${CI:-}" && "${YSS_CI_ALLOW_LOCAL:-}" != "1" ]]; then
  echo "scripts/ci-setup 会安装依赖并改写工具，只在 CI 环境运行；本机用 --dry-run 查看计划，确需执行请设置 YSS_CI_ALLOW_LOCAL=1" >&2
  exit 2
fi

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

step() { echo "==> $*"; }
run() {
  echo "+ $*"
  if ((!dry_run)); then "$@"; fi
}
export_var() {
  echo "export $1=$2"
  if ((!dry_run)) && [[ -n "${YSS_CI_ENV_FILE:-}" ]]; then echo "$1=$2" >>"$YSS_CI_ENV_FILE"; fi
}
work_dir() {
  if [[ -n "${RUNNER_TEMP:-}" ]]; then echo "$RUNNER_TEMP"; else mktemp -d; fi
}

is_root() { [[ "$(id -u)" == 0 ]]; }
fail() { echo "$*" >&2; exit 1; }
# 只在 CI 的 root 容器（apt 系）里补装缺失的工具；其它环境要求 runner 镜像自带。
can_provision() { is_root && command -v apt-get >/dev/null; }
apt_install() {
  apt-get update -qq
  DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends "$@"
}
python_minor() { python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])' 2>/dev/null || true; }

ensure_python() {
  [[ "$(python_minor)" == "$YSS_CI_PYTHON_MINOR" ]] && return 0
  can_provision || fail "需要 Python ${YSS_CI_PYTHON_MINOR}（当前 $(python_minor)）；请在 runner 镜像或 setup-python 中提供"
  command -v python3 >/dev/null && python3 -m pip --version >/dev/null 2>&1 || apt_install python3 python3-pip
  PIP_BREAK_SYSTEM_PACKAGES=1 python3 -m pip install -q "uv==${YSS_CI_UV_VERSION}"
  uv python install "$YSS_CI_PYTHON_MINOR"
  ln -sf "$(uv python find "$YSS_CI_PYTHON_MINOR")" /usr/local/bin/python3
  hash -r # 清掉已缓存的 /usr/bin/python3，否则下面的检查仍看到旧解释器
  [[ "$(python_minor)" == "$YSS_CI_PYTHON_MINOR" ]] || fail "补装后 python3 仍不是 ${YSS_CI_PYTHON_MINOR}"
}

# latest 保留现有 Go，由固定源码选择精确工具链；缺少 Go 或显式历史构建才从仓内 pin 引导。
ensure_go() {
  local required have arch file sha tmp
  if [[ "$yss_commit" == latest ]] && command -v go >/dev/null; then return 0; fi
  required="$(node "$ROOT_DIR/$YSS_CLI_PIN" go_version 2>/dev/null || true)"
  [[ -n "$required" ]] || fail "无法从 yss-cli 固定文件读出所需 Go 版本"
  [[ "$yss_commit" == latest || -z "${YSS_CI_GO_VERSION:-}" || "$YSS_CI_GO_VERSION" == "$required" ]] || fail "YSS_CI_GO_VERSION 必须等于固定文件的 go_version ${required}"
  if command -v go >/dev/null; then
    have="$(go env GOVERSION | sed 's/^go//')"
    [[ "$have" == "$required" ]] && return 0
  fi
  can_provision || fail "需要精确 Go ${required}（当前 ${have:-未安装}）；请在 runner 镜像或 setup-go 中提供"
  case "$(uname -m)" in x86_64) arch=amd64 ;; aarch64 | arm64) arch=arm64 ;; *) fail "不支持的架构 $(uname -m)" ;; esac
  read -r file sha < <(node -e '
    fetch("https://go.dev/dl/?mode=json&include=all").then((r) => r.json()).then((releases) => {
      const release = releases.find((item) => item.version === "go" + process.argv[1]);
      const entry = release?.files.find((f) => f.os === "linux" && f.arch === process.argv[2] && f.kind === "archive");
      if (!entry) { console.error("go.dev 没有 go" + process.argv[1] + " 的 linux/" + process.argv[2] + " 发布"); process.exit(1); }
      console.log(entry.filename, entry.sha256);
    });' "$required" "$arch")
  [[ -n "${file:-}" && -n "${sha:-}" ]] || fail "无法从 go.dev 取得 go${required} 的发布信息"
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/$file" "https://go.dev/dl/$file"
  echo "$sha  $tmp/$file" | sha256sum -c - >/dev/null || fail "Go 压缩包校验和不匹配"
  rm -rf /usr/local/go && tar -C /usr/local -xzf "$tmp/$file"
  ln -sf /usr/local/go/bin/go /usr/local/bin/go && ln -sf /usr/local/go/bin/gofmt /usr/local/bin/gofmt
  hash -r
  rm -rf "$tmp"
  [[ "$(go env GOVERSION)" == "go${required}" ]] || fail "补装后 Go 仍不是 ${required}"
}

step "Node 主版本必须是 ${YSS_CI_NODE_MAJOR}（由 runner 镜像或 setup-node 提供）"
if ((!dry_run)); then
  actual_node="$(node -p 'process.versions.node.split(".")[0]')"
  if [[ "$actual_node" != "$YSS_CI_NODE_MAJOR" ]]; then
    echo "当前 Node 主版本为 ${actual_node}，需要 ${YSS_CI_NODE_MAJOR}；请在 runner 镜像或 setup-node 中固定" >&2
    exit 1
  fi
fi

step "确认仓库模式为 template-source"
if ((!dry_run)); then test "$(scripts/repository-mode)" = template-source; else echo "+ test \"\$(scripts/repository-mode)\" = template-source"; fi

if ((go_needed)) || [[ -n "$yss_commit" ]] || { ((!requirements_mode)) && ((toolchain)); }; then
  if [[ "$yss_commit" == latest ]]; then
    step "Go：保留现有工具链，精确编译版本取本批固定源码 go.mod；缺少 Go 时用仓内 pin 引导"
  else
    step "Go：版本取自 yss-cli 固定文件的 go_version"
  fi
  if ((dry_run)); then
    echo "+ 历史构建按 pin 校验 Go；latest 的精确工具链由 Go 缓存供给，缺少启动器时在 root 容器内按 go.dev 公布的 sha256 安装"
  else
    export GOTOOLCHAIN=local # 固定编译器，不允许 go.mod 触发自动工具链切换。
    ensure_go
  fi
fi

if [[ "$yss_commit" == latest ]]; then
  step "查询最新正式 Release，固定本批源码与摘要后构建 yss 或复用缓存；后续验证不重复联网"
  if ((dry_run)); then
    echo "+ node .template-source/scripts/ensure-native-yss.mjs --json → 本批固定环境（无原生安装资格的平台仅 regression-only 构建）"
  else
    ensure_python
    native_result="$(node .template-source/scripts/ensure-native-yss.mjs --json)" || fail "最新正式 CLI 回归输入准备失败"
    native_values="$(node -e 'const v=JSON.parse(process.argv[1]); for(const [key,field] of Object.entries({YSS_NATIVE_BINARY:"binary",YSS_NATIVE_BINARY_SHA256:"sha256",YSS_NATIVE_SOURCE_ROOT:"source",YSS_NATIVE_PIN_FILE:"pinFile",YSS_NATIVE_PIN_SHA256:"pinSha256"})){if(typeof v[field]!=="string"||/[\r\n\0]/.test(v[field]))process.exit(1);console.log(key+"="+v[field]);}' "$native_result")" || fail "本批 CLI 环境格式不符"
    while IFS= read -r entry; do export_var "${entry%%=*}" "${entry#*=}"; done <<< "$native_values"
  fi
elif [[ -n "$yss_commit" ]]; then
  step "从固定提交 ${yss_commit} 构建 yss"
  if ((dry_run)); then
    echo "+ git fetch --depth 1 ${YSS_CLI_REPOSITORY} ${yss_commit} → 按提交内来源锁运行 node tools/fetch-bundle.mjs 生成内嵌 Bundle，再运行 node tools/build-candidate.mjs（官方候选构建配方；没有该脚本的旧提交退回 go build -trimpath）"
  else
    command -v go >/dev/null || { echo "构建 yss 需要 go；请在 runner 镜像中提供" >&2; exit 1; }
    yss_source="$(work_dir)/yss-cli-${yss_commit}"
    test ! -e "$yss_source"
    git init -q "$yss_source"
    git -C "$yss_source" remote add origin "$YSS_CLI_REPOSITORY"
    git -C "$yss_source" -c protocol.version=2 fetch -q --depth 1 origin "$yss_commit"
    git -C "$yss_source" checkout -q --detach FETCH_HEAD
    test "$(git -C "$yss_source" rev-parse HEAD)" = "$yss_commit"
    if ((yss_pinned)); then
      go_mod_version="$(sed -n 's/^go \([0-9][0-9.]*\)$/\1/p' "$yss_source/go.mod" | head -n1)"
      [[ "$go_mod_version" == "$(node "$ROOT_DIR/$YSS_CLI_PIN" go_version)" ]] || fail "固定提交的 go.mod 要求 Go ${go_mod_version}，与 yss-cli 固定文件的 go_version 不一致"
    fi
    # pin 的摘要绑定已提交资产；Bundle 在发行阶段由 artifacts 工具生成并校验，bootstrap 不重生成。
    test -z "$(git -C "$yss_source" status --porcelain --untracked-files=normal)"
    # 内嵌 Bundle 归档自 yss-cli 78cf81a 起不入库（被忽略，不影响上面的干净检查）：构建前按其来源锁生成，并核对入库摘要。
    if [[ -f "$yss_source/tools/fetch-bundle.mjs" ]]; then
      node "$yss_source/tools/fetch-bundle.mjs"
    fi
    if [[ -f "$yss_source/tools/build-candidate.mjs" ]]; then
      # yss-cli 自带的候选构建配方：固定 Go 环境、-mod=readonly -trimpath -buildvcs=false，提交号与来源状态用 -X 写入，并留下构建收据。
      yss_build_out="$(dirname "$yss_source")/yss-build-${yss_commit}"
      test ! -e "$yss_build_out"
      node "$yss_source/tools/build-candidate.mjs" --root "$yss_source" --out "$yss_build_out"
      yss_binary="$yss_build_out/yss"
    else
      yss_binary="$(dirname "$yss_source")/yss"
      (cd "$yss_source" && CGO_ENABLED=0 go build -trimpath -o "$yss_binary" ./cmd/yss)
    fi
    yss_sha256="$(node -e 'process.stdout.write(require("node:crypto").createHash("sha256").update(require("node:fs").readFileSync(process.argv[1])).digest("hex"))' "$yss_binary")"
    if ((yss_pinned)); then
      # 同一提交、同一 Go 版本、同一构建配方构建出的二进制逐字节相同：摘要必须等于固定文件登记的值。
      case "$(uname -m)" in x86_64) yss_arch=amd64 ;; aarch64 | arm64) yss_arch=arm64 ;; *) fail "不支持的架构 $(uname -m)" ;; esac
      yss_expected="$(node "$ROOT_DIR/$YSS_CLI_PIN" sha256 "$(uname -s | tr '[:upper:]' '[:lower:]')-${yss_arch}")" || fail "yss-cli 固定文件没有登记当前平台的二进制摘要"
      [[ "$yss_sha256" == "$yss_expected" ]] || fail "构建出的 yss 与固定文件的摘要不符：期望 ${yss_expected}，实际 ${yss_sha256}"
    else
      echo "注意：显式提交不是固定文件里的提交，没有核对固定摘要；验证预检仍会按固定文件拒绝它" >&2
    fi
    export_var YSS_NATIVE_SOURCE_ROOT "$yss_source"
    export_var YSS_NATIVE_BINARY "$yss_binary"
    export_var YSS_NATIVE_BINARY_SHA256 "$yss_sha256"
    if ((yss_pinned)); then
      export_var YSS_NATIVE_PIN_FILE "$ROOT_DIR/.template-source/distribution/yss-cli-pin.json"
      export_var YSS_NATIVE_PIN_SHA256 "$(node -e 'process.stdout.write(require("node:crypto").createHash("sha256").update(require("node:fs").readFileSync(process.argv[1])).digest("hex"))' "$ROOT_DIR/.template-source/distribution/yss-cli-pin.json")"
    fi
  fi
fi

if ((plugin_candidate_needed)); then
  step "构建固定 CLI 与当前模板的插件测试候选；不作为发行证据"
  if ((dry_run)); then
    echo "+ 固定 CLI 提交并在仓外构建成对插件候选"
  else
    [[ -n "${YSS_CI_ENV_FILE:-}" && "$YSS_CI_ENV_FILE" = /* ]] || fail "插件候选需要绝对 YSS_CI_ENV_FILE"
    saved_yss_commit="$yss_commit"; yss_commit=pin; ensure_go; yss_commit="$saved_yss_commit"
    candidate_commit="$(node --input-type=module -e 'import {candidateCliCommit} from "./.template-source/scripts/lib/plugin-candidate.mjs"; console.log(candidateCliCommit)')"
    candidate_source="$(mktemp -d "$(work_dir)/yss-plugin-cli.XXXXXX")"
    git init -q "$candidate_source"
    git -C "$candidate_source" remote add origin "$YSS_CLI_REPOSITORY"
    git -C "$candidate_source" fetch -q --depth 1 origin "$candidate_commit"
    git -C "$candidate_source" checkout -q --detach FETCH_HEAD
    node "$ROOT_DIR/.template-source/scripts/plugin-candidate.mjs" prepare "$candidate_source" "$(dirname "$YSS_CI_ENV_FILE")/plugin-candidate"
  fi
fi

if ((tooling || toolchain)); then
  step "pnpm ${YSS_CI_PNPM_VERSION}：准备所选工具的运行器"
  if ((!dry_run)); then
    if [[ "$(pnpm --version 2>/dev/null || true)" != "$YSS_CI_PNPM_VERSION" ]]; then
      corepack enable
      corepack prepare "pnpm@${YSS_CI_PNPM_VERSION}" --activate
    fi
  else
    echo "+ corepack prepare pnpm@${YSS_CI_PNPM_VERSION} --activate（版本不符时）"
  fi
fi
if ((tooling)); then
  step "按 frozen lockfile 安装模板工具依赖"
  run pnpm --dir .template-source/tooling/node install --frozen-lockfile
fi

if ((toolchain)); then
  step "准备原型作者工具链"
  if ((dry_run)); then
    echo "+ cp .agents/skills/yss-prototype-stage/assets/shadcn-vue-authoring/{package.json,pnpm-lock.yaml} <临时目录> && pnpm --dir <临时目录> install --frozen-lockfile --ignore-scripts"
  else
    prototype_toolchain="$(work_dir)/yss-prototype-author"
    mkdir -p "$prototype_toolchain"
    cp .agents/skills/yss-prototype-stage/assets/shadcn-vue-authoring/{package.json,pnpm-lock.yaml} "$prototype_toolchain/"
    pnpm --dir "$prototype_toolchain" install --frozen-lockfile --ignore-scripts
    export_var YSS_VUE_TOOLCHAIN "$prototype_toolchain"
  fi
fi

if ((python)); then
  step "Python ${YSS_CI_PYTHON_MINOR}：准备运行时"
  if ((python_schema)); then step "安装 jsonschema==${YSS_CI_JSONSCHEMA_VERSION}"; fi
  if ((dry_run)); then
    echo "+ python3 不是 ${YSS_CI_PYTHON_MINOR} 时，在 root 容器内经 uv==${YSS_CI_UV_VERSION} 补装"
  else
    ensure_python
  fi
  # 补装后的解释器不受 PEP 668 限制；系统 Python 在一次性 CI 容器内允许写入，本机不放开。
  if [[ -n "${CI:-}" ]]; then export PIP_BREAK_SYSTEM_PACKAGES=1; fi
  if ((python_schema)); then run python3 -m pip install "jsonschema==${YSS_CI_JSONSCHEMA_VERSION}"; fi
fi

step "环境准备完成"
