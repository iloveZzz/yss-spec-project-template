#!/usr/bin/env node
import assert from 'node:assert/strict';
import { createHash } from 'node:crypto';
import { cpSync, existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { preparePlanSpecEntry, diffPlanSpecEntry } from './lib/plan-spec-entry-view.mjs';
import { lifecycleStatus } from './lib/lifecycle-status.mjs';

const sourceRoot = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
const root = mkdtempSync(path.join(os.tmpdir(), 'yss-lifecycle-operator-'));
try {
  const put = (ref, data) => { const target = path.join(root, ref); mkdirSync(path.dirname(target), { recursive: true }); writeFileSync(target, typeof data === 'string' ? data : `${JSON.stringify(data, null, 2)}\n`); };
  const copy = ref => { mkdirSync(path.dirname(path.join(root, ref)), { recursive: true }); cpSync(path.join(sourceRoot, ref), path.join(root, ref)); };
  const digest = ref => `sha256:${createHash('sha256').update(readFileSync(path.join(root, ref))).digest('hex')}`;
  put('yss-project.yaml', 'schema_version: 1\nrepository_mode: project-instance\n');
  put('CONTEXT.md', '# 业务词汇\n');
  put('docs/.scratch/demo/plan.md', '# 当前 Plan\n');
  put('docs/.scratch/demo/context.json', { status: 'reconciled', repository_mode: 'project-instance' });
  copy('.template-spec/process/lifecycle-registry.yaml');
  copy('scripts/verify-plan-spec-entry');
  copy('scripts/verify-lifecycle-checkpoint');
  copy('.agents/skills/yss-product-lifecycle/references/orchestration-contract.yaml');
  const draft = preparePlanSpecEntry({ root, featureId: 'demo', planRef: 'docs/.scratch/demo/plan.md', contextRef: 'docs/.scratch/demo/context.json' });
  assert.throws(() => preparePlanSpecEntry({ root, featureId: 'demo', planRef: 'docs/.scratch/demo/missing.md', contextRef: 'docs/.scratch/demo/context.json' }), /ENOENT/);
  assert.equal(draft.status, 'draft');
  assert.equal(draft.approval_created, false);
  assert.ok(Object.values(draft.review_candidate.checks).every(row => row.status === 'pending'));
  assert.ok(Object.values(draft.review_candidate.impacts).every(value => value === null));
  put('docs/.scratch/demo/review.json', draft.review_candidate);
  assert.equal(diffPlanSpecEntry({ root, reviewRef: 'docs/.scratch/demo/review.json' }).status, 'current');
  const checkpoint = {
    schema_version: 1, repository_mode: 'project-instance', mode: 'route', status: 'routing', stage: 'stage.plan',
    artifacts: {}, gates: {}, context_reconciliation: { status: 'pending', ref: null, evidence_refs: [] },
    next_work_unit: 'work-unit.plan-requirements', ticket_sync: {}, verification: {}, human_review: {}, git_checkpoint: {}, blockers: [], rollback: [],
    stage_tracking: { items: [{ id: 'scope', work_unit: 'work-unit.plan-requirements', owner: '产品负责人', progress: 'pending', source_refs: [{ ref: 'docs/.scratch/demo/plan.md', digest: digest('docs/.scratch/demo/plan.md') }], completion: [], dependencies: [] }] },
  };
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  const current = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
  assert.deepEqual(current.blockers, []);
  assert.equal(current.owner, '产品负责人');
  assert.match(current.next_action, /plan-requirements/);
  for (const malformed of [undefined, null, 'API 尚未冻结', {}, false, 0]) {
    const input = { ...checkpoint, blockers: malformed };
    put('docs/.scratch/demo/checkpoint.json', input);
    const bytes = readFileSync(path.join(root, 'docs/.scratch/demo/checkpoint.json'));
    const invalid = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
    assert.equal(invalid.verification_scope.find(row => row.id === 'registered-blockers').status, 'failed');
    assert.ok(invalid.diagnostics.some(row => row.code === (malformed === undefined ? 'registered-blockers-missing' : 'registered-blockers-invalid')));
    assert.equal(invalid.next_step.action_type, 'repair');
    assert.equal(invalid.next_step.command, null);
    assert.equal(invalid.execution_authorization, 'not-evaluated');
    assert.deepEqual(readFileSync(path.join(root, 'docs/.scratch/demo/checkpoint.json')), bytes);
  }
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  put('docs/.scratch/demo/plan.md', '# 已变化的 Plan\n');
  assert.deepEqual(diffPlanSpecEntry({ root, reviewRef: 'docs/.scratch/demo/review.json' }).changed_refs, ['docs/.scratch/demo/plan.md']);
  assert.match(lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' }).blockers.join(' '), /来源漂移/);
  put('docs/.scratch/demo/plan.md', '# 当前 Plan\n');
  assert.equal(diffPlanSpecEntry({ root, reviewRef: 'docs/.scratch/demo/review.json' }).status, 'current');
  assert.deepEqual(lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' }).blockers, []);
  assert.throws(() => lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/missing.json' }), /ENOENT/);
  checkpoint.stage_tracking = undefined;
  checkpoint.next_work_unit = 'work-unit.missing';
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  assert.match(lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' }).blockers.join(' '), /未知下一工作单元/);
  // A read-only status view must expose its coverage and never grant execution.
  checkpoint.next_work_unit = 'work-unit.spec-synthesis';
  checkpoint.artifacts = { spec: { status: 'approved', ref: 'docs/.scratch/demo/plan.md', digest: digest('docs/.scratch/demo/plan.md') } };
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  put('docs/.scratch/demo/plan.md', '# New bytes but still readable\n');
  const before = readFileSync(path.join(root, 'docs/.scratch/demo/checkpoint.json'));
  const partial = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
  assert.deepEqual(partial.blockers, []);
  assert.equal(partial.verification_scope.find(x => x.id === 'approval-validity').status, 'not-checked');
  assert.equal(partial.verification_scope.find(x => x.id === 'artifact-digests').status, 'not-checked');
  assert.equal(partial.verification_scope.find(x => x.id === 'context-reconciliation').status, 'not-checked');
  assert.equal(partial.verification_scope.find(x => x.id === 'stage-tracking').status, 'not-checked');
  assert.equal(partial.next_step.action_type, 'verify');
  assert.deepEqual(partial.next_step.command, ['node', 'scripts/verify-plan-spec-entry', 'docs/.scratch/demo/checkpoint.json']);
  assert.equal(partial.next_step.cwd, root);
  assert.equal(partial.execution_authorization, 'not-evaluated');
  assert.doesNotMatch(partial.next_action, /^执行 /);
  assert.deepEqual(readFileSync(path.join(root, 'docs/.scratch/demo/checkpoint.json')), before);
  checkpoint.stage_tracking = { items: [{ id: 'active', work_unit: 'work-unit.spec-synthesis', owner: '需求负责人', progress: 'running', source_refs: [], completion: [], dependencies: [] }] };
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  let resumeView = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
  assert.equal(resumeView.next_step.action_type, 'inspect');
  assert.equal(resumeView.next_step.command, null);
  assert.match(resumeView.next_action, /重复派发/);
  checkpoint.stage_tracking.items[0].progress = 'completed';
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  resumeView = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
  assert.equal(resumeView.next_step.action_type, 'inspect');
  assert.match(resumeView.next_action, /完成证据/);
  checkpoint.stage_tracking = undefined;
  checkpoint.status = 'paused-human-gate';
  checkpoint.pause = { owner_or_authority: 'role.test-engineer', reason_code: 'review-required', resume_condition: 'current review approved' };
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  resumeView = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
  assert.equal(resumeView.next_step.action_type, 'wait');
  assert.equal(resumeView.owner, 'role.test-engineer');
  assert.doesNotMatch(resumeView.next_action, /需由用户决定/);
  checkpoint.status = 'routing'; delete checkpoint.pause;
  checkpoint.artifacts.spec.ref = 'docs/.scratch/demo/missing.md';
  put('docs/.scratch/demo/checkpoint.json', checkpoint);
  const missing = lifecycleStatus({ root, checkpointRef: 'docs/.scratch/demo/checkpoint.json' });
  assert.ok(missing.diagnostics.some(x => x.code === 'evidence-unreadable' && x.severity === 'error'));
  assert.equal(missing.next_step.action_type, 'repair');
  assert.throws(() => lifecycleStatus({ root, checkpointRef: '../outside.json' }));
  const template = readFileSync(path.join(sourceRoot, '.template-spec/design/templates/interaction-spec-template.md'), 'utf8');
  const matrix = readFileSync(path.join(sourceRoot, '.template-spec/design/templates/state-matrix-template.md'), 'utf8');
  const overview = readFileSync(path.join(sourceRoot, '.template-spec/design/templates/product-overview-design-template.md'), 'utf8');
  const technical = readFileSync(path.join(sourceRoot, '.template-spec/architecture/templates/tech-design-template.md'), 'utf8');
  assert.doesNotMatch(`${template}\n${matrix}`, /模型列表|发布确认弹窗|≤ 200ms/);
  assert.doesNotMatch(technical, /P99\s*200\s*ms/i);
  const uiOverview = overview.replaceAll('<功能名称>', '提交申请').replace(/### 8\.2 早期结构草图（有 UI 影响时填写）[\s\S]*?(?=\n### 8\.3)/, '### 8.2 早期结构草图（有 UI 影响时填写）\n\n申请表单：申请人、材料、提交按钮；缺材料显示校验反馈。\n');
  put('docs/.scratch/ui/product-overview.md', uiOverview);
  put('docs/.scratch/ui/interaction.md', template.replaceAll('<功能名称>', '提交申请').replaceAll('<待填写>', '按当前 Spec 填写'));
  put('docs/.scratch/ui/state-matrix.md', matrix.replaceAll('<功能名称>', '提交申请').replaceAll('<待填写>', '按当前 Spec 填写'));
  assert.match(readFileSync(path.join(root, 'docs/.scratch/ui/product-overview.md'), 'utf8'), /申请表单：申请人、材料/);
  const noUiOverview = overview.replaceAll('<功能名称>', '批量规则校验').replace(/## 8\. 页面结构 \/ 流程草图（条件适用）[\s\S]*?(?=\n## 9\.)/, '## 8. 页面结构 / 流程草图（条件适用）\n\n不适用：本次仅调整无界面的后端批量校验规则；以调用链与失败回执验证流程。\n');
  put('docs/.scratch/no-ui/product-overview.md', noUiOverview);
  assert.doesNotMatch(noUiOverview, /\[导航 \/ 面包屑\]|页面名称：|模型列表/);
  assert.equal(existsSync(path.join(root, 'docs/.scratch/no-ui/interaction.md')), false);
  assert.equal(existsSync(path.join(root, 'docs/.scratch/no-ui/state-matrix.md')), false);
  assert.match(readFileSync(path.join(sourceRoot, '.template-spec/design/templates/examples/model-publishing-interaction.example.md'), 'utf8'), /模型列表/);
  console.log('生命周期只读入口与模板场景验证通过');
} finally { rmSync(root, { recursive: true, force: true }); }
