#!/usr/bin/env node
import { readFileSync, writeFileSync } from "node:fs";
import { loadCompilerContract } from "./lib/implementation-contract-compiler.mjs";
import { loadSkillRegistry } from "./lib/skill-registry.mjs";
import { ROOT } from "./lib/skill-supply-chain.mjs";
import path from "node:path";

const target = path.join(ROOT, ".agents/skills/yss-implementation-contract-compiler/references/boundaries.md");
const registry = loadSkillRegistry();
const compiler = loadCompilerContract();

const lines = [
  "# YSS Skill Boundaries",
  "",
  "> Generated by `scripts/generate-yss-skill-boundaries` from `docs/agents/yss-skill-registry.yaml` and `compiler-contract.yaml`. Do not hand-edit.",
  "",
  "实现入口先选择 capability 或窄 Recipe，再由实现合同编译器计算最小 skill 闭包。下面是派生阅读视图，不是第二套路由事实源。",
  "",
  "## Dependency Semantics",
  "",
  "| Type | Compiler behavior |",
  "| --- | --- |",
  "| `context-required` | 自动递归加入执行上下文。 |",
  "| `context-conditional` | 仅当显式 condition 命中时递归加入。 |",
  "| `coordination-only` | 记录协作原因，不扩张执行上下文。 |",
  "| `review-only` | 仅作为审查输入记录，不扩张实现上下文。 |",
  "| `component-dependency` | 记录组件关系；由 capability/Recipe 显式选择，不自动加载。 |",
  "",
  "## Capability Catalog",
  "",
  "| Capability | Primary skill | Task modes |",
  "| --- | --- | --- |",
  ...registry.capabilities.map((item) => `| \`${item.id}\` | \`${item.primary_skill}\` | ${item.task_modes.map((mode) => `\`${mode}\``).join(", ")} |`),
  "",
  "## Narrow Recipes",
  "",
  "一个切片可以组合多个 Recipe，但只计算一次闭包。Recipe 仅引用 capability。",
  "",
  "| Recipe | Capabilities |",
  "| --- | --- |",
  ...registry.recipes.map((item) => `| \`${item.id}\` | ${item.capabilities.map((capability) => `\`${capability}\``).join(", ")} |`),
  "",
  "## Impact Entry Mapping",
  "",
  "| Impact | Entry capabilities |",
  "| --- | --- |",
  ...Object.entries(compiler.impact_to_capabilities).map(([impact, capabilities]) => `| \`${impact}\` | ${capabilities.map((capability) => `\`${capability}\``).join(", ")} |`),
  "",
  "## Typed Skill Dependencies",
  "",
  "| Skill | Dependency | Type | Condition |",
  "| --- | --- | --- | --- |",
  ...Object.entries(registry.skill_dependencies).flatMap(([skill, dependencies]) => dependencies.map((dependency) => `| \`${skill}\` | \`${dependency.skill}\` | \`${dependency.type}\` | ${dependency.when ? `\`${dependency.when}\`` : "—"} |`)),
  ""
];

const expected = lines.join("\n");
if (process.argv.includes("--check")) {
  const actual = readFileSync(target, "utf8");
  if (actual !== expected) {
    process.stderr.write("boundaries.md 与 Registry/Compiler 合同不一致；运行 scripts/generate-yss-skill-boundaries\n");
    process.exitCode = 1;
  } else process.stdout.write("YSS skill boundaries are current\n");
} else {
  writeFileSync(target, expected);
  process.stdout.write("generated YSS skill boundaries\n");
}
