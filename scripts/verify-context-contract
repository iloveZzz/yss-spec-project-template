#!/usr/bin/env node
import { parseArgs } from "node:util";
import { parseContextContract, resolveContextTermRefs } from "./lib/context-contract.mjs";

try {
  const { values } = parseArgs({ options: { root: { type: "string", default: process.cwd() }, "allowed-context": { type: "string", multiple: true }, "term-ref": { type: "string", multiple: true }, json: { type: "boolean", default: false } }, strict: true });
  const contract = parseContextContract({ root: values.root, allowedContextIds: values["allowed-context"] });
  const resolved = resolveContextTermRefs(contract, values["term-ref"] || []);
  const contextSnapshot = { context_ref: contract.context_ref, context_schema_version: contract.context_schema_version, document_digest: contract.document_digest, referenced_terms_digest: resolved.referenced_terms_digest, term_refs: resolved.terms.map((term) => term.term_ref) };
  const result = { result: "completed", ...contextSnapshot, context_snapshot: contextSnapshot, process_term_count: contract.process_terms, business_term_count: contract.business_terms.length };
  process.stdout.write(`${JSON.stringify(result, null, values.json ? 2 : 0)}\n`);
} catch (error) {
  process.stderr.write(`${JSON.stringify({ result: "blocked", reason_code: error.code || "context-contract-invalid", errors: error.problems || [error.message] }, null, 2)}\n`);
  process.exitCode = 1;
}
