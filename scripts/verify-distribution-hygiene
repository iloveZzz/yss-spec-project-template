#!/usr/bin/env node
import { scanDistributionHygiene } from "./lib/distribution-hygiene.mjs";

try {
  const result = scanDistributionHygiene();
  const stale = result.staleAllow;
  const summary = "分发面路径检查：files=" + result.files + " violations=" + result.violations.length + " allowed=" + result.allowedReferences.length + " stale-allow=" + stale.length;
  if (result.violations.length || stale.length) {
    process.stderr.write(summary + "\n" + [...result.violations, ...stale.map((entry) => "stale-allow: " + entry)].join("\n") + "\n");
    process.exitCode = 1;
  } else {
    process.stdout.write(summary + "\n");
  }
} catch (error) {
  process.stderr.write("verify-distribution-hygiene 错误: " + error.message + "\n");
  process.exitCode = 1;
}
