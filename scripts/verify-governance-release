#!/usr/bin/env node
import { readdirSync, readFileSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { isTemplateSource } from "./lib/repository-mode.mjs";

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "..");
const failures = [];
const read = (relativePath) => readFileSync(path.join(root, relativePath), "utf8");
for (const [relativePath, marker] of Object.entries({
  "docs/architecture/templates/system-overview-design-template.md": "已明确的认证、授权、租户隔离、敏感数据或合规行为",
  "docs/architecture/templates/tech-design-template.md": "已明确的认证、授权、租户隔离、敏感数据或合规行为"
})) {
  if (!read(relativePath).includes(marker)) failures.push(`${relativePath} 缺少条件性安全/权限架构承载`);
}
if (isTemplateSource(root)) {
  const adrDirectory = path.join(root, ".template-source/adr");
  const files = readdirSync(adrDirectory).filter((name) => name.endsWith(".md")).sort();
  if (files.length === 0) failures.push("模板源 ADR 目录为空");
  for (const name of files) {
    const relativePath = `.template-source/adr/${name}`;
    const body = read(relativePath);
    const status = body.match(/状态[：:]\s*([^\n]+)/)?.[1]?.trim() ?? body.match(/##\s*状态\s*\n+\s*([^\n]+)/)?.[1]?.trim();
    if (!status) failures.push(`${relativePath} 未声明状态`);
    if (status === "proposed" && !/尚未|未实现|不构成|不能把/.test(body)) failures.push(`${relativePath} 的 proposed ADR 缺少未实施/非当前门禁说明`);
  }
}
for (const [relativePath, marker] of Object.entries({
  "docs/adr/0003-machine-readable-lifecycle-registry.md": "状态：部分实施（Phase 1）",
  "docs/adr/0006-stable-lifecycle-ids-and-generated-structure.md": "状态：部分实施（Phase 1）"
})) {
  if (!read(relativePath).includes(marker)) failures.push(`${relativePath} 未声明当前实现状态`);
}
if (!read("scripts/verify-lifecycle-scenarios").includes("ROUTE_REGISTRY_IDS")) failures.push("生命周期场景未校验稳定 ID 映射");
if (failures.length > 0) {
  process.stderr.write(`${failures.join("\n")}\n`);
  process.exitCode = 1;
}
