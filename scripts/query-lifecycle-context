#!/usr/bin/env node
import { parseArgs } from "node:util";
import { queryLifecycleContext } from "./lib/lifecycle-context-query.mjs";

try {
  const { values } = parseArgs({
    options: {
      help: {type:'boolean'},
      mode: { type: "string" },
      stage: { type: "string" },
      "work-unit": { type: "string" },
      include: { type: "string", multiple: true },
    },
    strict: true,
  });
  if(values.help)process.stdout.write('用法: scripts/query-lifecycle-context [--mode route] [--stage stage.plan] [--work-unit work-unit.plan-opportunity] [--include <资产>]\n只读查询，不证明批准；退出码 0=查询完成、1=输入或执行失败。\n');
  else {
  const result = queryLifecycleContext({
    mode: values.mode,
    stageId: values.stage,
    workUnitId: values["work-unit"],
    include: values.include ?? [],
  });
  process.stdout.write(`${JSON.stringify(result, null, 2)}\n`);
  }
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
}
