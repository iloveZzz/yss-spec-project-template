#!/usr/bin/env node
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { MAX_LAG_COMMITS, formatReport, measureLag } from './lib/source-lock-lag.mjs';

const SCRIPT_ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');

function usage() {
  return `用法: scripts/verify-source-lock-lag [--root <目录>] [--max-lag <N>]\n只读；yss-cli 来源锁里任一模板落后当前 HEAD 超过 N 个触及 Bundle 输入的提交（默认 ${MAX_LAG_COMMITS}）时失败。候选与发布验证执行。`;
}

try {
  const args = process.argv.slice(2);
  let root = SCRIPT_ROOT;
  let max = MAX_LAG_COMMITS;
  for (let index = 0; index < args.length; index += 1) {
    if (args[index] === '--root') root = path.resolve(args[++index] ?? '');
    else if (args[index] === '--max-lag') {
      max = Number(args[++index]);
      if (!Number.isInteger(max) || max < 0) throw new TypeError('--max-lag 必须是非负整数');
    } else if (args[index] === '--help') { process.stdout.write(`${usage()}\n`); process.exit(0); }
    else throw new TypeError(`未知参数 ${args[index]}\n${usage()}`);
  }
  const report = measureLag(root, { max });
  (report.ok ? process.stdout : process.stderr).write(`${formatReport(report)}\n`);
  if (!report.ok) process.exitCode = 1;
} catch (error) {
  process.stderr.write(`verify-source-lock-lag 错误: ${error.message}\n`);
  process.exitCode = 1;
}
