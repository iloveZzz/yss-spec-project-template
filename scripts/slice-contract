#!/usr/bin/env node
import fs from 'node:fs';
import path from 'node:path';
import { prepareSliceImplementationContract, migrateSliceContractV2, persistSliceDraft } from './lib/slice-contract-preparation.mjs';
import { renderSliceContractView, diffSliceContracts } from './lib/slice-contract-views.mjs';
import { parseSliceYaml, readSliceContract } from './lib/slice-contract.mjs';
import { nativeContractVerify, assertNativeCapabilities, NEEDS } from './lib/native-evidence.mjs';

// verify 的检查语义归 yss（contract verify --kind slice-preflight）；这里只翻译参数、按 Node 的键序输出报告、透传退出码。
const inside = (root, ref) => { const rel = path.relative(root, path.resolve(root, ref)); return rel && !rel.startsWith('..') && !path.isAbsolute(rel) ? rel.split(path.sep).join('/') : path.resolve(root, ref); };
const order = (value, keys) => Object.fromEntries([...keys.filter(key => key in value), ...Object.keys(value).filter(key => !keys.includes(key))].map(key => [key, value[key]]));

try {
  const args=process.argv.slice(2),mode=args.shift(),options={},positional=[];
  for(let i=0;i<args.length;i++) {
    if(args[i]==='--json'){options.json=true;continue;}
    if(args[i].startsWith('--')) {
      const key=args[i].slice(2);if(!['root','input','output','unit','before-root','approval-ref'].includes(key)||!args[i+1])throw new Error(`未知或缺值参数 ${args[i]}`);
      options[key]=args[++i];
    }else positional.push(args[i]);
  }
  const root=path.resolve(options.root||process.cwd());
  let result;
  if(mode==='prepare'||mode==='migrate') {
    const input=options.input?parseSliceYaml(fs.readFileSync(path.resolve(root,options.input))):{};
    if(mode==='prepare')result=prepareSliceImplementationContract({...input,root,ticket_ref:positional[0]});
    else result=migrateSliceContractV2(readSliceContract(positional[0],{root}).raw,{...input,root});
    if(options.output)persistSliceDraft(result,options.output,{root});
    if(result.report.blockers.length)process.exitCode=1;
  }else if(mode==='view')result=renderSliceContractView(positional[0],{root,unit_id:options.unit});
  else if(mode==='diff')result=diffSliceContracts(positional[0],positional[1],{root,beforeRoot:options['before-root']?path.resolve(options['before-root']):root});
  else if(mode==='verify') {
    assertNativeCapabilities(NEEDS.slicePreflight);
    const realRoot=fs.realpathSync(root);
    const verdict=nativeContractVerify({root:realRoot,kind:'slice-preflight',file:inside(realRoot,positional[0]),extra:[...(options['approval-ref']?['--approval-ref',inside(realRoot,options['approval-ref'])]:[]),...(options.unit?['--unit',options.unit]:[])]});
    const report=verdict.envelope.result?.coverage?.slice_preflight;
    if(!report)throw new Error(verdict.message);
    result=order({...report,checks:order(report.checks,['readable','structure','approval','freshness'])},['read_only','ref','id','version','digest','checks','approval_validity','execution_allowed','blockers']);
    if(result.blockers.length)process.exitCode=verdict.exitCode||1;
  }
  else throw new Error('用法: scripts/slice-contract prepare <ticket> --input <补充.yaml> --output <新合同.yaml> | migrate <v2.yaml> --input <补充.yaml> --output <新合同.yaml> | view <合同.yaml> [--unit <id>] | diff <旧合同> <新合同> | verify <合同> [--root <项目根>] [--approval-ref <批准记录>] [--unit <工作单元>]');
  process.stdout.write(options.json||!result.markdown?`${JSON.stringify(result,null,2)}\n`:`${result.markdown}\n`);
}catch(error){process.stderr.write(`${error.message}\n`);process.exitCode=1;}
