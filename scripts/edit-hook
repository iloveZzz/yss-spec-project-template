#!/usr/bin/env node
import { readFileSync } from "node:fs";
import path from "node:path";
import { runEditHook, SKIP_ENV } from "./lib/edit-hook.mjs";

// 由 Claude Code PostToolUse（Edit|Write|MultiEdit）调用，stdin 为 hook 的 JSON 输入。
if (process.argv.includes("--help")) {
  process.stdout.write(`用法: scripts/edit-hook   （PostToolUse hook；对刚写入的 YAML/JSON 资产运行 yss check）\n失败退出 2 并把发现写入 stderr；CLI 缺失或不支持 check 时静默放行；${SKIP_ENV}=off 跳过。\n`);
} else {
  try {
    let payload = {};
    try { payload = JSON.parse(readFileSync(0, "utf8") || "{}"); } catch { payload = {}; }
    const root = path.resolve(process.env.CLAUDE_PROJECT_DIR || (typeof payload.cwd === "string" && payload.cwd) || process.cwd());
    const result = runEditHook({ root, payload });
    process.stdout.write(result.stdout);
    process.stderr.write(result.stderr);
    process.exitCode = result.exitCode;
  } catch (error) {
    // hook 自身出错不阻断编辑。
    process.stderr.write(`edit-hook 错误（已放行）: ${error.message}\n`);
  }
}
