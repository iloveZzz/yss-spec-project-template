    "ownershipPolicy": {
      "version": 1,
      "default": "managed",
      "rules": [
        {
          "pattern": ".git/**",
          "ownership": "protected"
        },
        {
          "pattern": ".template-source/design/design-system-sync.yaml",
          "ownership": "managed"
        },
        {
          "pattern": ".template-source/design/preview-dark.html",
