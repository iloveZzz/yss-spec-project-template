          "pattern": ".gitmodules",
          "ownership": "user-owned"
        },
        {
          "pattern": ".gitignore",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "apps/**",
          "ownership": "user-owned"
        },
        {
          "pattern": "packages/**",
          "ownership": "user-owned"
        },
