          "ownership": "user-owned"
        },
        {
          "pattern": "docs/reviews/**",
          "ownership": "user-owned"
        },
        {
          "pattern": "docs/.scratch/**",
          "ownership": "user-owned"
        },
        {
          "pattern": ".template-spec/agents/issue-tracker.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "yss-project.yaml",
          "ownership": "generated"
        },
        {
          "pattern": "skills-lock.json",
          "ownership": "generated"
        },
        {
          "pattern": "yss-public-skills.json",
          "ownership": "generated"
        },
        {
          "pattern": ".agents/skills/.yss-skills-manifest.json",
          "ownership": "generated"
        },
        {
          "pattern": "AGENTS.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "CONTEXT.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "DESIGN.md",
          "ownership": "managed-customizable"
        },
        {
          "pattern": "README.md",
          "ownership": "user-owned"
        },
        {
          "pattern": ".work/**",
          "ownership": "user-owned"
        }
      ]
    },
    "customizationPolicy": {
      "version": 1,
      "defaultStrategy": "replace-with-force",
      "rules": [
        {
          "pattern": ".gitignore",
          "strategy": "manual"
        },
        {
          "pattern": ".template-spec/agents/issue-tracker.md",
          "strategy": "manual"
        },
        {
          "pattern": "CONTEXT.md",
          "strategy": "manual"
        },
        {
          "pattern": "DESIGN.md",
          "strategy": "manual"
        }
      ]
    },
    "generatorPolicy": {
      "version": 1,
      "rules": [
        {
          "pattern": "yss-project.yaml",
          "generatorId": "repository-identity",
          "generatorVersion": 1
        },
        {
          "pattern": "skills-lock.json",
          "generatorId": "skills-lock",
          "generatorVersion": 1
        },
        {
          "pattern": "yss-public-skills.json",
          "generatorId": "public-skills",
          "generatorVersion": 1
        },
        {
          "pattern": ".agents/skills/.yss-skills-manifest.json",
          "generatorId": "skills-manifest",
          "generatorVersion": 1
        }
      ]
    }
