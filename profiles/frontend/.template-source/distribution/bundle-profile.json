  "profile": "frontend",
  "schemaVersion": 1,
  "upgradePolicy": {
    "assets": [
      {
        "kind": "preserve",
        "paths": [
          "CONTEXT.md",
          "yss-project.yaml",
          ".template-spec/agents/issue-tracker.md",
          "README.md"
        ]
      },
      {
        "kind": "customizable",
        "paths": [
          "AGENTS.md",
          ".gitignore",
          "DESIGN.md"
        ]
      },
      {
        "generator": "native-bundle",
        "kind": "generated",
        "paths": [
          "skills-lock.json",
          ".template-spec/process/harness-profile.yaml",
          ".agents/skills/.public-skills.json",
          ".agents/skills/.skills-manifest.json"
        ]
      }
    ],
    "rules": [],
    "schemaVersion": 1
  }
