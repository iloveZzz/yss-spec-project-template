openapi: 3.1.0
x-yss-wire-profile: {{wire_profile}}
info:
  title: 参考条目教学接口
  version: 1.0.0
servers:
  - url: http://127.0.0.1:8080
paths:
  /reference-entries:
    post:
      operationId: createReferenceEntry
      requestBody:
        $ref: '#/components/requestBodies/Name'
      responses:
        '200':
          $ref: '#/components/responses/Entry'
        '400':
          $ref: '#/components/responses/Error'
        '500':
          $ref: '#/components/responses/Error'
  /reference-entries/{id}:
    parameters:
      - $ref: '#/components/parameters/Id'
    get:
      operationId: findReferenceEntry
      responses:
        '200':
          $ref: '#/components/responses/Entry'
        '404':
          $ref: '#/components/responses/Error'
        '500':
          $ref: '#/components/responses/Error'
  /reference-entries/{id}/name:
    parameters:
      - $ref: '#/components/parameters/Id'
    put:
      operationId: renameReferenceEntry
      requestBody:
        $ref: '#/components/requestBodies/Name'
      responses:
        '200':
          $ref: '#/components/responses/Entry'
        '400':
          $ref: '#/components/responses/Error'
        '404':
          $ref: '#/components/responses/Error'
        '500':
          $ref: '#/components/responses/Error'
components:
  schemas:
    YssResultMeta: {{result_meta_schema}}
  parameters:
    Id:
      name: id
      in: path
      required: true
      schema:
        type: string
  requestBodies:
    Name:
      required: true
      content:
        application/json:
          schema:
            type: object
            required: [name]
            properties:
              name:
                type: string
                minLength: 1
                maxLength: 100
                pattern: '\S'
  responses:
    Entry:
      description: YSS SingleResult；参考条目存在且操作成功
      content:
        application/json:
          schema:
            x-yss-response-wrapper: SingleResult
            allOf:
              - $ref: '#/components/schemas/YssResultMeta'
              - type: object
                required: [data]
                properties:
                  success: {type: boolean, const: true}
                  data:
                    type: object
                    required: [id, name]
                    properties:
                      id: {type: string}
                      name: {type: string}
    Error:
      description: YSS 异常映射；校验错误 A0104，未知错误 A0101，条目不存在 REFERENCE_NOT_FOUND
      headers:
        X-Trace-Id:
          schema: {type: string}
      content:
        application/json:
          schema:
            type: object
            required: [errCode, message]
            properties:
              errCode: {type: string}
              message: {type: string}
