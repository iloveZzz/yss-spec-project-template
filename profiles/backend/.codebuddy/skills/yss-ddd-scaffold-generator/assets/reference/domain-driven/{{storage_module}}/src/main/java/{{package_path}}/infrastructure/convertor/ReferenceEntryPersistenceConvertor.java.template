package {{base_package}}.infrastructure.convertor;

import {{base_package}}.domain.entity.ReferenceEntryEntity;
import {{base_package}}.infrastructure.po.ReferenceEntryPO;
import org.mapstruct.Mapper;
import org.mapstruct.ReportingPolicy;

@Mapper(componentModel = "spring", unmappedTargetPolicy = ReportingPolicy.ERROR)
public interface ReferenceEntryPersistenceConvertor {
    ReferenceEntryPO toPO(ReferenceEntryEntity entity);

    default ReferenceEntryEntity toEntity(ReferenceEntryPO po) {
        return po == null ? null : ReferenceEntryEntity.restore(po.getId(), po.getName());
    }
}
