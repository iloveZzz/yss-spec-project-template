package {{base_package}}.architecture;

import com.tngtech.archunit.core.domain.JavaClass;
import com.tngtech.archunit.core.domain.JavaClasses;
import com.tngtech.archunit.core.domain.Dependency;
import com.tngtech.archunit.core.importer.ImportOption;
import com.tngtech.archunit.junit.AnalyzeClasses;
import com.tngtech.archunit.junit.ArchTest;

/** 空骨架可无业务类型；首切片由批准合同传入职责包和必须加载的实际类型。 */
@AnalyzeClasses(packages = "{{base_package}}", importOptions = ImportOption.DoNotIncludeTests.class)
class LayeredMvcArchitectureTest {
    private static boolean inPackage(JavaClass type, String prefixes) {
        for (String prefix : prefixes.split(",")) {
            if (!prefix.isEmpty() && (type.getPackageName().equals(prefix)
                    || type.getPackageName().startsWith(prefix + "."))) return true;
        }
        return false;
    }

    private static boolean role(JavaClass type, String name, String defaults) {
        return inPackage(type, defaults) || inPackage(type, System.getProperty("yss.arch." + name, ""));
    }

    private static boolean controller(JavaClass type) {
        return type.isAnnotatedWith("org.springframework.web.bind.annotation.RestController")
                || type.isAnnotatedWith("org.springframework.stereotype.Controller")
                || type.isMetaAnnotatedWith("org.springframework.stereotype.Controller");
    }

    private static void reject(boolean forbidden, Dependency dependency) {
        if (forbidden) throw new AssertionError(dependency.getDescription());
    }

    @ArchTest
    static void boundaries(JavaClasses classes) {
        for (JavaClass origin : classes) {
            boolean application = role(origin, "application", "{{base_package}}.service,{{base_package}}.core");
            boolean infrastructure = role(origin, "infrastructure", "{{base_package}}.repository");
            for (Dependency dependency : origin.getDirectDependenciesFromSelf()) {
                JavaClass target = dependency.getTargetClass();
                boolean targetWeb = controller(target) || role(target, "web",
                        "{{base_package}}.server,{{base_package}}.rest,{{base_package}}.adapter.web");
                boolean targetInfrastructure = role(target, "infrastructure", "{{base_package}}.repository");
                reject(application && targetWeb, dependency);
                reject(infrastructure && (targetWeb || role(target, "application",
                        "{{base_package}}.service,{{base_package}}.core")), dependency);
                reject(controller(origin) && targetInfrastructure, dependency);
            }
        }
        if (Boolean.getBoolean("yss.firstSlice")) {
            if (Boolean.getBoolean("yss.arch.requireController")) {
                boolean foundController = false;
                for (JavaClass type : classes) if (controller(type)) foundController = true;
                if (!foundController) throw new AssertionError("Web slice did not load an actual Controller");
            }
            String required = System.getProperty("yss.arch.requiredTypes", "");
            if (required.isEmpty()) throw new AssertionError("first slice requires contract-bound types");
            for (String name : required.split(",")) {
                boolean found = false;
                for (JavaClass type : classes) if (type.getName().equals(name)) found = true;
                if (!found) throw new AssertionError("architecture scope did not load " + name);
            }
        }
    }
}
