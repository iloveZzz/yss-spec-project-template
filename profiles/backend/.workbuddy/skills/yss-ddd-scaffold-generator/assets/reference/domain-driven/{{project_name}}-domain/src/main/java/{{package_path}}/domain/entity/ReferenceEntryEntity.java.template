package {{base_package}}.domain.entity;

import {{base_package}}.domain.ReferenceEntryException;

public final class ReferenceEntryEntity {
    private static final int MAX_NAME_LENGTH = 100;
    private final String id;
    private String name;

    private ReferenceEntryEntity(String id, String name) {
        this.id = id;
        rename(name);
    }

    public static ReferenceEntryEntity restore(String id, String name) {
        if (id == null || id.trim().isEmpty()) {
            throw new ReferenceEntryException("REFERENCE_ID_REQUIRED", "条目标识不能为空");
        }
        return new ReferenceEntryEntity(id, name);
    }

    public void rename(String name) {
        if (name == null || name.trim().isEmpty() || name.length() > MAX_NAME_LENGTH) {
            throw new ReferenceEntryException("REFERENCE_NAME_INVALID", "名称须为1至100个字符");
        }
        this.name = name;
    }

    public String getId() {
        return id;
    }
    public String getName() {
        return name;
    }
}
