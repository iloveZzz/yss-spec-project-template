package {{base_package}}.{{web_package}};

import {{base_package}}.service.ReferenceEntryException;
import com.yss.cloud.exception.BizException;
import com.yss.cloud.exception.ExceptionFactory;
import com.yss.cloud.exception.advice.GlobalExceptionAdvice;
import lombok.RequiredArgsConstructor;
import org.springframework.core.Ordered;
import org.springframework.core.annotation.Order;
import org.springframework.http.*;
import org.springframework.web.bind.annotation.*;

@RestControllerAdvice
@Order(Ordered.HIGHEST_PRECEDENCE)
@RequiredArgsConstructor
public class ReferenceEntryAdvice {
    private final GlobalExceptionAdvice advice;

    @ExceptionHandler(ReferenceEntryException.class)
    public ResponseEntity<BizException> translate(ReferenceEntryException error) {
        HttpStatus status = "REFERENCE_NOT_FOUND".equals(error.getCode())
                ? HttpStatus.NOT_FOUND : HttpStatus.BAD_REQUEST;
        return ResponseEntity.status(status).body(advice.sendErrorResponse(
                ExceptionFactory.bizException(error.getCode(), error.getMessage())));
    }
}
