package ${base_package}.rest;

${application_service_import}
${dto_imports}
${web_convertor_import}
import ${page_result_type};
import ${single_result_type};
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.*;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import ${validation_namespace}.validation.Valid;

/**
 * ${domain_desc} 管理
 *
 * @author ${author}
 */
@RestController
@RequestMapping("/api/${module_name}/${domain_url_path}")
@RequiredArgsConstructor
@Tag(name = "${domain_desc}管理")
public class ${domain_class}Controller {

    ${application_service_field}
    private final ${web_convertor_class} webConvertor;

    /**
     * 分页查询 ${domain_desc}
     */
    @PostMapping("/page")
    @Operation(summary = "分页查询")
    public ${page_result_simple_name}<${response_class}> page(@Valid @RequestBody ${page_request_class} request) {
        return webConvertor.toResponsePage(${query_call});
    }

    /**
     * 根据ID查询 ${domain_desc}
     */
    @GetMapping("/{id}")
    @Operation(summary = "详情查询")
    public ${single_result_simple_name}<${response_class}> detail(@PathVariable Long id) {
        return ${single_result_simple_name}.${single_result_factory_method}(webConvertor.toResponse(${detail_call}));
    }

    /**
     * 新增 ${domain_desc}
     */
    @PostMapping
    @Operation(summary = "新增")
    public ${single_result_simple_name}<Long> add(@Valid @RequestBody ${create_request_class} request) {
        return ${single_result_simple_name}.${single_result_factory_method}(${add_call});
    }

    /**
     * 更新 ${domain_desc}
     */
    @PutMapping
    @Operation(summary = "更新")
    public ${single_result_simple_name}<Boolean> update(@Valid @RequestBody ${update_request_class} request) {
        return ${single_result_simple_name}.${single_result_factory_method}(${update_call});
    }

    /**
     * 删除 ${domain_desc}
     */
    @DeleteMapping("/{id}")
    @Operation(summary = "删除")
    public ${single_result_simple_name}<Boolean> delete(@PathVariable Long id) {
        return ${single_result_simple_name}.${single_result_factory_method}(${delete_call});
    }
}
