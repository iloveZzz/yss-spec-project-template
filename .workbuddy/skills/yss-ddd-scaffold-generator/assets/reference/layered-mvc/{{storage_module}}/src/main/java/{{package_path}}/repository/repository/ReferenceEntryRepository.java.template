package {{base_package}}.repository.repository;

import {{base_package}}.repository.ReferenceEntryRecord;
import {{base_package}}.repository.mapper.ReferenceEntryMapper;
import {{base_package}}.repository.convertor.ReferenceEntryPersistenceConvertor;
import {{base_package}}.repository.po.ReferenceEntryPO;
import java.util.Optional;
import lombok.RequiredArgsConstructor;
import org.springframework.stereotype.Repository;

@Repository
@RequiredArgsConstructor
public class ReferenceEntryRepository {
    private final ReferenceEntryMapper mapper;
    private final ReferenceEntryPersistenceConvertor convertor;

    public Optional<ReferenceEntryRecord> find(String id) {
        return Optional.ofNullable(convertor.toRecord(mapper.selectById(id)));
    }

    public void save(ReferenceEntryRecord entry) {
        ReferenceEntryPO po = convertor.toPO(entry);
        if (mapper.selectById(entry.getId()) == null) {
            mapper.insert(po);
        } else {
            mapper.updateById(po);
        }
    }
}
