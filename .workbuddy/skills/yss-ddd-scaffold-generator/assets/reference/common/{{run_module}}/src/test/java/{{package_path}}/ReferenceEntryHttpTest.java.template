package {{base_package}};

import {{base_package}}.{{app_package}}.command.ReferenceEntryCommand;
import {{base_package}}.{{app_package}}.service.ReferenceEntryService;
import {{base_package}}.{{storage_package}}.repository.ReferenceEntryRepository;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.context.SpringBootTest;
import org.springframework.boot.test.web.client.TestRestTemplate;
import org.springframework.boot.test.mock.mockito.SpyBean;
import org.springframework.http.*;
import java.util.Collections;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@SpringBootTest(webEnvironment = SpringBootTest.WebEnvironment.RANDOM_PORT)
class ReferenceEntryHttpTest {
    @Autowired
    private TestRestTemplate http;
    @Autowired
    private ObjectMapper json;
    @Autowired
    private ReferenceEntryService service;
    @SpyBean
    private ReferenceEntryRepository repository;

    @Test
    void createReadRenameUsesRealHttpAndWireContract() throws Exception {
        ResponseEntity<String> created = http.postForEntity(
                "/reference-entries", Collections.singletonMap("name", "参考条目"), String.class);
        assertEquals(HttpStatus.OK, created.getStatusCode());
        JsonNode result = json.readTree(created.getBody());
        assertTrue(result.path("success").asBoolean());
        assertEquals("DM-A0001", result.path("code").asText());
        assertEquals("数据返回正常", result.path("message").asText());
        assertEquals("信息返回正常", result.path("tips").asText());
        assertTrue(result.has("dataType"));
        assertTrue(result.get("dataType").isNull());
        String id = result.path("data").path("id").asText();
        assertFalse(id.isEmpty());
        assertEquals("参考条目", result.path("data").path("name").asText());
        ResponseEntity<String> renamed = http.exchange("/reference-entries/" + id + "/name", HttpMethod.PUT,
                new HttpEntity<>(Collections.singletonMap("name", "新名称")), String.class);
        assertEquals(HttpStatus.OK, renamed.getStatusCode());
        JsonNode loaded = json.readTree(http.getForObject("/reference-entries/" + id, String.class));
        assertEquals("新名称", loaded.path("data").path("name").asText());
    }

    @Test
    void validationAndMissingRecordAreClientErrors() throws Exception {
        ResponseEntity<String> invalid = http.postForEntity(
                "/reference-entries", Collections.singletonMap("name", " "), String.class);
        assertEquals(HttpStatus.BAD_REQUEST, invalid.getStatusCode());
        assertEquals("A0104", json.readTree(invalid.getBody()).path("errCode").asText());
        ResponseEntity<String> missing = http.getForEntity("/reference-entries/missing", String.class);
        assertEquals(HttpStatus.NOT_FOUND, missing.getStatusCode());
        assertEquals("REFERENCE_NOT_FOUND", json.readTree(missing.getBody()).path("errCode").asText());
        assertNotNull(missing.getHeaders().getFirst("X-Trace-Id"));
    }

    @Test
    void failedWriteRollsBackAtServiceBoundaryAndHidesInternalError() throws Exception {
        ReferenceEntryCommand command = new ReferenceEntryCommand();
        command.setName("原名称");
        String id = service.create(command).getId();
        doAnswer(call -> {
            call.callRealMethod();
            throw new IllegalStateException("private-storage-detail");
        })
                .when(repository).save(any());
        try {
            ResponseEntity<String> failure = http.exchange("/reference-entries/" + id + "/name", HttpMethod.PUT,
                    new HttpEntity<>(Collections.singletonMap("name", "不应保存")), String.class);
            assertEquals(HttpStatus.INTERNAL_SERVER_ERROR, failure.getStatusCode());
            assertEquals("A0101", json.readTree(failure.getBody()).path("errCode").asText());
            assertFalse(failure.getBody().contains("private-storage-detail"));
            assertFalse(failure.getBody().contains("stackTrace"));
            assertNotNull(failure.getHeaders().getFirst("X-Trace-Id"));
            assertEquals("原名称", service.find(id).getName());
        } finally {
            reset(repository);
        }
    }
}
